@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">IMS</a>
    </div>
</div>

@* Simplified the toggler to prevent event interference *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">

        @* --- ADMIN SECTIONS --- *@
        <AuthorizeView Roles="Admin">
            <Authorized>

                @* Dashboard Section *@
                <div class="nav-section-header" @onclick="ToggleDashboard">
                    <span class="header-text">Dashboard</span>
                    <i class="@GetChevronClass(isDashboardOpen)"></i>
                </div>
                @if (isDashboardOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                            <i class="fa fa-dashboard me-3"></i> Dashboard
                        </NavLink>
                        <NavLink class="nav-link" href="/analytics">
                            <i class="fa fa-chart-line me-3"></i> Analytics
                        </NavLink>
                        <NavLink class="nav-link" href="/daily-report">
                            <i class="fas fa-file-invoice-dollar me-3"></i> Daily Report
                        </NavLink>
                    </div>
                }

                @* Sales Section *@
                <div class="nav-section-header" @onclick="ToggleSales">
                    <span class="header-text">Sales</span>
                    <i class="@GetChevronClass(isSalesOpen)"></i>
                </div>
                @if (isSalesOpen)
                {
                    <div class="nav-sub-items">
                        <a class="nav-link" href="/pos" target="_blank">
                            <span class="bi bi-cart-fill me-2"></span> POS
                        </a>
                        <NavLink class="nav-link" href="/shop-billing">
                            <span class="bi bi-receipt me-2"></span> Shop Billing
                        </NavLink>
                        <NavLink class="nav-link" href="/sales">
                            <span class="bi bi-file-earmark-text me-2"></span> Invoices
                        </NavLink>
                    </div>
                }

                @* Product Section *@
                <div class="nav-section-header" @onclick="ToggleProduct">
                    <span class="header-text">Product</span>
                    <i class="@GetChevronClass(isProductOpen)"></i>
                </div>
                @if (isProductOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/products">
                            <span class="bi bi-box-fill me-2"></span> Products
                        </NavLink>
                        <NavLink class="nav-link" href="/stock-history">
                            <span class="bi bi-cart-fill me-2"></span> Stock
                        </NavLink>
                    </div>
                }

                @* Account Section *@
                <div class="nav-section-header" @onclick="ToggleAccount">
                    <span class="header-text">Account</span>
                    <i class="@GetChevronClass(isAccountOpen)"></i>
                </div>
                @if (isAccountOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/purchases">
                            <span class="bi bi-cart-fill me-2"></span> Purchases
                        </NavLink>
                        <NavLink class="nav-link" href="/expenses"><i class="fas fa-file-invoice-dollar me-2"></i> Expenses</NavLink>
                    </div>
                }

                @* Staff Section *@
                <div class="nav-section-header" @onclick="ToggleStaff">
                    <span class="header-text">Staff</span>
                    <i class="@GetChevronClass(isStaffOpen)"></i>
                </div>
                @if (isStaffOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/staff"><span class="bi bi-person me-2"></span> Staff</NavLink>
                    </div>
                }

                @* Suppliers Section *@
                <div class="nav-section-header" @onclick="ToggleSuppliers">
                    <span class="header-text">Suppliers</span>
                    <i class="@GetChevronClass(isSuppliersOpen)"></i>
                </div>
                @if (isSuppliersOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/suppliers"><span class="bi bi-truck me-2"></span> Suppliers</NavLink>
                    </div>
                }

                @* Partners Section (Customers: retail, wholesaler, walk-in) *@
                <div class="nav-section-header" @onclick="TogglePartners">
                    <span class="header-text">Customers</span>
                    <i class="@GetChevronClass(isPartnersOpen)"></i>
                </div>
                @if (isPartnersOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/customers"><span class="bi bi-person me-2"></span> Customers</NavLink>
                    </div>
                }

                @* Profile Section *@
                <div class="nav-section-header" @onclick="ToggleProfile">
                    <span class="header-text">Profile</span>
                    <i class="@GetChevronClass(isProfileOpen)"></i>
                </div>
                @if (isProfileOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/import">
                            <span class="bi bi-file-earmark-excel me-2"></span> Import
                        </NavLink>
                        <NavLink class="nav-link" href="/profile">
                            <span class="bi bi-person-circle me-2"></span> Profile
                        </NavLink>
                        <NavLink class="nav-link" href="/listmanagement">
                            <span class="bi bi-gear-fill me-2"></span> Settings
                        </NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        @* --- SUPER ADMIN: all modules (same as Admin) + Supervisor --- *@
        <AuthorizeView Roles="SuperAdmin">
            <Authorized>
                <div class="nav-section-header" @onclick="ToggleDashboard">
                    <span class="header-text">Dashboard</span>
                    <i class="@GetChevronClass(isDashboardOpen)"></i>
                </div>
                @if (isDashboardOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All"><i class="fa fa-dashboard me-3"></i> Dashboard</NavLink>
                        <NavLink class="nav-link" href="/analytics"><i class="fa fa-chart-line me-3"></i> Analytics</NavLink>
                        <NavLink class="nav-link" href="/daily-report"><i class="fas fa-file-invoice-dollar me-3"></i> Daily Report</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleSales">
                    <span class="header-text">Sales</span>
                    <i class="@GetChevronClass(isSalesOpen)"></i>
                </div>
                @if (isSalesOpen)
                {
                    <div class="nav-sub-items">
                        <a class="nav-link" href="/pos" target="_blank"><span class="bi bi-cart-fill me-2"></span> POS</a>
                        <NavLink class="nav-link" href="/shop-billing"><span class="bi bi-receipt me-2"></span> Shop Billing</NavLink>
                        <NavLink class="nav-link" href="/sales"><span class="bi bi-file-earmark-text me-2"></span> Invoices</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleProduct">
                    <span class="header-text">Product</span>
                    <i class="@GetChevronClass(isProductOpen)"></i>
                </div>
                @if (isProductOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/products"><span class="bi bi-box-fill me-2"></span> Products</NavLink>
                        <NavLink class="nav-link" href="/stock-history"><span class="bi bi-cart-fill me-2"></span> Stock</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleAccount">
                    <span class="header-text">Account</span>
                    <i class="@GetChevronClass(isAccountOpen)"></i>
                </div>
                @if (isAccountOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/purchases"><span class="bi bi-cart-fill me-2"></span> Purchases</NavLink>
                        <NavLink class="nav-link" href="/expenses"><i class="fas fa-file-invoice-dollar me-2"></i> Expenses</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleStaff">
                    <span class="header-text">Staff</span>
                    <i class="@GetChevronClass(isStaffOpen)"></i>
                </div>
                @if (isStaffOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/staff"><span class="bi bi-person me-2"></span> Staff</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleSuppliers">
                    <span class="header-text">Suppliers</span>
                    <i class="@GetChevronClass(isSuppliersOpen)"></i>
                </div>
                @if (isSuppliersOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/suppliers"><span class="bi bi-truck me-2"></span> Suppliers</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="TogglePartners">
                    <span class="header-text">Customers</span>
                    <i class="@GetChevronClass(isPartnersOpen)"></i>
                </div>
                @if (isPartnersOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/customers"><span class="bi bi-person me-2"></span> Customers</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleProfile">
                    <span class="header-text">Profile</span>
                    <i class="@GetChevronClass(isProfileOpen)"></i>
                </div>
                @if (isProfileOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/import"><span class="bi bi-file-earmark-excel me-2"></span> Import</NavLink>
                        <NavLink class="nav-link" href="/profile"><span class="bi bi-person-circle me-2"></span> Profile</NavLink>
                        <NavLink class="nav-link" href="/listmanagement"><span class="bi bi-gear-fill me-2"></span> Settings</NavLink>
                    </div>
                }
                @* Branches – Super Admin only: grid of all branch records *@
                <div class="nav-section-header" @onclick="ToggleBranches">
                    <span class="header-text">Branches</span>
                    <i class="@GetChevronClass(isBranchesOpen)"></i>
                </div>
                @if (isBranchesOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/branches"><span class="bi bi-building me-2"></span> All Branches</NavLink>
                    </div>
                }
                <div class="nav-section-header" @onclick="ToggleSupervisor">
                    <span class="header-text">Supervisor</span>
                    <i class="@GetChevronClass(isSupervisorOpen)"></i>
                </div>
                @if (isSupervisorOpen)
                {
                    <div class="nav-sub-items">
                        <NavLink class="nav-link" href="/adminPanal">Admin Panel</NavLink>
                    </div>
                }
            </Authorized>
        </AuthorizeView>

        @* --- LOGIN --- *@
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3 mt-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

<style>
    .nav-section-header {
        padding: 0.75rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        background-color: transparent;
        transition: background 0.2s;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

        .nav-section-header:hover {
            background-color: rgba(255,255,255,0.1);
        }

    .header-text {
        color: rgba(255,255,255,0.7);
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05rem;
        pointer-events: none; /* Crucial: clicks pass through to the parent div */
    }

    .nav-section-header i {
        color: rgba(255,255,255,0.5);
        font-size: 0.8rem;
        pointer-events: none; /* Crucial: clicks pass through to parent div */
    }

    /* Indent child links */
    .nav-sub-items {
        background-color: rgba(0,0,0,0.1);
        padding-left: 1rem;
    }
</style>

@code {
    private bool isDashboardOpen;
    private bool isSalesOpen;
    private bool isProductOpen;
    private bool isAccountOpen;
    private bool isStaffOpen;
    private bool isSuppliersOpen;
    private bool isPartnersOpen;
    private bool isProfileOpen;
    private bool isBranchesOpen;
    private bool isSupervisorOpen;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;

    // Toggle Methods
    private void ToggleDashboard() { isDashboardOpen = !isDashboardOpen; Console.WriteLine("Dashboard Toggled"); }
    private void ToggleSales() => isSalesOpen = !isSalesOpen;
    private void ToggleProduct() => isProductOpen = !isProductOpen;
    private void ToggleAccount() => isAccountOpen = !isAccountOpen;
    private void ToggleStaff() => isStaffOpen = !isStaffOpen;
    private void ToggleSuppliers() => isSuppliersOpen = !isSuppliersOpen;
    private void TogglePartners() => isPartnersOpen = !isPartnersOpen;
    private void ToggleProfile() => isProfileOpen = !isProfileOpen;
    private void ToggleBranches() => isBranchesOpen = !isBranchesOpen;
    private void ToggleSupervisor() => isSupervisorOpen = !isSupervisorOpen;

    private string GetChevronClass(bool isOpen) =>
        isOpen ? "bi bi-chevron-up" : "bi bi-chevron-down";
}