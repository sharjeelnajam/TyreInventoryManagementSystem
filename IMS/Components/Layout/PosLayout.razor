@namespace IMS.Components.Layout
@inherits LayoutComponentBase

<div class="pos-layout">
    <AuthorizeView>
        <Authorized>
            <div class="pos-top-bar">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="mb-0 fw-bold">Point of Sale</h5>
                </div>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="pos-top-bar-user">@context.User.Identity?.Name</span>
                    <a class="btn btn-sm btn-outline-secondary" href="/sales">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                    <a class="btn btn-sm btn-outline-danger" href="/Account/Logout">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="pos-top-bar">
                <div>Point of Sale</div>
                <a href="/Account/Login">Login</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <div class="pos-content">
        @Body
    </div>
</div>

<style>
    /* Desktop Full-Screen Lock */
    html:has(.pos-layout), body:has(.pos-layout) {
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        height: 100vh !important;
        height: 100dvh !important;
        min-height: 100vh !important;
        width: 100% !important;
    }

    .pos-layout {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100vh;
        height: 100dvh;
        min-height: 100vh;
        max-height: 100vh;
        max-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .pos-top-bar {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.75rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

        .pos-top-bar a {
            color: white;
            text-decoration: none;
        }

    .pos-top-bar-user {
        color: #fdfdfd;
        font-size: 0.85rem;
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        opacity: 0.95;
    }

    .pos-content {
        flex: 1 1 0;
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .pos-content ::deep > * {
            flex: 1 1 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            max-height: 100%;
        }

    /* Tablet and Mobile Responsiveness */
    @@media (max-width: 991.98px) {
        html:has(.pos-layout), body:has(.pos-layout) {
            overflow: auto !important;
            height: auto !important;
            min-height: 100vh !important;
            min-height: 100dvh !important;
        }

        .pos-layout {
            position: relative;
            height: auto;
            min-height: 100vh;
            min-height: 100dvh;
            max-height: none;
            overflow: visible;
        }

        .pos-content {
            flex: 1 1 auto;
            min-height: 0;
            overflow: visible;
            height: auto;
        }

            /* Stop forcing overflow:hidden / max-height so products panel can keep its height */
            .pos-content ::deep > * {
                flex: 1 1 auto;
                min-height: calc(100vh - 56px);
                height: auto;
                max-height: none;
                overflow: visible;
            }

        .pos-top-bar {
            padding: 0.5rem 0.75rem;
            gap: 0.5rem;
            position: sticky;
            top: 0;
            z-index: 20;
        }

            .pos-top-bar h5 {
                font-size: 1rem;
            }

        .pos-top-bar-user {
            display: none;
        }
    }
</style>