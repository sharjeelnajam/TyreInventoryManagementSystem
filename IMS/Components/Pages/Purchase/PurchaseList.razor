@page "/purchases"
@using Domain
@using Infrastructure.Services
@using System.Linq
@inject IPurchaseService PurchaseService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<h3>Purchases</h3>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" @onclick="OpenAddPurchase"> + Purchase</button>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Purchase #</th>
            <th>Date</th>
            <th>Supplier</th>
            <th>Quantity</th>
            <th>Status</th>
            @if (!isStaff)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (purchases != null)
        {
            @foreach (var purchase in purchases)
            {
                <tr>
                    <td>@purchase.PurchaseNumber</td>
                    <td>@purchase.PurchaseDate.ToShortDateString()</td>
                    <td>@purchase.Supplier?.Name</td>
                    <td>@(purchase.PurchaseDetails?.Sum(d => d.Quantity) ?? 0)</td>
                    <td>@purchase.PaymentStatus</td>
                    @if (!isStaff)
                    {
                        <td>
                            <span role="button" title="View" class="text-info me-2"
                                  @onclick="() => ViewPurchase(purchase)">
                                <i class="bi bi-eye fs-5"></i>
                            </span>
                            @if (isSuperAdmin)
                            {
                                <span role="button" title="Delete" class="text-danger"
                                      @onclick="() => DeletePurchase(purchase.Id)">
                                    <i class="bi bi-trash fs-5"></i>
                                </span>
                            }
                        </td>
                    }
                </tr>
            }
        }
    </tbody>
</table>

@if (showForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-body">
                    <AddPurchase PurchaseId="@selectedPurchaseId" OnClose="CloseForm" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Purchase> purchases;
    private bool showForm = false;
    private Guid? selectedPurchaseId;
    private bool isStaff = false;
    private bool isSuperAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isStaff = user.IsInRole("Staff");
        isSuperAdmin = user.IsInRole("SuperAdmin");
        purchases = await PurchaseService.GetAllPurchasesAsync();
    }

    private void OpenAddPurchase()
    {
        selectedPurchaseId = null;
        showForm = true;
    }

    private void ViewPurchase(Purchase purchase)
    {
        var firstProductId = purchase.PurchaseDetails?.FirstOrDefault()?.ProductId ?? Guid.Empty;
        if (firstProductId == Guid.Empty)
        {
            // Fallback: just open the add/edit modal in view mode for this purchase
            selectedPurchaseId = purchase.Id;
            showForm = true;
        }
        else
        {
            Navigation.NavigateTo($"/purchase-view/{purchase.Id}/{firstProductId}");
        }
    }

    private async Task DeletePurchase(Guid id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure to delete?");
        if (confirm)
        {
            await PurchaseService.DeletePurchaseAsync(id);
            purchases = await PurchaseService.GetAllPurchasesAsync();
            StateHasChanged();
        }
    }

    private void CloseForm()
    {
        showForm = false;
        _ = LoadPurchases();
    }

    private async Task LoadPurchases()
    {
        purchases = await PurchaseService.GetAllPurchasesAsync();
        StateHasChanged();
    }
}
