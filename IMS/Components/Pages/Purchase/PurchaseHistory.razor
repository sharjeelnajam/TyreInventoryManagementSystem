@page "/purchasehistory"
@page "/purchasehistory/{productId:guid}"
@using Domain
@using Infrastructure.Services
@inject IPurchaseService PurchaseService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Purchase History</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-secondary mb-0">
            Purchase History
        </h3>
        <button class="btn btn-outline-primary" @onclick="GoBack">
            <i class="bi bi-arrow-left-circle me-1"></i> Back
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Loading purchase history...</p>
        </div>
    }
    else if (purchaseDetails == null || !purchaseDetails.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="bi bi-info-circle me-2"></i>
            No purchase records found for this product.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Purchase #</th>
                        <th>Purchase Date</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total Price</th>
                        <th>Selling Price</th>
                        <th>Brand</th>
                      @*   <th>Remarks</th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in purchaseDetails)
                    {
                        <tr>
                            <td>
                                <a href="@($"/purchase-view/{detail.PurchaseId}/{productId}")" class="text-primary" style="text-decoration:underline; cursor:pointer;">
                                    @detail.Purchase?.PurchaseNumber
                                </a>
                            </td>
                            <td>@detail.Purchase?.PurchaseDate.ToString("dd-MMM-yyyy")</td>
                            <td>@detail.Quantity</td>
                            <td>@detail.UnitPrice.ToString("N2")</td>
                            <td>@detail.TotalPrice.ToString("N2")</td>
                            <td>@detail.SellingPrice.ToString("N2")</td>
                            <td>@detail.Brand</td>
                            @* <td>@detail.Remarks</td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public Guid productId { get; set; }
    private List<PurchaseDetail>? purchaseDetails;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPurchaseHistory();
    }

    private async Task LoadPurchaseHistory()
    {
        isLoading = true;
        purchaseDetails = await PurchaseService.GetPurchaseDetailsByProductIdAsync(productId);
        isLoading = false;
    }

    private void GoBack() => Navigation.NavigateTo("/stock-history");
}
