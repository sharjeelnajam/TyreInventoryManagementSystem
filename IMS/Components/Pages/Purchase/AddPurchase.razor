@using Domain
@using Infrastructure.Services
@inject ISupplierService SupplierService
@inject IProductService ProductService
@inject IPurchaseService PurchaseService
@rendermode InteractiveServer

<h4>@(Purchase.Id == Guid.Empty ? "Add" : "Edit")</h4>

<EditForm Model="@Purchase" OnValidSubmit="SavePurchase">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
        <div class="col-md-4">
            <label>Purchase #</label>
            <InputText @bind-Value="Purchase.PurchaseNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Date</label>
            <InputDate @bind-Value="Purchase.PurchaseDate" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Supplier</label>
            <InputSelect @bind-Value="Purchase.SupplierId" class="form-control">
                <option value="">-- Select Supplier --</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Purchase.SupplierId)" />
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-3">
            <label>Discount</label>
            <InputNumber TValue="decimal?"
                         Value="Purchase.Discount"
                         ValueChanged="OnDiscountChanged"
                         ValueExpression="@(() => Purchase.Discount)"
                         class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Tax</label>
            <InputNumber TValue="decimal?"
                         Value="Purchase.TaxAmount"
                         ValueChanged="OnTaxChanged"
                         ValueExpression="@(() => Purchase.TaxAmount)"
                         class="form-control" />
        </div>
        <div class="col-md-3">
            <label>Total</label>
            <InputNumber @bind-Value="Purchase.TotalAmount" class="form-control" readonly />
        </div>
        <div class="col-md-3">
            <label>Net</label>
            <InputNumber @bind-Value="Purchase.NetAmount" class="form-control" readonly />
        </div>

        <div class="row mt-2">
            <div class="col-md-4">
                <label>Payment Status</label>
                <InputSelect @bind-Value="Purchase.PaymentStatus" class="form-control">
                    <option value="">-- Select Payment Status --</option>
                    <option value="Paid">Paid</option>
                    <option value="Unpaid">Unpaid</option>
                    <option value="Partial">Partial</option>
                </InputSelect>
            </div>
        </div>
    </div>

    <hr />
    <h5>Purchase Items</h5>

    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Purchase.PurchaseDetails != null && Purchase.PurchaseDetails.Any())
            {
                @foreach (var detail in Purchase.PurchaseDetails)
                {
                    <tr>
                        <td>
                            <InputSelect @bind-Value="detail.ProductId" class="form-control">
                                <option value="">-- Select Product --</option>
                                @foreach (var p in products)
                                {
                                    bool isSelected = p.Id == detail.ProductId;
                                    bool isAlreadyUsed = Purchase.PurchaseDetails
                                    .Any(d => d.ProductId == p.Id && d != detail);

                                    <option value="@p.Id" disabled="@(!isSelected && isAlreadyUsed)">
                                        @p.ProductName
                                    </option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => detail.ProductId)" />
                        </td>
                        <td>
                            <InputNumber TValue="int"
                                         Value="detail.Quantity"
                                         ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                         ValueExpression="@(() => detail.Quantity)"
                                         class="form-control" />
                        </td>
                        <td>
                            <InputNumber TValue="decimal"
                                         Value="detail.UnitPrice"
                                         ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                         ValueExpression="@(() => detail.UnitPrice)"
                                         class="form-control" />
                        </td>
                        <td>@(detail.Quantity * detail.UnitPrice)</td>
                        <td>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveDetail(detail)">X</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <button class="btn btn-sm btn-primary mt-2" type="button" @onclick="AddDetail">
        + Add Item
    </button>

    <div class="d-flex justify-content-end mt-3">
        <button class="btn btn-success me-2" type="submit">Save</button>
        <button class="btn btn-secondary" type="button" @onclick="Close">Cancel</button>
    </div>
</EditForm>

@code {
    [Parameter] public Guid? PurchaseId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<Supplier> suppliers = new();
    private List<Product> products = new();

    private Purchase Purchase = new Purchase
        {
            PurchaseDate = DateTime.Today,
            PurchaseDetails = new List<PurchaseDetail>() // 👈 empty list se initialize
        };

    protected override async Task OnInitializedAsync()
    {
        // ek hi scope me sequential await karo
        suppliers = await LoadSuppliersAsync();
        products = await LoadProductsAsync();

        Purchase.PurchaseDetails ??= new List<PurchaseDetail>();

        if (PurchaseId.HasValue)
        {
            Purchase = await PurchaseService.GetPurchaseByIdAsync(PurchaseId.Value);
        }
        else
        {
            Purchase = new Purchase
                {
                    PurchaseDate = DateTime.Today,
                    PurchaseNumber = $"PO-{DateTime.Now:yyyyMMddHHmmss}",
                    PurchaseDetails = new List<PurchaseDetail>()
                };
        }
    }

    private async Task SavePurchase()
    {
        foreach (var d in Purchase.PurchaseDetails)
        {
            d.PurchaseId = Purchase.Id;
        }

        if (Purchase.Id == Guid.Empty)
            await PurchaseService.AddPurchaseAsync(Purchase);
        else
            await PurchaseService.UpdatePurchaseAsync(Purchase);

        await OnClose.InvokeAsync();
    }

    private void AddDetail()
    {
        Purchase.PurchaseDetails.Add(new PurchaseDetail
            {
                Id = Guid.Empty,
                Quantity = 1,
                UnitPrice = 0,
                TotalPrice = 0
            });
        RecalculateTotals();
    }

    private void RemoveDetail(PurchaseDetail detail)
    {
        Purchase.PurchaseDetails.Remove(detail);
        RecalculateTotals();
    }

    private void OnQuantityChanged(PurchaseDetail detail, int newValue)
    {
        detail.Quantity = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void OnUnitPriceChanged(PurchaseDetail detail, decimal newValue)
    {
        detail.UnitPrice = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void OnDiscountChanged(decimal? newValue)
    {
        Purchase.Discount = newValue ?? 0;
        RecalculateTotals();
    }

    private void OnTaxChanged(decimal? newValue)
    {
        Purchase.TaxAmount = newValue ?? 0;
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {

        if (Purchase.PurchaseDetails == null)
        {
            Purchase.TotalAmount = 0;
            Purchase.NetAmount = 0;
            return;
        }
        var total = Purchase.PurchaseDetails.Sum(d => d.Quantity * d.UnitPrice);
        Purchase.TotalAmount = total > 0 ? total - Purchase.Discount ?? 0 : 0;
        Purchase.NetAmount = total > 0 ? total - (Purchase.Discount ?? 0) + (Purchase.TaxAmount ?? 0) : 0;
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    // helper methods bana diye taki code readable ho
    private async Task<List<Supplier>> LoadSuppliersAsync()
    {
        var list = await SupplierService.GetAllAsync();
        return list ?? new List<Supplier>();
    }

    private async Task<List<Product>> LoadProductsAsync()
    {
        var list = await ProductService.GetAllAsync();
        return list ?? new List<Product>();
    }
}
