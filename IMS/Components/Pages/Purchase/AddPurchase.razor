@using Domain
@using Infrastructure.Services
@inject ISupplierService SupplierService
@inject IProductService ProductService
@inject IPurchaseService PurchaseService
@rendermode InteractiveServer

<h4>@(Purchase.Id == Guid.Empty ? "Add" : "Edit")</h4>

<EditForm Model="@Purchase" OnValidSubmit="SavePurchase">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
        <div class="col-md-4">
            <label>Purchase #</label>
            <InputText @bind-Value="Purchase.PurchaseNumber" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Date</label>
            <InputDate @bind-Value="Purchase.PurchaseDate" class="form-control" />
        </div>
        <div class="col-md-4">
            <label>Supplier</label>
            <InputSelect @bind-Value="Purchase.SupplierId" class="form-control">
                <option value="">-- Select Supplier --</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </InputSelect>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-3">
            <label>Discount</label>
            <InputNumber @bind-Value="Purchase.Discount" class="form-control"
                         @oninput="OnPurchaseFieldChanged" />
        </div>
        <div class="col-md-3">
            <label>Tax</label>
            <InputNumber @bind-Value="Purchase.TaxAmount" class="form-control"
                         @oninput="OnPurchaseFieldChanged" />
        </div>
        <div class="col-md-3">
            <label>Total</label>
            <InputNumber @bind-Value="Purchase.TotalAmount" class="form-control" readonly />
        </div>
        <div class="col-md-3">
            <label>Net</label>
            <InputNumber @bind-Value="Purchase.NetAmount" class="form-control" readonly />
        </div>

        <div class="row mt-2">
            <div class="col-md-4">
                <label>Payment Status</label>
                <InputSelect @bind-Value="Purchase.PaymentStatus" class="form-control">
                    <option value="">-- Select Payment Status --</option>
                    <option value="Paid">Paid</option>
                    <option value="Unpaid">Unpaid</option>
                    <option value="Partial">Partial</option>
                </InputSelect>
            </div>
        </div>
    </div>

    <hr />
    <h5>Purchase Items</h5>

    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Unit Price</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Purchase.PurchaseDetails != null && Purchase.PurchaseDetails.Any())
            {
                @foreach (var detail in Purchase.PurchaseDetails)
                {
                    <tr>
                        <td>
                            <InputSelect @bind-Value="detail.ProductId" class="form-control">
                                <option value="">-- Select Product --</option>
                                @foreach (var p in products)
                                {
                                    <option value="@p.Id">@p.ProductName</option>
                                }
                            </InputSelect>
                        </td>
                        <td>
                            <InputNumber @bind-Value="detail.Quantity" class="form-control"
                                         @oninput="@((ChangeEventArgs e) => OnItemFieldChanged(detail))" />
                        </td>
                        <td>
                            <InputNumber @bind-Value="detail.UnitPrice" class="form-control"
                                         @oninput="@((ChangeEventArgs e) => OnItemFieldChanged(detail))" />
                        </td>
                        <td>@(detail.Quantity * detail.UnitPrice)</td>
                        <td>
                            <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveDetail(detail)">X</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <button class="btn btn-sm btn-primary mt-2" type="button" @onclick="AddDetail">
        + Add Item
    </button>

    <div class="mt-3">
        <button class="btn btn-success" type="submit">Save</button>
        <button class="btn btn-secondary" type="button" @onclick="Close">Cancel</button>
    </div>
</EditForm>

@code {
    [Parameter] public Guid? PurchaseId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<Supplier> suppliers = new();
    private List<Product> products = new();

    private Purchase Purchase = new Purchase
        {
            PurchaseDate = DateTime.Today,
            PurchaseDetails = new List<PurchaseDetail>() // 👈 empty list se initialize
        };

    protected override async Task OnInitializedAsync()
    {
        suppliers = await SupplierService.GetAllAsync();
        products = await ProductService.GetAllAsync();

        if (PurchaseId.HasValue)
        {
            Purchase = await PurchaseService.GetPurchaseByIdAsync(PurchaseId.Value);
        }
        else
        {
            Purchase = new Purchase
                {
                    PurchaseDate = DateTime.Today,
                    PurchaseNumber = $"PO-{DateTime.Now:yyyyMMddHHmmss}",
                    PurchaseDetails = new List<PurchaseDetail>()
                };
        }
    }

    private void AddDetail()
    {
        Purchase.PurchaseDetails.Add(new PurchaseDetail { Quantity = 1, UnitPrice = 0 });
        RecalculateTotals();
    }

    private void RemoveDetail(PurchaseDetail detail)
    {
        Purchase.PurchaseDetails.Remove(detail);
        RecalculateTotals();
    }

    private void OnItemFieldChanged(PurchaseDetail detail)
    {
        // This is called whenever Quantity or UnitPrice is changed
        RecalculateTotals();
    }

    private void OnPurchaseFieldChanged(ChangeEventArgs e)
    {
        // Called for Discount or TaxAmount changes
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        Purchase.TotalAmount = Purchase.PurchaseDetails.Sum(d => d.Quantity * d.UnitPrice);
        Purchase.NetAmount = Purchase.TotalAmount - (Purchase.Discount ?? 0) + (Purchase.TaxAmount ?? 0);
    }

    private async Task SavePurchase()
    {
        // Recalculate totals
        Purchase.TotalAmount = Purchase.PurchaseDetails.Sum(d => d.Quantity * d.UnitPrice);
        Purchase.NetAmount = Purchase.TotalAmount - (Purchase.Discount ?? 0) + (Purchase.TaxAmount ?? 0);

        if (Purchase.Id == Guid.Empty)
            await PurchaseService.AddPurchaseAsync(Purchase);
        else
            await PurchaseService.UpdatePurchaseAsync(Purchase);

        await OnClose.InvokeAsync();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
