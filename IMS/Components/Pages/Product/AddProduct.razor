@page "/products/addedit/{Id:guid?}"
@using Domain
@using Infrastructure.Services
@inject IProductService ProductService
@inject IWebHostEnvironment Env
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h3 class="fw-bold mb-3">
    <i class="bi bi-box-seam me-2"></i> @(Id.HasValue ? "Edit" : "Add")
</h3>

<EditForm Model="@product" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Product Name</label>
            <InputText class="form-control" @bind-Value="product.ProductName" />
            <ValidationMessage For="@(() => product.ProductName)" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Brand</label>
            <InputText class="form-control" @bind-Value="product.Brand" />
            <ValidationMessage For="@(() => product.Brand)" />
        </div>
   @*      <div class="col-md-6 mb-3">
            <label class="form-label">Tyre Size</label>
            <InputText class="form-control" @bind-Value="product.TyreSize" />
            <ValidationMessage For="@(() => product.TyreSize)" />
        </div> 
         *@
        <div class="col-md-6 mb-3">
            <label class="form-label">Type</label>
            <InputText class="form-control" @bind-Value="product.Type" />
            <ValidationMessage For="@(() => product.Type)" />
        </div> 
        <div class="col-md-6 mb-3">
            <label class="form-label">Thread</label>
            <InputText class="form-control" @bind-Value="product.Thread" />
            <ValidationMessage For="@(() => product.Thread)" />
        </div>
         <div class="col-md-6 mb-3">
            <label class="form-label">Min Threshold</label>
            <InputText class="form-control" @bind-Value="product.Min_Threshold" />
        </div> 

         <div class="col-md-6 mb-3">
            <label class="form-label">Quantity</label>
            <InputNumber class="form-control" @bind-Value="product.Quantity" />
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label">Date of Manufacture (DOT)</label>
            <InputText class="form-control" @bind-Value="product.DOT" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Barcode</label>
            <InputText class="form-control" @bind-Value="product.Barcode" />
        </div>
        <div class="col-md-12 mb-3">
            <label class="form-label">Description</label>
            <InputTextArea class="form-control" @bind-Value="product.Description" />
        </div>
     

        <!-- Product Image Upload -->
        <div class="col-md-6 mb-3">
            <label class="form-label">Product Image</label>
            <InputFile OnChange="OnFileChange" />

            @if (HasValidImage(product.ImagePath))
            {
                <div class="mt-2">
                    <p class="small text-muted mb-1">Current Image:</p>
                    <img src="@product.ImagePath" alt="Product Image" class="img-thumbnail" style="max-height: 150px;" />
                    <div class="mt-1">
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveImage">
                            <i class="bi bi-trash"></i> Remove Image
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-2 text-muted small">
                    <i class="bi bi-image"></i> No image uploaded
                </div>
            }

            @if (!string.IsNullOrEmpty(uploadStatus))
            {
                <div class="alert alert-info mt-2 small">
                    @uploadStatus
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-end mt-0">
        <button type="submit" class="btn btn-success">
            <i class="bi bi-save me-1"></i> Save
        </button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">
            Cancel
        </button>
    </div>
</EditForm>

@code {
    [Parameter] public Guid? Id { get; set; }
    private Product product = new();
    private IBrowserFile uploadedFile;
    private string originalImagePath;
    private string uploadStatus;

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            var existing = await ProductService.GetByIdAsync(Id.Value);
            if (existing != null)
            {
                product = existing;
                originalImagePath = existing.ImagePath; // Store original image path
            }
        }
    }

    private async Task OnFileChange(InputFileChangeEventArgs e)
    {
        try
        {
            uploadedFile = e.File;
            uploadStatus = "Uploading image...";

            if (uploadedFile != null)
            {
                // Validate file type
                var validExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
                var fileExtension = Path.GetExtension(uploadedFile.Name).ToLower();

                if (!validExtensions.Contains(fileExtension))
                {
                    uploadStatus = "Invalid file type. Please upload an image file.";
                    return;
                }

                // Delete old image if it exists and is different from original
                if (!string.IsNullOrEmpty(product.ImagePath) && product.ImagePath != originalImagePath)
                {
                    DeleteImageFile(product.ImagePath);
                }

                var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads", "products");
                if (!Directory.Exists(uploadsFolder))
                    Directory.CreateDirectory(uploadsFolder);

                var fileName = $"{Guid.NewGuid()}{fileExtension}";
                var filePath = Path.Combine(uploadsFolder, fileName);

                using (var stream = uploadedFile.OpenReadStream(maxAllowedSize: 10_000_000))
                using (var fileStream = new FileStream(filePath, FileMode.Create))
                {
                    await stream.CopyToAsync(fileStream);
                }

                product.ImagePath = $"/uploads/products/{fileName}";
                uploadStatus = "Image uploaded successfully!";

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            uploadStatus = $"Error uploading image: {ex.Message}";
        }
    }

    private void RemoveImage()
    {
        if (!string.IsNullOrEmpty(product.ImagePath))
        {
            // Only delete if this is a newly uploaded image (not the original)
            if (product.ImagePath != originalImagePath)
            {
                DeleteImageFile(product.ImagePath);
            }
            product.ImagePath = null;
            uploadStatus = "Image removed!";
            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            bool success;

            if (Id.HasValue)
            {
                // If no new image was uploaded and image was removed, keep original
                if (string.IsNullOrEmpty(product.ImagePath) && !string.IsNullOrEmpty(originalImagePath))
                {
                    product.ImagePath = originalImagePath;
                }

                var updated = await ProductService.UpdateAsync(product);
                success = updated != null;

                if (success && !string.IsNullOrEmpty(originalImagePath) && product.ImagePath != originalImagePath)
                {
                    // Delete original image only after successful update
                    DeleteImageFile(originalImagePath);
                }
            }
            else
            {
                var added = await ProductService.AddAsync(product);
                success = added != null;
            }

            if (success)
            {
                Navigation.NavigateTo("/products");
            }
            else
            {
                uploadStatus = "Failed to save product.";
            }
        }
        catch (Exception ex)
        {
            uploadStatus = $"Error saving product: {ex.Message}";
        }
    }

    private void DeleteImageFile(string imagePath)
    {
        if (string.IsNullOrEmpty(imagePath) || !imagePath.StartsWith("/uploads/"))
            return;

        try
        {
            var fullPath = Path.Combine(Env.WebRootPath, imagePath.TrimStart('/'));
            if (System.IO.File.Exists(fullPath))
            {
                System.IO.File.Delete(fullPath);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting image file: {ex.Message}");
        }
    }

    private bool HasValidImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
            return false;

        var invalidValues = new[] { "NULL", "null", "undefined", "none", "no image", "-", "N/A" };
        if (invalidValues.Any(value => imagePath.Equals(value, StringComparison.OrdinalIgnoreCase)))
            return false;

        return true;
    }

    private void GoBack() => Navigation.NavigateTo("/products");
}