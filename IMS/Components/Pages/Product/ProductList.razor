@page "/products"
@using Domain
@using Infrastructure.Services
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Products</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="bi bi-box-seam me-2"></i> Product Management</h3>
        <button class="btn btn-primary" @onclick="AddProduct">
            <i class="bi bi-plus-circle me-1"></i> Add
        </button>
    </div>

    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Loading products...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> No products found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Thread</th>
                        <th>Brand</th>
                        <th>Tyre Size</th>
                        <th>Barcode</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in products)
                    {
                        <tr>
                            <td class="text-center">
                                <div class="d-flex justify-content-center align-items-center position-relative" style="width:60px; height:60px; margin: 0 auto;">
                                    @if (HasValidImage(item.ImagePath))
                                    {
                                        <img src="@GetImageUrl(item.ImagePath)"
                                             alt="@item.ProductName"
                                             class="border rounded shadow-sm product-image"
                                             style="width:100%; height:100%; object-fit:cover; position:absolute; top:0; left:0;"
                                             loading="lazy"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="image-fallback d-none justify-content-center align-items-center text-muted small fst-italic"
                                             style="width:100%; height:100%; border:1px dashed #ccc; border-radius:8px; background-color:#f8f9fa;">
                                            No Image
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-center align-items-center text-muted small fst-italic"
                                             style="width:100%; height:100%; border:1px dashed #ccc; border-radius:8px; background-color:#f8f9fa;">
                                            No Image
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>@item.ProductName</td>
                            <td>@item.Type</td>
                            <td>@item.Thread</td>
                            <td>@item.Brand</td>
                            <td>@item.TyreSize</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Barcode))
                                {
                                    <span class="badge bg-secondary">@item.Barcode</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <i class="bi bi-pencil-square text-primary fs-5 me-3 cursor-pointer"
                                   title="Edit" @onclick="() => EditProduct(item.Id)"></i>
                                <i class="bi bi-trash text-danger fs-5 cursor-pointer"
                                   title="Delete" @onclick="() => DeleteProduct(item.Id)"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    table.table th, table.table td {
        vertical-align: middle;
        text-align: center;
    }

    .table thead th {
        white-space: nowrap;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .quantity-low {
        color: #dc3545;
        font-weight: bold;
    }

    .quantity-medium {
        color: #ffc107;
        font-weight: bold;
    }

    .quantity-good {
        color: #198754;
    }

    .image-fallback {
        background-color: #f8f9fa;
    }
</style>

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetAllAsync();
    }

    // Improved image validation
    private bool HasValidImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
            return false;

        // Check for explicit invalid values
        var invalidValues = new[] { "NULL", "null", "undefined", "none", "no image", "-", "N/A", "test", "default" };
        if (invalidValues.Any(value =>
            imagePath.Equals(value, StringComparison.OrdinalIgnoreCase)))
            return false;

        // Check if it's a valid file path with extension
        var validExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" };
        var hasValidExtension = validExtensions.Any(ext =>
            imagePath.ToLower().EndsWith(ext));

        // Also check if it contains common image path patterns
        var hasImagePattern = imagePath.Contains("/images/") ||
                             imagePath.Contains("/img/") ||
                             imagePath.Contains("upload") ||
                             imagePath.Contains("product");

        return hasValidExtension || hasImagePattern;
    }

    // Improved URL generation
    private string GetImageUrl(string? imagePath)
    {
        if (!HasValidImage(imagePath))
            return string.Empty;

        var cleanPath = imagePath!.Trim();

        // If it's already a full URL, return as is
        if (cleanPath.StartsWith("http://") || cleanPath.StartsWith("https://"))
            return cleanPath;

        // Handle relative paths
        if (cleanPath.StartsWith("/"))
            return cleanPath;

        // Ensure it starts with a slash for relative paths
        return "/" + cleanPath;
    }

    // Format price display
    private string FormatPrice(decimal price)
    {
        return price == 0 ? "0.00" : price.ToString("F2");
    }

    // Get CSS class for quantity based on value
    private string GetQuantityClass(int quantity)
    {
        return quantity switch
        {
            0 => "quantity-low",
            < 10 => "quantity-medium",
            _ => "quantity-good"
        };
    }

    private void AddProduct() => Navigation.NavigateTo("/products/addedit");
    private void EditProduct(Guid id) => Navigation.NavigateTo($"/products/addedit/{id}");

    private async Task DeleteProduct(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this product?");
        if (!confirmed)
            return;

        await ProductService.DeleteAsync(id);
        products = await ProductService.GetAllAsync();
        StateHasChanged();
    }
}