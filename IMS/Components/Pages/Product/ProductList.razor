@page "/products"
@using Domain
@using Infrastructure.Services
@inject IProductService ProductService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Products</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="bi bi-box-seam me-2"></i> Product Management</h3>
        <button class="btn btn-primary" @onclick="AddProduct">
            <i class="bi bi-plus-circle me-1"></i> Add
        </button>
    </div>

    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Loading products...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> No products found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Brand</th>
                        <th>Tyre Size</th>
                        <th>Purchase</th>
                        <th>Selling</th>
                        <th>Qty</th>
                        <th>Barcode</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in products)
                    {
                        <tr>
                            <td class="text-center">
                                @if (HasValidImage(item.ImagePath))
                                {
                                    <div class="d-flex justify-content-center align-items-center position-relative">
                                        <img src="@GetImageUrl(item.ImagePath)"
                                             alt="@item.ProductName"
                                             class="border rounded shadow-sm"
                                             style="width:60px; height:60px; object-fit:cover;"
                                             loading="lazy"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="image-fallback d-flex justify-content-center align-items-center text-muted small fst-italic"
                                             style="width:60px; height:60px; border:1px dashed #ccc; border-radius:8px; display:none;">
                                            No Image
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex justify-content-center align-items-center text-muted small fst-italic"
                                         style="width:60px; height:60px; border:1px dashed #ccc; border-radius:8px;">
                                        No Image
                                    </div>
                                }
                            </td>
                            <td>@item.ProductName</td>
                            <td>@item.Brand</td>
                            <td>@item.TyreSize</td>
                            <td>@FormatPrice(item.PurchasePrice)</td>
                            <td>@FormatPrice(item.SellingPrice)</td>
                            <td>
                                <span class="@GetQuantityClass(item.Quantity)">@item.Quantity</span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Barcode))
                                {
                                    <span class="badge bg-secondary">@item.Barcode</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-2"
                                        title="Edit"
                                        @onclick="() => EditProduct(item.Id)">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        title="Delete"
                                        @onclick="() => DeleteProduct(item.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    table.table th, table.table td {
        vertical-align: middle;
        text-align: center;
    }

    .table thead th {
        white-space: nowrap;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .quantity-low {
        color: #dc3545;
        font-weight: bold;
    }

    .quantity-medium {
        color: #ffc107;
        font-weight: bold;
    }

    .quantity-good {
        color: #198754;
    }

    .image-fallback {
        background-color: #f8f9fa;
    }
</style>

@code {
    private List<Product>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetAllAsync();
    }

    // Check if the image path is valid
    private bool HasValidImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
            return false;

        if (imagePath.Equals("NULL", StringComparison.OrdinalIgnoreCase))
            return false;

        // Check for common invalid patterns
        var invalidPatterns = new[] { "no image", "null", "undefined", "none" };
        if (invalidPatterns.Any(pattern =>
            imagePath.Contains(pattern, StringComparison.OrdinalIgnoreCase)))
            return false;

        // Check if it looks like a file path
        var validExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" };
        return validExtensions.Any(ext =>
            imagePath.ToLower().Contains(ext));
    }

    // Helper method to get validated image URL
    private string GetImageUrl(string? imagePath)
    {
        if (!HasValidImage(imagePath))
            return string.Empty;

        // Clean the path
        var cleanPath = imagePath!.Trim().Replace("\\", "/");

        // Remove leading slashes if multiple exist
        while (cleanPath.StartsWith("//"))
            cleanPath = cleanPath.Substring(1);

        // Ensure it starts with a single slash
        if (!cleanPath.StartsWith("/"))
            cleanPath = "/" + cleanPath;

        return cleanPath;
    }

    // Format price display
    private string FormatPrice(decimal price)
    {
        return price == 0 ? "0.00" : price.ToString("F2");
    }

    // Get CSS class for quantity based on value
    private string GetQuantityClass(int quantity)
    {
        return quantity switch
        {
            0 => "quantity-low",
            < 10 => "quantity-medium",
            _ => "quantity-good"
        };
    }

    private void AddProduct() => Navigation.NavigateTo("/products/addedit");
    private void EditProduct(Guid id) => Navigation.NavigateTo($"/products/addedit/{id}");

    private async Task DeleteProduct(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this product?");
        if (!confirmed)
            return;

        await ProductService.DeleteAsync(id);
        products = await ProductService.GetAllAsync();
        StateHasChanged();
    }
}