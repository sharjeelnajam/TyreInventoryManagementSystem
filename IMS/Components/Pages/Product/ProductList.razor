@page "/products"
@using Domain
@using Domain.DTO
@using Domain.Enums
@using Infrastructure.Services
@inject IProductService ProductService
@inject IListManagementService ListManagementService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Products</PageTitle>

<div class="container mt-4">


    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold"><i class="bi bi-box-seam me-2"></i> Product Management</h3>
        @if (!isStaff && !isSupplier)
        {
            <button class="btn btn-primary" @onclick="AddProduct">
                <i class="bi bi-plus-circle me-1"></i> Add
            </button>
        }

    </div>

    <div class="row mb-3 g-2">
        <div class="col-md-2">

            <InputText class="form-control"
            placeholder="Search by Name,Type"
            @bind-Value="search_By_Name_Type_Thread"
            @oninput="@(e => OnSearchInput(e))" />
        </div>

    </div>

    @if (products == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Loading products...</p>
        </div>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i> No products found.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Quantity</th>
                        <th>Type</th>
                        <th>Tread</th>
                        <th>Size</th>
                        <th>Brand</th>
                        <th>Price</th>
                        <th style="width:150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in filteredProducts)
                    {
                        <tr>
                            <td class="text-center">
                                <div class="d-flex justify-content-center align-items-center position-relative" style="width:60px; height:60px; margin: 0 auto;">
                                    @if (HasValidImage(item.ImagePath))
                                    {
                                        <img src="@GetImageUrl(item.ImagePath)"
                                        alt="@item.ProductName"
                                        class="border rounded shadow-sm product-image"
                                        style="width:100%; height:100%; object-fit:cover; position:absolute; top:0; left:0;"
                                        loading="lazy"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="image-fallback d-none justify-content-center align-items-center text-muted small fst-italic"
                                        style="width:100%; height:100%; border:1px dashed #ccc; border-radius:8px; background-color:#f8f9fa;">
                                            No Image
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex justify-content-center align-items-center text-muted small fst-italic"
                                        style="width:100%; height:100%; border:1px dashed #ccc; border-radius:8px; background-color:#f8f9fa;">
                                            No Image
                                        </div>
                                    }
                                </div>
                            </td>
                            <td>@item.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Type</td>
                            <td>@GetUnitName(item.Unit)</td>
                            <td>@GetThreadName(item.ThreadId)</td>
                            <td>@item.Brand</td>
                            <td>@FormatPrice(item.SellingPrice)</td>
                            <td>
                                <i class="bi bi-eye text-info fs-5 me-3 cursor-pointer"
                                   title="View"
                                   @onclick="() => ViewProduct(item.Id)"></i>

                                @if (isSuperAdmin)
                                {
                                    <i class="bi bi-pencil-square text-primary fs-5 me-3 cursor-pointer"
                                       title="Edit"
                                       @onclick="() => EditProduct(item.Id)"></i>
                                    <i class="bi bi-trash text-danger fs-5 me-3 cursor-pointer"
                                       title="Delete"
                                       @onclick="() => DeleteProduct(item.Id)"></i>
                                }
                                @if (isSuperAdmin)
                                {
                                    <button class="btn btn-success btn-sm text-nowrap ms-2" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;" title="Manage Selling Price" @onclick="() => OpenPricePopup(item)">
                                        Manage Price
                                    </button>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>

            @if (showPricePopup)
            {
                <div class="modal fade show d-block" style="background:rgba(0,0,0,0.4)">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header">
                                <h5 class="modal-title fw-bold">Manage Selling Price</h5>
                                <button type="button" class="btn-close" @onclick="ClosePopup"></button>
                            </div>

                            <div class="modal-body">

                                <div class="mb-3">
                                    <label class="form-label">Purchase Price</label>
                                    <InputNumber @bind-Value="selectedProduct.PurchasePrice" class="form-control" readonly/>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Normal Price</label>
                                    <InputNumber @bind-Value="selectedProduct.SellingPrice" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Least Selling Price</label>
                                    <InputNumber @bind-Value="leastSellingPrice" class="form-control" />
                                </div>

                            </div>

                            <div class="modal-footer">
                                <button class="btn btn-secondary" @onclick="ClosePopup">Cancel</button>
                                <button class="btn btn-success" @onclick="SavePrices">Save</button>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>

<style>
    table.table th, table.table td {
    vertical-align: middle;
    text-align: center;
    }

    .table thead th {
    white-space: nowrap;
    }

    .cursor-pointer {
    cursor: pointer;
    }

    .quantity-low {
    color: #dc3545;
    font-weight: bold;
    }

    .quantity-medium {
    color: #ffc107;
    font-weight: bold;
    }

    .quantity-good {
    color: #198754;
    }

    .image-fallback {
    background-color: #f8f9fa;
    }
</style>

@code {
    private List<ProductDto>? products;
    private IEnumerable<ProductDto>? filteredProducts;

    private string search_By_Name_Type_Thread = "";
    private string searchType = "";
    private string searchThread = "";

    private bool showPricePopup = false;
    private ProductDto selectedProduct = new();
    private decimal leastSellingPrice;
    private bool isSuperAdmin = false;
    private bool isStaff = false;
    private bool isSupplier = false;

    private List<ListManagement>? units;
    private Dictionary<Guid, string> unitsLookup = new();

    private List<ListManagement>? Threads;
    private Dictionary<Guid, string> ThreadsLookup = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isSuperAdmin = user.IsInRole("SuperAdmin");
        isStaff = user.IsInRole("Staff");
        isSupplier = user.IsInRole("Supplier");

        products = await ProductService.GetAllAsync();
        filteredProducts = products;
        units = await ListManagementService.GetByTypeAsync(ListType.Tread);
        Threads = await ListManagementService.GetByTypeAsync(ListType.Size);
        unitsLookup = units?.ToDictionary(c => c.Id, c => c.Name) ?? new Dictionary<Guid, string>();
        ThreadsLookup = Threads?.ToDictionary(c => c.Id, c => c.Name) ?? new Dictionary<Guid, string>();
       
    }

    private string GetUnitName(Guid unitId)
    {
        if (unitId == Guid.Empty) return "";
        return unitsLookup.TryGetValue(unitId, out var name) ? name : "";
    } 
    
    private string GetThreadName(Guid threadId)
    {
        if (threadId == Guid.Empty) return "";
        return ThreadsLookup.TryGetValue(threadId, out var name) ? name : "";
    }

    // Improved image validation
    private bool HasValidImage(string? imagePath)
    {
        if (string.IsNullOrWhiteSpace(imagePath))
            return false;

        // Check for explicit invalid values
        var invalidValues = new[] { "NULL", "null", "undefined", "none", "no image", "-", "N/A", "test", "default" };
        if (invalidValues.Any(value =>
            imagePath.Equals(value, StringComparison.OrdinalIgnoreCase)))
            return false;

        // Check if it's a valid file path with extension
        var validExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg" };
        var hasValidExtension = validExtensions.Any(ext =>
            imagePath.ToLower().EndsWith(ext));

        // Also check if it contains common image path patterns
        var hasImagePattern = imagePath.Contains("/images/") ||
                             imagePath.Contains("/img/") ||
                             imagePath.Contains("upload") ||
                             imagePath.Contains("product");

        return hasValidExtension || hasImagePattern;
    }

    // Improved URL generation
    private string GetImageUrl(string? imagePath)
    {
        if (!HasValidImage(imagePath))
            return string.Empty;

        var cleanPath = imagePath!.Trim();

        // If it's already a full URL, return as is
        if (cleanPath.StartsWith("http://") || cleanPath.StartsWith("https://"))
            return cleanPath;

        // Handle relative paths
        if (cleanPath.StartsWith("/"))
            return cleanPath;

        // Ensure it starts with a slash for relative paths
        return "/" + cleanPath;
    }

    // Format price display
    private string FormatPrice(decimal price)
    {
        return price == 0 ? "0.00" : price.ToString("F2");
    }

    // Get CSS class for quantity based on value
    private string GetQuantityClass(int quantity)
    {
        return quantity switch
        {
            0 => "quantity-low",
            < 10 => "quantity-medium",
            _ => "quantity-good"
        };
    }

    private void AddProduct() => Navigation.NavigateTo("/products/addedit");

    private void EditProduct(Guid id) => Navigation.NavigateTo($"/products/addedit/{id}");

    private async Task DeleteProduct(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this product?");
        if (!confirmed)
            return;

        await ProductService.DeleteAsync(id);
        products = await ProductService.GetAllAsync();
        FilterProducts(); // refresh filtered list so the table updates immediately
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        search_By_Name_Type_Thread = e.Value?.ToString() ?? "";
        FilterProducts();
    }

    private void FilterProducts(ChangeEventArgs? e = null)
   {
        filteredProducts = products!
            .Where(p =>
                (string.IsNullOrWhiteSpace(search_By_Name_Type_Thread) ||
                 p.ProductName.StartsWith(search_By_Name_Type_Thread, StringComparison.OrdinalIgnoreCase)) ||

                (string.IsNullOrWhiteSpace(search_By_Name_Type_Thread) ||
                 p.Type.StartsWith(search_By_Name_Type_Thread, StringComparison.OrdinalIgnoreCase)) ||

                 (string.IsNullOrWhiteSpace(search_By_Name_Type_Thread))
                //  p.Thread.StartsWith(search_By_Name_Type_Thread, StringComparison.OrdinalIgnoreCase))
            )
            .ToList();

        StateHasChanged();
    }

    private void OpenPricePopup(ProductDto product)
    {
        selectedProduct = new ProductDto
            {
                Id = product.Id,
                PurchasePrice = product.PurchasePrice,
                SellingPrice = product.SellingPrice
            };

        leastSellingPrice = product.SellingPrice;
        showPricePopup = true;
    }

    private void ViewProduct(Guid id)
    {
        Navigation.NavigateTo($"/products/view/{id}");
    }


    private void ClosePopup()
    {
        showPricePopup = false;
    }

    private async Task SavePrices()
    {
        selectedProduct.Description = $"LeastPrice:{leastSellingPrice}";

        await ProductService.UpdateAsync(selectedProduct);

        showPricePopup = false;

        products = await ProductService.GetAllAsync();
        filteredProducts = products;
        StateHasChanged();
    }

}