@using Domain
@using Infrastructure.Services
@inject ISupplierService SupplierService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<div class="modal-backdrop fade show"></div>
<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@ModalTitle</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
            </div>

            <div class="modal-body">
                <EditForm Model="Supplier" OnValidSubmit="SaveSupplier">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-6">
                            <label>Name *</label>
                            <InputText class="form-control" @bind-Value="Supplier.Name" />
                            <ValidationMessage For="@(() => Supplier.Name)" />
                        </div>
                        <div class="col-md-6">
                            <label>Phone *</label>
                            <InputText class="form-control" @bind-Value="Supplier.Phone" />
                            <ValidationMessage For="@(() => Supplier.Phone)" />
                        </div>
                        <div class="col-md-6">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="Supplier.Email" />
                        </div>
                        <div class="col-md-6">
                            <label>Address</label>
                            <InputText class="form-control" @bind-Value="Supplier.Address" />
                        </div>
                        <div class="col-md-6">
                            <label>City</label>
                            <InputText class="form-control" @bind-Value="Supplier.City" />
                        </div>
                        <div class="col-md-6">
                            <label>Company Name</label>
                            <InputText class="form-control" @bind-Value="Supplier.CompanyName" />
                        </div>
                        <div class="col-md-6">
                            <label>Tax Number</label>
                            <InputText class="form-control" @bind-Value="Supplier.TaxNumber" />
                        </div>
                        <div class="col-md-6">
                            <label>Contact Person</label>
                            <InputText class="form-control" @bind-Value="Supplier.ContactPerson" />
                        </div>
                        <div class="col-md-6">
                            <label>Payment Terms</label>
                            <InputSelect class="form-control" @bind-Value="Supplier.PaymentTerms">
                                <option value="">-- Select --</option>
                                <option value="Net 30">Net 30</option>
                                <option value="Advance">Advance</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6 d-flex align-items-center mt-3">
                            <InputCheckbox class="form-check-input me-2" @bind-Value="Supplier.IsActive" />
                            <label class="form-check-label">Is Active</label>
                        </div>
                    </div>

                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-primary me-2">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Supplier Supplier { get; set; } = new();
    [Parameter] public string ModalTitle { get; set; } = "Add";

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task SaveSupplier()
    {
        bool success;

        if (Supplier.Id == Guid.Empty)
            success = await SupplierService.CreateAsync(Supplier);
        else
            success = await SupplierService.UpdateAsync(Supplier);

        if (success && OnSaved.HasDelegate)
            await OnSaved.InvokeAsync();
    }

    private async Task Close()
    {
        if (OnCancel.HasDelegate)
            await OnCancel.InvokeAsync();
    }
}