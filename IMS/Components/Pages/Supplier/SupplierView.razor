@page "/suppliers/view/{Id:guid}"
@using Domain
@using Infrastructure.Services
@inject ISupplierService SupplierService
@inject IPurchaseService PurchaseService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Supplier Details</PageTitle>

<h4 class="mb-3">🏭 View Supplier Details</h4>

@if (Supplier == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card p-3">
        <div class="row">
            <div class="col-md-4">
                <label>Name</label>
                <input class="form-control" value="@Supplier.Name" readonly />
            </div>
            <div class="col-md-4">
                <label>Phone</label>
                <input class="form-control" value="@Supplier.Phone" readonly />
            </div>
            <div class="col-md-4">
                <label>Email</label>
                <input class="form-control" value="@(Supplier.Email ?? "N/A")" readonly />
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-4">
                <label>Company Name</label>
                <input class="form-control" value="@(Supplier.CompanyName ?? "N/A")" readonly />
            </div>
            <div class="col-md-4">
                <label>City</label>
                <input class="form-control" value="@(Supplier.City ?? "N/A")" readonly />
            </div>
            <div class="col-md-4">
                <label>Payment Terms</label>
                <input class="form-control" value="@(Supplier.PaymentTerms ?? "N/A")" readonly />
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-4">
                <label>Contact Person</label>
                <input class="form-control" value="@(Supplier.ContactPerson ?? "N/A")" readonly />
            </div>
            <div class="col-md-4">
                <label>Tax Number</label>
                <input class="form-control" value="@(Supplier.TaxNumber ?? "N/A")" readonly />
            </div>
            <div class="col-md-4">
                <label>Status</label>
                <input class="form-control" value="@(Supplier.IsActive ? "Active" : "Inactive")" readonly />
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-12">
                <label>Address</label>
                <input class="form-control" value="@(Supplier.Address ?? "N/A")" readonly />
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3"><i class="bi bi-truck me-2"></i> Purchasing History</h5>
        <p class="text-muted small">Purchases we have made from this supplier.</p>
        @if (SellingHistory != null && SellingHistory.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Purchase #</th>
                            <th>Date</th>
                            <th class="text-end">Net Amount (£)</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var purchase in SellingHistory)
                        {
                            <tr>
                                <td>@(purchase.PurchaseNumber ?? "—")</td>
                                <td>@purchase.PurchaseDate.ToString("dd-MMM-yyyy")</td>
                                <td class="text-end">@purchase.NetAmount.ToString("N2")</td>
                                <td>@(purchase.PaymentStatus ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (SellingHistory != null)
        {
            <p class="text-muted mb-0">No purchases from this supplier yet.</p>
        }

        <div class="mt-3 text-end">
            <button class="btn btn-secondary" @onclick="GoBack">Back</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Supplier? Supplier;
    private List<Purchase>? SellingHistory;

    protected override async Task OnInitializedAsync()
    {
        Supplier = await SupplierService.GetByIdAsync(Id);
        if (Supplier != null)
            SellingHistory = await PurchaseService.GetPurchasesBySupplierIdAsync(Id);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/suppliers");
    }
}
