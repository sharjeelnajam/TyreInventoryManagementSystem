@using Domain
@using Domain.Enums
@using Infrastructure.Services
@rendermode InteractiveServer
@inject ICustomerService CustomerService
@inject IListManagementService ListManagementService

<EditForm Model="CustomerModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    <div class="p-4 shadow-lg border-0" style="border-radius:14px; background:white;">

        <h4 class="fw-bold mb-4 pb-2 border-bottom"
        style="background: linear-gradient(90deg,#4b6cb7,#182848); -webkit-background-clip:text; color:transparent;">
            Customer Details
        </h4>

        <div class="row g-3">

            <div class="col-md-12 mt-3">
                <div class="form-check form-switch">
                    <InputCheckbox @bind-Value="EnableCustomPricing"
                    class="form-check-input" />
                    <label class="form-check-label fw-semibold ms-2">
                        Enable Custom Pricing
                    </label>
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Name *</label>
                <InputText @bind-Value="CustomerModel.Name"
                class="form-control form-control-lg shadow-sm" />
                <ValidationMessage For="@(() => CustomerModel.Name)" />
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Phone *</label>
                <InputText @bind-Value="CustomerModel.Phone"
                class="form-control form-control-lg shadow-sm" />
                <ValidationMessage For="@(() => CustomerModel.Phone)" />
            </div>

            @*    <div class="col-md-6">
                <label class="form-label fw-semibold">Email</label>
                <InputText @bind-Value="CustomerModel.Email"
                           class="form-control form-control-lg shadow-sm" />
                <ValidationMessage For="@(() => CustomerModel.Email)" />
            </div> *@

            <div class="col-md-6">
                <label class="form-label fw-semibold">City</label>
                <InputText @bind-Value="CustomerModel.City"
                class="form-control form-control-lg shadow-sm" />
            </div>

            @if (EnableCustomPricing)
            {
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Percentage (%)</label>
                    <InputNumber @bind-Value="CustomerModel.Percentage"
                    class="form-control form-control-lg shadow-sm" />
                    <ValidationMessage For="@(() => CustomerModel.Percentage)" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Custom Price</label>
                    <InputNumber @bind-Value="CustomerModel.CustomPrice"
                    class="form-control form-control-lg shadow-sm" />
                    <ValidationMessage For="@(() => CustomerModel.CustomPrice)" />
                </div>
            }

            <div class="col-md-6">
                <label class="form-label fw-semibold">Customer Type *</label>

                <InputSelect @bind-Value="CustomerModel.ListManagementId"
                             class="form-select form-select-lg shadow-sm">

                    <option value="">-- Select Type --</option>

                    @foreach (var type in listManagements)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>

                <ValidationMessage For="@(() => CustomerModel.ListManagementId)" />
            </div>


            <div class="col-md-6 d-flex align-items-center mt-3">
                <InputCheckbox @bind-Value="CustomerModel.IsActive"
                class="form-check-input me-2 fs-5" />
                <label class="form-check-label fw-semibold">Active</label>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit"
            class="btn text-white px-4 py-2 me-2 shadow-sm"
            style="border-radius:8px; background: linear-gradient(135deg,#28a745,#218838);">
                Save
            </button>

            <button type="button"
            class="btn btn-light px-4 py-2 border shadow-sm"
            style="border-radius:8px;"
            @onclick="OnCancelled">
                Cancel
            </button>
        </div>

    </div>
</EditForm>


@code {
    [Parameter] public Customer CustomerModel { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
    private bool EnableCustomPricing { get; set; }
    private List<ListManagement> listManagements = new List<ListManagement>();

    protected override  async Task OnInitializedAsync()
    {
        listManagements = await ListManagementService.GetByTypeAsync(ListType.CustomerType);

        EnableCustomPricing = CustomerModel.Percentage.HasValue
                              || CustomerModel.CustomPrice.HasValue;
    }

    private async Task HandleValidSubmit()
    {
        if (CustomerModel.Id == Guid.Empty)
        {
            await CustomerService.AddCustomerAsync(CustomerModel);
        }
        else
        {
            await CustomerService.UpdateCustomerAsync(CustomerModel);
        }

        await OnSaved.InvokeAsync();
    }
}