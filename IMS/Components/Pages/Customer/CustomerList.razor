@page "/customers"
@using Domain
@using Domain.Enums
@using Infrastructure.Services
@rendermode InteractiveServer
@inject NavigationManager Navigation

@inject ICustomerService CustomerService
@inject IListManagementService ListManagementService
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<h3>Customers</h3>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-success" @onclick="()=>OpenModal(new Customer())">Add</button>
</div>

<div class="row mb-3">

    <div class="col-md-2">
        <InputText class="form-control"
        placeholder="Search by name or registration..."
        TValue="string"
        Value=""
        ValueChanged="OnNameChanged"
        ValueExpression="@(() => searchName)" />
    </div>

    <div class="col-md-2">
        <InputSelect class="form-select"
        TValue="Guid?"
        Value="searchTypeId"
        ValueChanged="OnTypeChanged"
        ValueExpression="@(() => searchTypeId)">
            <option value="">-- Select Type --</option>

            @foreach (var type in listManagementsList)
            {
                <option value="@type.Id">@type.Name</option>
            }
        </InputSelect>
    </div>
</div>




<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            @*  <th>Email</th> *@
            <th>Vehicle number</th>
            <th>City</th>
            <th>Type</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (customers == null || customers.Count == 0)
        {
            <tr><td colspan="7" class="text-center">No customers found</td></tr>
        }
        else
        {
            @foreach (var c in customers)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Phone</td>
                    @*     <td>@c.Email</td> *@
                    <td>@(string.IsNullOrWhiteSpace(c.VehicleNumber) ? "—" : c.VehicleNumber)</td>
                    <td>@c.City</td>
                    <td>@GetCustomerTypeName(c.ListManagementId)</td>
                    <td>@(c.IsActive ? "Yes" : "No")</td>
                    <td>
                        <!-- View -->
                        <span role="button" title="View" class="text-info me-2"
                        @onclick="() => ViewCustomer(c.Id)">
                            <i class="bi bi-eye fs-5"></i>
                        </span>
                        @if (isSuperAdmin)
                        {
                            <!-- Edit -->
                            <span role="button" title="Edit" class="text-warning me-2"
                                  @onclick="() => OpenModal(c)">
                                <i class="bi bi-pencil-square fs-5"></i>
                            </span>
                            <!-- Delete -->
                            <span role="button" title="Delete" class="text-danger"
                                  @onclick="() => DeleteCustomer(c.Id)">
                                <i class="bi bi-trash fs-5"></i>
                            </span>
                        }
                     
                       
                    </td>

                </tr>
            }
        }
    </tbody>
</table>

<!-- Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" style="background-color:rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 800px;">
            <div class="modal-content">
                <div class="modal-body">
                    <AddCustomer CustomerModel="selectedCustomer" OnSaved="OnSaved" OnCancelled="CloseModal" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Customer> customers = new();
    private string? searchName;
    private Guid? searchTypeId;
    private bool showModal = false;
    private Customer selectedCustomer;
    private List<ListManagement>? customerTypes;
    private Dictionary<Guid, string> customerTypesLookup = new();
    private List<ListManagement> listManagementsList = new List<ListManagement>();
    private bool isStaff = false;
    private bool isSuperAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isStaff = user.IsInRole("Staff");
        isSuperAdmin = user.IsInRole("SuperAdmin");

        await LoadCustomers();
     
    }

    private async Task LoadCustomers()
    {
        customers = await CustomerService.GetCustomersAsync(searchName, searchTypeId);
        customerTypes = await ListManagementService.GetByTypeAsync(ListType.CustomerType);

        // Create lookup dictionary
        customerTypesLookup = customerTypes.ToDictionary(c => c.Id, c => c.Name);

        // Populate type filter dropdown
        listManagementsList = customerTypes.ToList();
    }

    private string GetCustomerTypeName(Guid customerTypeId)
    {
        return customerTypesLookup.TryGetValue(customerTypeId, out var name) ? name : "N/A";
    }

    private async Task ApplyFilter()
    {
        await LoadCustomers();
    }

    private async Task OnNameChanged(string value)
    {
        searchName = value;
        await ApplyFilter();
    }

    private async Task OnTypeChanged(Guid? value)
    {
        searchTypeId = value;
        await ApplyFilter();
    }

    private void OpenModal(Customer c)
    {
        selectedCustomer = new Customer
        {
            Id = c.Id,
            Name = c.Name,
            Phone = c.Phone,
            Email = c.Email,
            City = c.City,
            SpecialNote = c.SpecialNote,
            VehicleNumber = c.VehicleNumber,
            CreditLimit = c.CreditLimit,
            IsActive = c.IsActive,
            ListManagementId = c.ListManagementId
        };
        showModal = true;
    }

    private async Task OnSaved()
    {
        showModal = false;
        await LoadCustomers();
        StateHasChanged();
    }

    private void CloseModal()
    {
        showModal = false;
    }

    private async Task DeleteCustomer(Guid id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete this customer?");
        if (confirmed)
        {
            await CustomerService.DeleteCustomerAsync(id);
            await LoadCustomers();
        }
    }

    private void ViewCustomer(Guid id)
    {
        Navigation.NavigateTo($"/customers/view/{id}");
    }

}
