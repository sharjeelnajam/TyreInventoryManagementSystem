@page "/customers/view/{Id:guid}"
@using Domain
@using Domain.Enums
@using Infrastructure.Services
@inject ICustomerService CustomerService
@inject IListManagementService ListManagementService
@inject IWholesalerPriceService WholesalerPriceService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Customer Details</PageTitle>

<div class="container mt-4">

    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-eye me-2"></i> Customer Details
            </h5>

            <button class="btn btn-light btn-sm" @onclick="GoBack">
                <i class="bi bi-arrow-left"></i> Back
            </button>
        </div>

        <div class="card-body">

            @if (Customer == null)
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-secondary"></div>
                </div>
            }
            else
            {
                <div class="row g-3">

                    <div class="col-md-6">
                        <strong>Name:</strong>
                        <p>@Customer.Name</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Phone:</strong>
                        <p>@Customer.Phone</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Email:</strong>
                        <p>@(Customer.Email ?? "N/A")</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Registered At:</strong>
                        <p>@Customer.CreatedAt.ToShortDateString()</p>
                    </div>

                    <div class="col-md-6">
                        <strong>City:</strong>
                        <p>@(Customer.City ?? "N/A")</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Vehicle Number:</strong>
                        <p>@(Customer.VehicleNumber ?? "N/A")</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Customer Type:</strong>
                        <p>@CustomerTypeName</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Status:</strong>
                        <p>
                            <span class="badge @(Customer.IsActive ? "bg-success" : "bg-danger")">
                                @(Customer.IsActive ? "Active" : "Inactive")
                            </span>
                        </p>
                    </div>

                    <div class="col-md-6">
                        <strong>Credit Limit:</strong>
                        <p>£ @(Customer.CreditLimit?.ToString("N2") ?? "0.00")</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Discount %:</strong>
                        <p>@(Customer.Percentage?.ToString("N2") ?? "0") %</p>
                    </div>

                    <div class="col-md-6">
                        <strong>Custom Price:</strong>
                        <p>£ @(Customer.CustomPrice?.ToString("N2") ?? "0.00")</p>
                    </div>

                    <div class="col-md-12">
                        <strong>Address:</strong>
                        <p>@(Customer.Address ?? "N/A")</p>
                    </div>

                    @if (IsWholesalerType)
                    {
                        <div class="col-md-12 mt-3">
                            <hr />
                            <h5 class="mb-3"><i class="bi bi-currency-pound me-2"></i> Wholesaler Price List</h5>
                            <button class="btn btn-sm btn-success" @onclick="OpenPriceModal">
                                <i class="bi bi-plus-circle me-1"></i> Manage Prices
                            </button>
                            @if (Prices != null && Prices.Any())
                            {
                                <table class="table table-bordered mt-3">
                                    <thead>
                                        <tr><th>Thread</th><th>Unit</th><th class="text-end">Price (£)</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Prices)
                                        {
                                            <tr>
                                                <td>@GetThreadName(p.ThreadId)</td>
                                                <td>@GetUnitName(p.UnitId)</td>
                                                <td class="text-end">£ @p.Price</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else if (Prices != null)
                            {
                                <p class="text-muted mt-2">No prices added. Click "Manage Prices" to add.</p>
                            }
                        </div>
                        @if (ShowPriceModal)
                        {
                            <WholesalerManagePrice CustomerId="@Id" OnClose="ClosePriceModalAndRefresh" />
                        }
                    }

                </div>
            }

        </div>
    </div>

</div>


@code {
    [Parameter] public Guid Id { get; set; }

    private Customer? Customer;
    private string CustomerTypeName = "N/A";
    private bool IsWholesalerType;
    private List<CustomerSalerPrice>? Prices;
    private Dictionary<Guid, string> ThreadLookup = new();
    private Dictionary<Guid, string> UnitLookup = new();
    private bool ShowPriceModal;

    protected override async Task OnInitializedAsync()
    {
        Customer = await CustomerService.GetCustomerByIdAsync(Id);

        if (Customer != null)
        {
            var types = await ListManagementService.GetByTypeAsync(ListType.CustomerType);
            CustomerTypeName = types.FirstOrDefault(x => x.Id == Customer.ListManagementId)?.Name ?? "N/A";
            IsWholesalerType = string.Equals(CustomerTypeName, "Wholesaler", StringComparison.OrdinalIgnoreCase);
            if (IsWholesalerType)
            {
                Prices = await WholesalerPriceService.GetByCustomerIdAsync(Id);
                var threads = await ListManagementService.GetByTypeAsync(ListType.Thread);
                var units = await ListManagementService.GetByTypeAsync(ListType.Unit);
                ThreadLookup = threads.ToDictionary(x => x.Id, x => x.Name);
                UnitLookup = units.ToDictionary(x => x.Id, x => x.Name);
            }
        }
    }

    string GetThreadName(Guid id) => ThreadLookup.TryGetValue(id, out var n) ? n : "N/A";
    string GetUnitName(Guid id) => UnitLookup.TryGetValue(id, out var n) ? n : "N/A";
    void OpenPriceModal() => ShowPriceModal = true;
    async Task ClosePriceModalAndRefresh()
    {
        ShowPriceModal = false;
        if (IsWholesalerType)
            Prices = await WholesalerPriceService.GetByCustomerIdAsync(Id);
        StateHasChanged();
    }

    void GoBack()
    {
        Navigation.NavigateTo("/customers");
    }
}
