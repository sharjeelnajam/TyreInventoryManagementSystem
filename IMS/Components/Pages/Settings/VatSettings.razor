@page "/settings/vat"
@using Domain.Enums
@using IMS.Services
@inject IVatSettingsClientService VatSettingsService
@rendermode InteractiveServer

<PageTitle>VAT Settings</PageTitle>

<div class="container mt-4" style="max-width: 760px;">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h4 class="mb-2">VAT Settings</h4>
            <div class="vat-mode-list mt-3">
                <button type="button"
                        class="vat-mode-item @(SelectedMode == VatMode.PlusVat ? "active" : "")"
                        @onclick="() => SelectedMode = VatMode.PlusVat">
                    <span class="vat-mode-title">Plus VAT</span>
                    <span class="vat-mode-dot"></span>
                </button>

                <button type="button"
                        class="vat-mode-item @(SelectedMode == VatMode.IncludingVat ? "active" : "")"
                        @onclick="() => SelectedMode = VatMode.IncludingVat">
                    <span class="vat-mode-title">Including VAT</span>
                    <span class="vat-mode-dot"></span>
                </button>

                <button type="button"
                        class="vat-mode-item @(SelectedMode == VatMode.ExcludeVat ? "active" : "")"
                        @onclick="() => SelectedMode = VatMode.ExcludeVat">
                    <span class="vat-mode-title">Exclude VAT</span>
                    <span class="vat-mode-dot"></span>
                </button>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="button" class="btn btn-primary px-4" @onclick="SaveMode" disabled="@(isSaving || SelectedMode == CurrentMode)">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private VatMode CurrentMode { get; set; } = VatMode.ExcludeVat;
    private VatMode SelectedMode { get; set; } = VatMode.ExcludeVat;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        CurrentMode = await VatSettingsService.GetModeAsync();
        SelectedMode = CurrentMode;
    }

    private async Task SaveMode()
    {
        isSaving = true;
        await VatSettingsService.SetModeAsync(SelectedMode);
        CurrentMode = SelectedMode;
        isSaving = false;
    }
}

<style>
    .vat-mode-list {
        display: grid;
        gap: 10px;
    }

    .vat-mode-item {
        width: 100%;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        background: #fff;
        color: #1f2937;
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.15s ease-in-out;
    }

    .vat-mode-item:hover {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.08);
    }

    .vat-mode-item.active {
        border-color: #7c3aed;
        background: #f6f2ff;
    }

    .vat-mode-title {
        font-weight: 600;
        font-size: 0.98rem;
    }

    .vat-mode-dot {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 2px solid #c3c7d0;
        position: relative;
        display: inline-block;
        background: #fff;
    }

    .vat-mode-item.active .vat-mode-dot {
        border-color: #7c3aed;
    }

    .vat-mode-item.active .vat-mode-dot::after {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7c3aed;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
</style>
