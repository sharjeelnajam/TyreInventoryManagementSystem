@using Domain
@using Domain.Enums
@using Infrastructure.Services
@inject IExpenseService ExpenseService
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.4)">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content shadow-lg border-0" style="border-radius:14px;">

                <!-- Header -->
                <div class="modal-header text-white"
                     style="background: linear-gradient(135deg, #4b6cb7, #182848); border-top-left-radius:14px; border-top-right-radius:14px;">
                    <h5 class="modal-title fw-bold">@ModalTitle</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideModal"></button>
                </div>

                <!-- Body -->
                <div class="modal-body px-4 py-4">

                    <EditForm Model="@expenses" OnValidSubmit="SaveAll">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        @if (!isEditMode)
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Date</label>
                                    <InputDate @bind-Value="commonDate" class="form-control form-control-lg shadow-sm" />
                                </div>

                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Notes (Optional)</label>
                                    <InputText @bind-Value="commonNote"
                                               class="form-control form-control-lg shadow-sm"
                                               placeholder="Enter general notes" />
                                </div>
                            </div>

                            <h5 class="fw-bold mb-3">Expense Items</h5>
                        }

                        <!-- Table -->
                        <div class="table-responsive shadow-sm rounded-3">
                            <table class="table table-bordered table-striped align-middle mb-0">
                                <thead style="background:#f8f9fa;">
                                    <tr>
                                        <th class="fw-semibold">Title</th>
                                        <th class="fw-semibold">Category</th>
                                        <th class="fw-semibold">Amount (Rs)</th>

                                        @if (!isEditMode)
                                        {
                                            <th class="fw-semibold">Description</th>
                                            <th class="fw-semibold">Document</th>
                                            <th class="fw-semibold text-center" style="width:50px;">Action</th>
                                        }
                                        else
                                        {
                                            <th class="fw-semibold">Date</th>
                                            <th class="fw-semibold">Description</th>
                                            <th class="fw-semibold">Document</th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var expense in expenses)
                                    {
                                        <tr @key="expense.Id">
                                            <td>
                                                <InputText class="form-control form-control-sm shadow-sm"
                                                           @bind-Value="expense.Title" />
                                            </td>

                                            <td>
                                                <InputSelect class="form-select form-select-sm shadow-sm"
                                                             @bind-Value="expense.Category">
                                                    @foreach (var cat in Enum.GetValues<ExpenseCategory>())
                                                    {
                                                        <option value="@cat">@cat</option>
                                                    }
                                                </InputSelect>
                                            </td>

                                            <td>
                                                <InputNumber class="form-control form-control-sm shadow-sm"
                                                             @bind-Value="expense.Amount" />
                                            </td>

                                            @if (isEditMode)
                                            {
                                                <td>
                                                    <InputDate class="form-control form-control-sm shadow-sm"
                                                               @bind-Value="expense.Date" />
                                                </td>
                                            }

                                            <td>
                                                <InputText class="form-control form-control-sm shadow-sm"
                                                           @bind-Value="expense.Description" />
                                            </td>

                                            <td>
                                                <InputFile OnChange="@(e => OnFileSelected(expense, e))" />

                                                @if (!string.IsNullOrEmpty(expense.UploadedFile))
                                                {
                                                    <div class="d-flex align-items-center mt-1">
                                                        <span class="small text-muted me-2">@expense.UploadedFile</span>

                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger rounded-pill"
                                                                @onclick="() => RemoveFile(expense)">
                                                            ✕
                                                        </button>
                                                    </div>
                                                }
                                            </td>

                                            @if (!isEditMode)
                                            {
                                                <td class="text-center">
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger rounded-circle px-2"
                                                            @onclick="() => ConfirmDelete(expense)">
                                                        ✕
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!isEditMode)
                        {
                            <button class="btn btn-outline-primary mt-3 px-4 py-2 shadow-sm"
                                    type="button"
                                    @onclick="AddRow">
                                + Add Expense
                            </button>
                        }

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit"
                                    class="btn text-white px-4 py-2 me-2 shadow-sm"
                                    style="border-radius:8px; background: linear-gradient(135deg,#28a745,#218838);">
                                💾 Save
                            </button>

                            <button type="button"
                                    class="btn btn-light px-4 py-2 border shadow-sm"
                                    style="border-radius:8px;"
                                    @onclick="HideModal">
                                Cancel
                            </button>
                        </div>

                    </EditForm>
                </div>

            </div>
        </div>
    </div>
}

<style>
    .modal {
        display: block;
    }

        .modal.fade:not(.show) {
            display: none;
        }
</style>


@code {
    private List<Expense> expenses = new();
    private DateTime commonDate = DateTime.Today;
    private string? commonNote;
    private string ModalTitle = "Add Expense";
    private bool IsVisible;

    [Parameter] public EventCallback OnSaved { get; set; }

    private bool isEditMode => SelectedExpense != null;
    private Expense? SelectedExpense;

    public void ShowModal(Expense? exp)
    {
        SelectedExpense = exp;
        if (exp != null)
        {
            ModalTitle = "Edit Expense";
            expenses = new List<Expense>
            {
                new Expense
                {
                    Id = exp.Id,
                    Title = exp.Title,
                    Amount = exp.Amount,
                    Category = exp.Category,
                    Date = exp.Date,
                    Description = exp.Description,
                       UploadedFile = exp.UploadedFile
                }
            };
        }
        else
        {
            ModalTitle = "Add Expense";
            expenses = new List<Expense> { new Expense { Id = Guid.NewGuid(), Date = DateTime.Today } };
        }

        IsVisible = true;
        StateHasChanged();
    }

    private void HideModal() => IsVisible = false;

    private void AddRow() => expenses.Add(new Expense { Id = Guid.NewGuid(), Date = commonDate });

    private async Task ConfirmDelete(Expense expense)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this expense?");
        if (confirmed)
        {
            RemoveRow(expense);
        }
    }

    private void RemoveRow(Expense expense)
    {
        if (expenses.Count > 1)
            expenses.Remove(expense);
    }

    private async Task OnFileSelected(Expense expense, InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null)
        {
            // Create unique file name
            var uniqueFileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";

            // Build full path: wwwroot/uploads/ExpenseFiles/<guid>.pdf
            var folderPath = Path.Combine("wwwroot", "uploads", "ExpenseFiles");
            Directory.CreateDirectory(folderPath); // Ensure folder exists

            var uploadPath = Path.Combine(folderPath, uniqueFileName);

            // Save file
            using var stream = new FileStream(uploadPath, FileMode.Create);
            await file.OpenReadStream().CopyToAsync(stream);

            // Store the correct relative path in DB
            expense.UploadedFile = $"uploads/ExpenseFiles/{uniqueFileName}";
        }
    }

    private void RemoveFile(Expense expense)
    {
        if (!string.IsNullOrWhiteSpace(expense.UploadedFile))
        {
            // Convert URLs to local file system paths
            var relativePath = expense.UploadedFile.Replace("/", Path.DirectorySeparatorChar.ToString());

            var physicalPath = Path.Combine("wwwroot", relativePath);

            // Delete file if exists
            if (System.IO.File.Exists(physicalPath))
            {
                System.IO.File.Delete(physicalPath);
            }

            // Update model
            expense.UploadedFile = null;
        }

        StateHasChanged();
    }



    private async Task SaveAll()
    {
        if (isEditMode)
        {
            var exp = expenses.First();
            await ExpenseService.UpdateAsync(exp);
        }
        else
        {
            foreach (var exp in expenses)
            {
                exp.Date = commonDate;
                exp.Description = string.IsNullOrEmpty(exp.Description) ? commonNote : exp.Description;

                if (!string.IsNullOrWhiteSpace(exp.Title) && exp.Amount > 0)
                    await ExpenseService.AddAsync(exp);
            }
        }

        IsVisible = false;
        await OnSaved.InvokeAsync();
    }
}
