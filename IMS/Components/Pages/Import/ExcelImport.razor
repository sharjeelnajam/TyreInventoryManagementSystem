@page "/import"
@using Domain.DTO
@using Domain.Enums
@using Infrastructure.Services
@inject IExcelImportService ExcelImportService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Excel Import</PageTitle>

<div class="container mt-4">
    <div class="p-4 shadow-lg border-0 rounded-3" style="background: white;">
        <h4 class="fw-bold mb-4 pb-2 border-bottom"
            style="background: linear-gradient(90deg,#4b6cb7,#182848); -webkit-background-clip: text; color: transparent;">
            <i class="bi bi-file-earmark-excel me-2"></i> Excel Import
        </h4>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Import Type</label>
                <select @bind="SelectedImportType" class="form-select form-select-lg shadow-sm">
                    <option value="@ExcelImportType.Product">Product</option>
                    <option value="@ExcelImportType.Customer">Customer</option>
                    <option value="@ExcelImportType.SKUProduct">SKU Product</option>
                </select>
                <small class="text-muted">
                    @if (SelectedImportType == ExcelImportType.Product)
                    {
                        <text>Required columns: ProductName, Unit, Thread. Optional: Description, DOT, Brand, Min_Threshold, Type, AverageCostPrice, Quantity</text>
                    }
                    else if (SelectedImportType == ExcelImportType.SKUProduct)
                    {
                        <text>Fixed mapping: A = SKU, B = Name, F = Regular Price</text>
                    }
                    else
                    {
                        <text>Required columns: Name, ListManagementId. Optional: Phone, Address, City, VehicleNumber, CreditLimit, IsActive, Percentage, CustomPrice</text>
                    }
                </small>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-semibold">Excel File (.xlsx, .xls)</label>
                <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls" class="form-control form-control-lg" />
                @if (SelectedFileName != null)
                {
                    <small class="text-success mt-1 d-block"><i class="bi bi-check-circle me-1"></i> @SelectedFileName</small>
                }
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary btn-lg" @onclick="UploadFile" disabled="@(SelectedFile == null || Uploading)">
                @if (Uploading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                else
                {
                    <i class="bi bi-upload me-2"></i>
                }
                Import
            </button>
            <button class="btn btn-outline-secondary btn-lg" @onclick="ClearSelection" disabled="@Uploading">Clear</button>
        </div>

        @if (Result != null)
        {
            <div class="mt-4 p-3 rounded-3 @(Result.Success ? "alert-success" : "alert-warning")">
                <h6 class="fw-bold mb-2">
                    @if (Result.Success)
                    {
                        <i class="bi bi-check-circle-fill me-2 text-success"></i>
                    }
                    else
                    {
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>
                    }
                    @Result.Message
                </h6>
                <p class="mb-0 small">
                    Total rows: <strong>@Result.TotalRows</strong> |
                    Imported: <strong>@Result.ImportedCount</strong> |
                    Errors: <strong>@Result.ErrorCount</strong>
                </p>
                @if (Result.RowErrors?.Any() == true)
                {
                    <div class="mt-3">
                        <button class="btn btn-sm btn-outline-dark" @onclick="() => showRowErrors = !showRowErrors">
                            @(showRowErrors ? "Hide" : "Show") row errors (@Result.RowErrors.Count)
                        </button>
                        @if (showRowErrors)
                        {
                            <div class="table-responsive mt-2 max-height:200px overflow-auto">
                                <table class="table table-sm table-bordered">
                                    <thead><tr><th>Row</th><th>Value</th><th>Error</th></tr></thead>
                                    <tbody>
                                        @foreach (var err in Result.RowErrors)
                                        {
                                            <tr><td>@err.RowNumber</td><td>@err.Value</td><td class="text-danger">@err.Error</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private ExcelImportType SelectedImportType { get; set; } = ExcelImportType.Product;
    private IBrowserFile? SelectedFile { get; set; }
    private string? SelectedFileName { get; set; }
    private bool Uploading { get; set; }
    private ExcelImportResultDto? Result { get; set; }
    private bool showRowErrors;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".xlsx" && ext != ".xls")
        {
            Result = new ExcelImportResultDto { Success = false, Message = "Please select an Excel file (.xlsx or .xls)." };
            return;
        }
        SelectedFile = file;
        SelectedFileName = file.Name;
        Result = null;
    }

    private async Task UploadFile()
    {
        if (SelectedFile == null) return;
        Uploading = true;
        Result = null;
        try
        {
            using var stream = new MemoryStream();
            await SelectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;
            Result = await ExcelImportService.ImportAsync(stream, SelectedImportType);
        }
        catch (Exception ex)
        {
            Result = new ExcelImportResultDto
            {
                Success = false,
                Message = "Import failed: " + ex.Message,
                RowErrors = new List<ExcelImportRowError> { new() { RowNumber = 0, Error = ex.Message } }
            };
        }
        finally
        {
            Uploading = false;
        }
    }

    private void ClearSelection()
    {
        SelectedFile = null;
        SelectedFileName = null;
        Result = null;
        showRowErrors = false;
    }
}
