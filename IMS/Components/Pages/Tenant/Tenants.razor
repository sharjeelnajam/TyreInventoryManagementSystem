@page "/branches"
@attribute [Authorize(Roles = "SuperAdmin")]
@using Domain
@using Infrastructure.Services
@using Microsoft.AspNetCore.Authorization
@inject ITenantService TenantService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Tenants</PageTitle>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0" style="color: #6c757d;">
            Branches
        </h3>
        <button class="btn btn-primary px-3 rounded-pill shadow-sm" @onclick="AddTenant">
            <i class="bi bi-plus-lg me-1"></i> Add Branch
        </button>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <table class="table modern-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Domain</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th class="text-end">Created</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="spinner-border text-primary"></div>
                            </td>
                        </tr>
                    }
                    else if (tenants is null || !tenants.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
                                No branches found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in tenants)
                        {
                            <tr>
                                <td class="fw-semibold">@t.Name</td>
                                <td>@t.Email</td>
                                <td>@t.Domain</td>
                                <td>@t.PhoneNumber</td>
                                <td>@t.City</td>
                                <td class="text-end text-muted small">@t.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light rounded-circle me-2 action-btn"
                                            title="Edit Tenant"
                                            @onclick="() => EditTenant(t.Id)">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light rounded-circle action-btn"
                                            title="Delete Tenant"
                                            @onclick="() => DeleteTenant(t.Id)">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .modern-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
    }

        .modern-table thead {
            background: #f8f9fb;
        }

        .modern-table th {
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.03rem;
            border-bottom: 2px solid #eef1f5 !important;
            padding: 1rem 1.25rem;
            color: #6c757d;
        }

        .modern-table tbody tr {
            background: #fff;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 1px 2px rgba(0,0,0,0.03);
        }

            .modern-table tbody {
                background-color: #f9fafc;
                transform: scale(1.01);
            }

        .modern-table td {
            padding: 1rem 1.25rem;
            border: none;
            font-size: 0.9rem;
        }

    .action-btn {
        border: none;
        transition: background 0.2s ease;
    }

        .action-btn:hover {
            background-color: #e9f1ff;
        }
</style>

@code {
    private List<Tenant> tenants = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        tenants = await TenantService.GetTenantsAsync();
        isLoading = false;
    }

    private void AddTenant()
    {
        Navigation.NavigateTo("/branches/addedit");
        StateHasChanged();
    }

    private void EditTenant(Guid id)
    {
        Navigation.NavigateTo($"/branches/addedit/{id}");
        StateHasChanged();
    }
    

    private async Task DeleteTenant(Guid id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this tenant?"))
        {
            await TenantService.DeleteTenantAsync(id);
            await LoadTenants();
        }
    }
}
