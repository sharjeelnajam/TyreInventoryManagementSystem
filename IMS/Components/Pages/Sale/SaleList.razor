@page "/sales"
@using Domain
@using Infrastructure.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ISaleService SaleService
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
<PageTitle>Sales</PageTitle>

<div class="container mt-4">
    <h3 class="fw-bold mb-2">Sales</h3>

    <div class="sale-list-toolbar">
        <div class="sale-list-toolbar-search">
            <label class="form-label">Invoice #</label>
            <input type="search" class="form-control form-control-sm" @bind="invoiceSearch" @bind:event="oninput" placeholder="Search invoice number..." autocomplete="off" />
        </div>
        <div class="sale-list-toolbar-actions">
            <div class="sale-list-date-compact">
                <label class="form-label">From Date</label>
                <InputDate @bind-Value="fromDate" class="form-control form-control-sm" />
            </div>
            <div class="sale-list-date-compact">
                <label class="form-label">To Date</label>
                <InputDate @bind-Value="toDate" class="form-control form-control-sm" />
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear</button>
            <button type="button" class="btn btn-warning btn-sm fw-bold text-dark" @onclick="RefreshPage">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Table of Sales -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sale #</th>
                <th>Customer</th>
                <th>Total</th>
                <th>Net</th>
                <th>Payment Method</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sale in FilteredSales)
            {
                <tr>
                    <td>
                        @sale.SaleNumber
                        @if (sale.ShopServiceBillId.HasValue)
                        {
                            <span class="badge bg-secondary ms-1" title="From Shop Billing">Shop</span>
                        }
                    </td>
                    <td>@sale.Customer?.Name</td>
                    <td>@sale.TotalAmount</td>
                    <td>@sale.NetAmount</td>
                    <td>@sale.PaymentMethod</td>
                    <td>@sale.SaleDate.ToShortDateString()</td>
                    <td>
                        <span role="button" title="Download Invoice" class="text-success me-2"
                        @onclick="() => DownloadInvoice(sale.Id)">
                            <i class="bi bi-download fs-5"></i>
                        </span>

                        <i class="bi bi-eye text-primary fs-5 ms-2 cursor-pointer"
                           title="View Invoice"
                           @onclick="() => GoToViewSale(sale.Id)"></i>
                        @if (canEditInvoices)
                        {
                            <i class="bi bi-pencil-square text-primary fs-5 ms-2 cursor-pointer"
                               title="Edit Invoice"
                               @onclick="() => GoToEditSale(sale.Id)"></i>
                        }
                        @if (canEditInvoices)
                        {
                            <i class="bi bi-trash text-danger fs-5 ms-2 cursor-pointer"
                               title="Delete Invoice"
                               @onclick="() => DeleteSale(sale.Id)"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Component -->



@code {
    private List<Sale> sales = new();
    private bool canEditInvoices;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string invoiceSearch = string.Empty;

    private IEnumerable<Sale> FilteredSales =>
        sales
            .Where(s => !fromDate.HasValue || s.SaleDate.Date >= fromDate.Value.Date)
            .Where(s => !toDate.HasValue || s.SaleDate.Date <= toDate.Value.Date)
            .Where(s => string.IsNullOrWhiteSpace(invoiceSearch) ||
                        (s.SaleNumber?.Contains(invoiceSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canEditInvoices = authState.User.IsInRole("SuperAdmin");
        sales = (await SaleService.GetAllAsync())
            .OrderByDescending(s => s.SaleDate)
            .ToList();
    }

    // private void OpenAddSale()
    // {
    //     selectedSaleId = Guid.Empty;
    //     isModalOpen = true;
    // }

    private async Task DeleteSale(Guid id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure to delete?");
        if (confirm)
        {
            await SaleService.DeleteAsync(id);
            sales = (await SaleService.GetAllAsync())
                .OrderByDescending(s => s.SaleDate)
                .ToList();
            StateHasChanged();
        }
    }

    // private void EditSale(Guid saleId)
    // {
    //     selectedSaleId = saleId;
    //     isModalOpen = true;
    // }

    // private async Task CloseModal()
    // {
    //     isModalOpen = false;
    //     await Task.Delay(500); // Give time for the save to complete
    //     await ReloadSales();
    // }

    private async Task ReloadSales()
    {
        sales = (await SaleService.GetAllAsync())
            .OrderByDescending(s => s.SaleDate)
            .ToList();
        StateHasChanged();
    }

    private async Task RefreshPage()
    {
        await ReloadSales();
    }

    private void ClearFilters()
    {
        fromDate = null;
        toDate = null;
        invoiceSearch = string.Empty;
    }

    private async Task DownloadInvoice(Guid saleId)
    {
        var sale = await SaleService.GetByIdAsync(saleId);
        if (sale == null)
            return;

        // Full invoice PDF (logo, background, customer, table, footer)
        var pdfBytes = await SaleService.GenerateReceiptPdfAsync(saleId);

        string base64 = Convert.ToBase64String(pdfBytes);
        await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", $"Invoice_{sale.SaleNumber}.pdf", base64);
    }

    private void GoToAddSale()
    {
        Nav.NavigateTo("/sales/add");
    }

    private void GoToViewSale(Guid id)
    {
        Nav.NavigateTo($"/sales/view/{id}");
    }

    private void GoToEditSale(Guid id)
    {
        Nav.NavigateTo($"/sales/edit/{id}");
    }
}