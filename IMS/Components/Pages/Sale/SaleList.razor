@page "/sales"
@using Domain
@using Infrastructure.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject ISaleService SaleService
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer
<PageTitle>Sales</PageTitle>

<div class="container mt-4">
    <div class="sale-list-header">
        <h3 class="fw-bold mb-2">Sales</h3>
    </div>

    <div class="sale-list-toolbar">
        <div class="sale-list-toolbar-search">
            <label class="form-label">Search</label>
            <input type="search" class="form-control form-control-sm" @bind="searchText" @bind:event="oninput" placeholder="Invoice #, customer name, registration..." autocomplete="off" />
        </div>
        <div class="sale-list-toolbar-actions">
            <div class="sale-list-date-compact">
                <label class="form-label">From Date</label>
                <InputDate @bind-Value="fromDate" class="form-control form-control-sm" />
            </div>
            <div class="sale-list-date-compact">
                <label class="form-label">To Date</label>
                <InputDate @bind-Value="toDate" class="form-control form-control-sm" />
            </div>
           
            <div class="sale-list-special-note-toggle">
                <label class="form-label" for="toggleSpecialNoteView">Special note</label>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="toggleSpecialNoteView"
                           checked="@showSpecialNoteOnInvoiceView"
                           @onchange="OnSpecialNoteViewToggleChanged" />
                </div>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear</button>
        </div>
    </div>

    <!-- Table of Sales -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sale #</th>
                <th>Customer</th>
                <th>VehicleNumber</th>
                <th>Net</th>
                <th>Payment Method</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sale in FilteredSales)
            {
                <tr>
                    <td>
                        @sale.SaleNumber
                        @if (sale.ShopServiceBillId.HasValue)
                        {
                            <span class="badge bg-secondary ms-1" title="From Shop Billing">Shop</span>
                        }
                    </td>
                    <td>@(sale.Customer?.Name ?? sale.CustomerName)</td>
                    <td>@(sale.VehicleNumber ?? sale.Customer?.VehicleNumber)</td>
                    <td>@sale.NetAmount</td>
                    <td>@sale.PaymentMethod</td>
                    <td>@sale.SaleDate.ToShortDateString()</td>
                    <td>
                        <span role="button" title="Download Invoice" class="text-success me-2"
                        @onclick="() => DownloadInvoice(sale.Id)">
                            <i class="bi bi-download fs-5"></i>
                        </span>

                        <i class="bi bi-eye text-primary fs-5 ms-2 cursor-pointer"
                           title="View Invoice"
                           @onclick="() => GoToViewSale(sale.Id)"></i>
                        @if (canEditInvoices)
                        {
                            <i class="bi bi-pencil-square text-primary fs-5 ms-2 cursor-pointer"
                               title="Edit Invoice"
                               @onclick="() => GoToEditSale(sale.Id)"></i>
                        }
                        @if (canEditInvoices)
                        {
                            <i class="bi bi-trash text-danger fs-5 ms-2 cursor-pointer"
                               title="Delete Invoice"
                               @onclick="() => DeleteSale(sale.Id)"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Component -->



@code {
    private const string ShowSpecialNoteOnInvoiceViewKey = "ims.sales.showSpecialNoteOnInvoiceView";

    private List<Sale> sales = new();
    private bool canEditInvoices;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string searchText = string.Empty;
    private bool showSpecialNoteOnInvoiceView = true;

    private IEnumerable<Sale> FilteredSales =>
        sales
            .Where(s => !fromDate.HasValue || s.SaleDate.Date >= fromDate.Value.Date)
            .Where(s => !toDate.HasValue || s.SaleDate.Date <= toDate.Value.Date)
            .Where(MatchesSearch);

    private bool MatchesSearch(Sale s)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;
        var q = searchText.Trim();
        return (s.SaleNumber?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.CustomerName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.Customer?.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.VehicleNumber?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            || (s.Customer?.VehicleNumber?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        canEditInvoices = authState.User.IsInRole("SuperAdmin");
        sales = (await SaleService.GetAllAsync())
            .OrderByDescending(s => s.SaleDate)
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ShowSpecialNoteOnInvoiceViewKey);
            if (stored == "false")
                showSpecialNoteOnInvoiceView = false;
            else if (stored == "true")
                showSpecialNoteOnInvoiceView = true;
            StateHasChanged();
        }
        catch
        {
            /* localStorage unavailable (e.g. prerender) */
        }
    }

    private async Task OnSpecialNoteViewToggleChanged(ChangeEventArgs e)
    {
        showSpecialNoteOnInvoiceView = e.Value is bool cb
            ? cb
            : string.Equals(Convert.ToString(e.Value), "true", StringComparison.OrdinalIgnoreCase);
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ShowSpecialNoteOnInvoiceViewKey,
                showSpecialNoteOnInvoiceView ? "true" : "false");
        }
        catch { /* ignore */ }
    }

    // private void OpenAddSale()
    // {
    //     selectedSaleId = Guid.Empty;
    //     isModalOpen = true;
    // }

    private async Task DeleteSale(Guid id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure to delete?");
        if (confirm)
        {
            await SaleService.DeleteAsync(id);
            sales = (await SaleService.GetAllAsync())
                .OrderByDescending(s => s.SaleDate)
                .ToList();
            StateHasChanged();
        }
    }

    // private void EditSale(Guid saleId)
    // {
    //     selectedSaleId = saleId;
    //     isModalOpen = true;
    // }

    // private async Task CloseModal()
    // {
    //     isModalOpen = false;
    //     await Task.Delay(500); // Give time for the save to complete
    //     await ReloadSales();
    // }

    private async Task ReloadSales()
    {
        sales = (await SaleService.GetAllAsync())
            .OrderByDescending(s => s.SaleDate)
            .ToList();
        StateHasChanged();
    }

    private void ClearFilters()
    {
        fromDate = null;
        toDate = null;
        searchText = string.Empty;
    }

    private async Task DownloadInvoice(Guid saleId)
    {
        var sale = await SaleService.GetByIdAsync(saleId);
        if (sale == null)
            return;

        // Full invoice PDF (logo, background, customer, table, footer)
        var pdfBytes = await SaleService.GenerateReceiptPdfAsync(saleId);

        string base64 = Convert.ToBase64String(pdfBytes);
        await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", $"Invoice_{sale.SaleNumber}.pdf", base64);
    }

    private void GoToAddSale()
    {
        Nav.NavigateTo("/sales/add");
    }

    private void GoToViewSale(Guid id)
    {
        Nav.NavigateTo($"/sales/view/{id}");
    }

    private void GoToEditSale(Guid id)
    {
        Nav.NavigateTo($"/sales/edit/{id}");
    }
}