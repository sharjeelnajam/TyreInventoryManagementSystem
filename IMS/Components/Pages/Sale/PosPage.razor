    private async Task DownloadReceipt()
    {
        if (!checkoutSuccessSaleId.HasValue) return;
        receiptLoading = true;
        StateHasChanged();
        try
        {
            var sale = await SaleService.GetByIdAsync(checkoutSuccessSaleId.Value);
            if (sale == null) return;
            await BrowserFileDownload.DownloadPdfFromAuthenticatedUrlAsync(
                JSRuntime, Nav, $"/api/sales/{checkoutSuccessSaleId.Value}/receipt.pdf", $"Receipt_{sale.SaleNumber}.pdf");
        }
        finally
        {
            receiptLoading = false;
            StateHasChanged();
        }
    }
