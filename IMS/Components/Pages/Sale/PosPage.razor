        StateHasChanged();
    }

    private IEnumerable<Customer> GetCheckoutCustomers()
    {
        if (!_checkoutCustomerTypeId.HasValue || _checkoutCustomerTypeId == Guid.Empty)
            return Customers;

        return Customers.Where(c => c.ListManagementId == _checkoutCustomerTypeId);
    }

