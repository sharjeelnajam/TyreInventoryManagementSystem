@page "/pos"
@layout IMS.Components.Layout.PosLayout
@using Domain
@using Domain.DTO
@using Domain.Enums
@using Infrastructure.Services
@using IMS.Services
@using IMS.Components.Pages.Customer
@inject ISaleService SaleService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IListManagementService ListManagementService
@inject IWholesalerPriceService WholesalerPriceService
@inject ApplicationDbContext _context
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IVatSettingsClientService VatSettingsService
@rendermode InteractiveServer

<PageTitle>Point of Sale</PageTitle>

<div class="pos-container">
    <EditForm Model="@Sale" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        
        <!-- Header -->
        <div class="pos-header">
            <div class="d-flex align-items-center gap-3 flex-grow-1 flex-wrap">
                <input class="form-control pos-search-input" 
                       placeholder="Search by name, SKU, size, tread, brand..."
                       @oninput="e => searchText = e.Value?.ToString()" />
            </div>
        </div>

        <div class="pos-body">
            <!-- LEFT PANEL: PRODUCT LIST -->
            <div class="products-panel">
                <div class="product-list">
                    @{
                        var filteredProducts = products
                            .Where(p => string.IsNullOrEmpty(searchText) ||
                                       (p.ProductName != null && p.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.SKU != null && p.SKU.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.Brand != null && p.Brand.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.TyreSize != null && p.TyreSize.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.TreadName != null && p.TreadName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.UnitName != null && p.UnitName.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
                        var displayedProducts = string.IsNullOrEmpty(searchText) ? filteredProducts.Take(6) : filteredProducts;
                    }
                    @foreach (var product in displayedProducts)
                    {
                        var stockLevel = product.Quantity;
                        var isOutOfStock = stockLevel <= 0;
                        
                        <div class="product-row @(isOutOfStock ? "out-of-stock-row" : "")" 
                             @onclick="() => TryAddItem(product, stockLevel)">
                            <!-- Small Thumbnail -->
                            <div class="product-thumb">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.ProductName" />
                                }
                                else
                                {
                                    <div class="no-image-small"><i class="bi bi-image"></i></div>
                                }
                            </div>

                            <!-- Product Details -->
                            <div class="product-details-col">
                                <div class="product-name-row">@product.ProductName</div>
                                @if (!string.IsNullOrWhiteSpace(product.SKU))
                                {
                                    <div class="product-sku-row text-muted small">@product.SKU</div>
                                }
                                <div class="product-stock-row @(isOutOfStock ? "stock-out" : "stock-in")">
                                    @(stockLevel > 0 ? $"{stockLevel} in stock" : "Out of Stock")
                                </div>
                                <div class="product-tags-row">
                                    @if (!string.IsNullOrEmpty(product.TyreSize))
                                    {
                                        <span class="tag">@product.TyreSize</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.UnitName))
                                    {
                                        <span class="tag">@product.UnitName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.TreadName))
                                    {
                                        <span class="tag">@product.TreadName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.Brand))
                                    {
                                        <span class="tag">@product.Brand</span>
                                    }
                                    @if (!string.IsNullOrEmpty(product.Type))
                                    {
                                        <span class="tag">@product.Type</span>
                                    }
                                </div>
                            </div>

                            <!-- Price & Add Button -->
                            <div class="product-price-col">£@product.SellingPrice.ToString("0.00")</div>
                            <button type="button" class="btn-add-small @(isOutOfStock ? "btn-add-disabled" : "")" 
                                    disabled="@isOutOfStock"
                                    @onclick:stopPropagation="true" 
                                    @onclick="() => TryAddItem(product, stockLevel)">
                                <i class="bi bi-plus-circle-fill"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT PANEL: CART (compact) -->
            <div class="cart-panel">
                <!-- Cart Items Header -->
                <div class="cart-header">
                    <div class="cart-col cart-col-qty">QTY</div>
                    <div class="cart-col cart-col-name">NAME</div>
                    <div class="cart-col cart-col-price text-end">PRICE</div>
                    <div class="cart-col cart-col-total text-end">TOTAL</div>
                    <div class="cart-col-action"></div>
                </div>

                <!-- Cart Items -->
                <div class="cart-items">
                    @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                    {
                        @foreach (var detail in Sale.SaleDetails)
                        {
                            <div class="cart-item">
                                <div class="cart-col cart-col-qty">
                                    <InputNumber TValue="int"
                                                 Value="detail.Quantity"
                                                 ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                                 ValueExpression="@(() => detail.Quantity)"
                                                 class="form-control form-control-sm qty-input" />
                                    @if (quantityErrors.ContainsKey(detail.ProductId))
                                    {
                                        <small class="text-danger d-block small">@quantityErrors[detail.ProductId]</small>
                                    }
                                </div>
                                <div class="cart-col cart-col-name">
                                    <div class="item-name" title="@GetProductName(detail.ProductId)">@GetProductName(detail.ProductId)</div>
                                </div>
                                <div class="cart-col cart-col-price text-end">
                                    <InputNumber TValue="decimal"
                                                 Value="detail.UnitPrice"
                                                 ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                                 ValueExpression="@(() => detail.UnitPrice)"
                                                 class="form-control form-control-sm price-input" />
                                </div>
                                <div class="cart-col cart-col-total text-end">
                                    <strong>£@((detail.Quantity * detail.UnitPrice).ToString("0.00"))</strong>
                                </div>
                                <div class="cart-col-action">
                                    <button type="button" class="btn-remove" @onclick="() => RemoveItem(detail)">
                                        <i class="bi bi-x-circle-fill"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-cart">
                            <i class="bi bi-cart-x"></i>
                            <p>No items in cart</p>
                        </div>
                    }
                </div>

                <!-- Totals -->
                <div class="cart-totals">
                    <div class="total-row">
                        <span>Subtotal:</span>
                        <span>£@Sale.TotalAmount.ToString("0.00")</span>
                    </div>
                    
                    @if (CustomerCustomPrice.HasValue || CustomerPercentage.HasValue)
                    {
                        <div class="total-row">
                            <span>Discount:</span>
                            <span>-£@CalculateDiscount().ToString("0.00")</span>
                        </div>
                    }
                    
                    <div class="total-row grand-total">
                        <span>Total:</span>
                        <span>£@CartLevelTotal.ToString("0.00")</span>
                    </div>
                </div>

                <!-- Checkout Button -->
                <div class="checkout-section">
                    <button type="button" class="btn btn-checkout w-100" disabled="@(!isFormValid || Sale.SaleDetails == null || !Sale.SaleDetails.Any())" @onclick="OpenCheckoutModal">
                        <i class="bi bi-cart-check-fill"></i> Checkout
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
</div>

<!-- Customer Details Modal (same as Customers page - used from Checkout Add New) -->
@if (showCustomerModal)
{
    <div class="modal fade show d-block" style="background-color:rgba(0,0,0,0.5); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 800px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Customer Details</h5>
                    <button type="button" class="btn-close" @onclick="CloseCustomerModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <AddCustomer CustomerModel="NewCustomer" OnSaved="OnCustomerSavedFromCheckout" OnCancelled="CloseCustomerModal" />
                </div>
            </div>
        </div>
    </div>
}

<!-- Out of Stock Popup -->
@if (showOutOfStockModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.5rem;"></i>
                    <p class="mt-3 mb-0 fw-semibold">It is out of stock</p>
                    <button type="button" class="btn btn-primary mt-3" @onclick="CloseOutOfStockModal">OK</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Checkout Modal - Full checkout popup -->
@if (showCheckoutModal)
{
    <div class="checkout-modal-backdrop">
        <div class="checkout-modal-box" @onclick:stopPropagation="true">
            @if (checkoutSuccessSaleId.HasValue)
            {
                <div class="checkout-modal-header">
                    <h5 class="checkout-modal-title text-success"><i class="bi bi-check-circle-fill me-2"></i>Payment complete</h5>
                    <button type="button" class="checkout-modal-close" aria-label="Close" @onclick="CloseCheckoutModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="checkout-modal-body">
                    <p class="mb-3">Sale recorded successfully. You can view invoice details or download the receipt PDF.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary" @onclick="ViewInvoiceDetail" disabled="@receiptLoading">
                            <i class="bi bi-eye me-1"></i> View Invoice
                        </button>
                        <button type="button" class="btn btn-outline-success" @onclick="DownloadReceipt" disabled="@receiptLoading">
                            <i class="bi bi-download me-1"></i> Download Receipt
                        </button>
                        @if (receiptLoading)
                        {
                            <span class="align-self-center small text-muted"><span class="spinner-border spinner-border-sm"></span> Preparing…</span>
                        }
                    </div>
                </div>
                <div class="checkout-modal-footer">
                    <button type="button" class="btn btn-checkout-submit" @onclick="CloseCheckoutModal">Done</button>
                </div>
            }
            else
            {
            <div class="checkout-modal-header">
                <h5 class="checkout-modal-title">Checkout Order @Sale.SaleNumber</h5>
                <div class="checkout-amount-block">
                    <span class="checkout-amount-label">Amount to Pay</span>
                    <span class="checkout-amount-value">£@Sale.NetAmount.ToString("0.00")</span>
                </div>
                <button type="button" class="checkout-modal-close" aria-label="Close" @onclick="CloseCheckoutModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="checkout-modal-body">
                <div class="checkout-info-row">
                    <span class="checkout-info-label">Cashier:</span>
                    <span class="checkout-info-value">@cashierName</span>
                </div>

                <div class="checkout-payment-row">
                    <div class="checkout-payment-field">
                        <label class="form-label small mb-1 checkout-heading">Customer Type</label>
                        <InputSelect class="form-select form-select-sm"
                                     TValue="Guid?" @bind-Value="_checkoutCustomerTypeId">
                            <option value="">All</option>
                            @foreach (var t in _customerTypes)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="checkout-payment-field">
                        <label class="form-label small mb-1 checkout-heading">Paying as</label>
                        <InputSelect class="form-select form-select-sm"
                                     TValue="Guid?"
                                     Value="Sale.CustomerId"
                                     ValueChanged="OnCheckoutCustomerChanged"
                                     ValueExpression="@(() => Sale.CustomerId)">
                            <option value="">Guest</option>
                            @foreach (var c in GetCheckoutCustomers())
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="checkout-payment-field d-flex align-items-end">
                        <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1" @onclick="OpenAddCustomer" title="Add new customer">
                            <i class="bi bi-person-plus-fill"></i> Add New
                        </button>
                    </div>
                </div>
                <div class="d-flex justify-content-end mb-2" style="margin-top: -20px;">
                    <button type="button" class="btn btn-sm btn-outline-danger px-4 py-0" @onclick="OpenPosVatSettingsModal">VAT</button>
                </div>
                <div class="checkout-payment-row checkout-payment-row-2 mt-2">
                    <div class="checkout-payment-field">
                        <label class="form-label small mb-1 checkout-heading">Payment Method</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="_checkoutPaymentMethod" @bind-Value:after="OnPaymentMethodChanged">
                            <option value="">Select</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="CardAndCash">Both Card &amp; Cash</option>
                            <option value="BankTransfer">Bank Transfer</option>
                        </InputSelect>
                    </div>
                    <div class="checkout-payment-field">
                        <label class="form-label small mb-1 checkout-heading">Payment Status</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="Sale.PaymentStatus">
                            <option value="">Select</option>
                            <option value="Paid">Paid</option>
                            <option value="Unpaid">Unpaid</option>
                            <option value="Partial">Partial</option>
                        </InputSelect>
                    </div>
                </div>
                @if (_checkoutPaymentMethod == "CardAndCash")
                {
                    <div class="checkout-payment-row mt-2 d-flex flex-wrap gap-3 align-items-end">
                        <div class="checkout-payment-field" style="min-width: 140px;">
                            <label class="form-label small mb-1 checkout-heading">Card Amount (£)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_checkoutCardAmount" @bind-Value:after="OnSplitAmountChanged" />
                        </div>
                        <div class="checkout-payment-field" style="min-width: 140px;">
                            <label class="form-label small mb-1 checkout-heading">Cash Amount (£)</label>
                            <InputNumber class="form-control form-control-sm" @bind-Value="_checkoutCashAmount" @bind-Value:after="OnSplitAmountChanged" />
                        </div>
                        <div class="checkout-payment-field d-flex align-items-center small">
                            @{
                                var splitSum = _checkoutCardAmount + _checkoutCashAmount;
                                var splitValid = Math.Abs(splitSum - Sale.NetAmount) < 0.01m;
                            }
                            <span class="@(splitValid ? "text-success" : "text-danger")">
                                @(splitValid ? $"Card + Cash = £{splitSum:0.00} ✓" : $"Remaining: £{Sale.NetAmount - splitSum:0.00}")
                            </span>
                        </div>
                    </div>
                }

                <div class="checkout-products-section">
                    <div class="checkout-table-header checkout-heading">
                        <span class="checkout-col-product">PRODUCT</span>
                        <span class="checkout-col-qty">QTY</span>
                        <span class="checkout-col-total">TOTAL</span>
                    </div>
                    @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                    {
                        @foreach (var detail in Sale.SaleDetails)
                        {
                            <div class="checkout-table-row">
                                <span class="checkout-col-product">@GetProductName(detail.ProductId)</span>
                                <span class="checkout-col-qty">x @detail.Quantity</span>
                                <span class="checkout-col-total">£@((detail.Quantity * detail.UnitPrice).ToString("0.00"))</span>
                            </div>
                        }
                    }
                </div>

                <div class="checkout-summary-section">
                    <div class="checkout-summary-row">
                        <span class="checkout-heading">Subtotal</span>
                        <span>£@Sale.TotalAmount.ToString("0.00")</span>
                    </div>
                    <div class="checkout-summary-row">
                        <div class="w-100">
                            <label class="form-label small mb-1 checkout-heading">Job description (optional)</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="Sale.JobDescription" placeholder="e.g. tyre fitting, alignment" />
                            <label class="form-label small mb-1 mt-2 checkout-heading">Special Note (optional)</label>
                            <InputTextArea class="form-control form-control-sm" rows="2" @bind-Value="Sale.Notes" />
                        </div>
                    </div>
                    <div class="checkout-summary-row d-flex align-items-center gap-2 flex-wrap">
                        <span class="checkout-heading">Discount (£)</span>
                        <InputNumber @bind-Value="_checkoutExtraDiscount"
                                     @bind-Value:after="OnCheckoutExtraDiscountChanged"
                                     class="form-control form-control-sm w-auto" style="max-width: 6rem;" />
                        <span class="text-success">-£@CalculateDiscount().ToString("0.00")</span>
                    </div>
                    @if (Sale.VatMode != VatMode.ExcludeVat)
                    {
                        <div class="checkout-summary-row">
                            <span class="checkout-heading">VAT Status</span>
                            <span>@GetVatStatusLabel(Sale.VatMode)</span>
                        </div>
                        <div class="checkout-summary-row">
                            <span class="checkout-heading">VAT Value</span>
                            <span>£@Sale.TaxAmount.GetValueOrDefault().ToString("0.00")</span>
                        </div>
                    }
                    <div class="checkout-summary-row checkout-total-row">
                        <span class="checkout-heading">Total</span>
                        <span>£@Sale.NetAmount.ToString("0.00")</span>
                    </div>
                </div>
            </div>

            <div class="checkout-modal-footer">
                <button type="button" class="btn btn-checkout-cancel" @onclick="CloseCheckoutModal">Cancel</button>
                <button type="button" class="btn btn-checkout-submit" disabled="@(!CanProcessCheckout)" @onclick="CompleteCheckout">
                    <i class="bi bi-credit-card-2-front"></i> Process Payment
                </button>
            </div>
            }
        </div>
    </div>
}

@if (showPosVatSettingsModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.45)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">VAT Settings</h5>
                    <button type="button" class="btn-close" @onclick="ClosePosVatSettingsModal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-grid gap-2">
                        <button type="button"
                                class="btn @(selectedPosVatMode == VatMode.PlusVat ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => selectedPosVatMode = VatMode.PlusVat">
                            Plus VAT
                        </button>
                        <button type="button"
                                class="btn @(selectedPosVatMode == VatMode.IncludingVat ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => selectedPosVatMode = VatMode.IncludingVat">
                            Including VAT
                        </button>
                        <button type="button"
                                class="btn @(selectedPosVatMode == VatMode.ExcludeVat ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => selectedPosVatMode = VatMode.ExcludeVat">
                            Exclude VAT
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(posVatSettingsError))
                    {
                        <div class="alert alert-danger py-2 mt-3 mb-0">@posVatSettingsError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="ClosePosVatSettingsModal" disabled="@isSavingPosVatMode">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SavePosVatMode" disabled="@isSavingPosVatMode">
                        @(isSavingPosVatMode ? "Saving..." : "Apply")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Wholesaler Modal -->
@if (showWholesalerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Wholesaler</h5>
                    <button type="button" class="btn-close" @onclick="CloseWholesalerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewWholesalerCustomer" OnValidSubmit="SaveWholesaler">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="NewWholesalerCustomer.Name" />
                                <ValidationMessage For="@(() => NewWholesalerCustomer.Name)" />
                            </div>
                            <div class="col-md-6">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="NewWholesalerCustomer.Email" />
                            </div>
                            <div class="col-md-6">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="NewWholesalerCustomer.Phone" />
                                <ValidationMessage For="@(()=>NewWholesalerCustomer.Phone)" />
                            </div>
                            <div class="col-md-6">
                                <label>Special Note</label>
                                <InputText class="form-control" @bind-Value="NewWholesalerCustomer.SpecialNote" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseWholesalerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool isFormValid = true;
    private Dictionary<Guid, string> quantityErrors = new();
    protected Sale Sale { get; set; } = new();
    protected List<Customer> Customers { get; set; } = new();
    protected List<StockHistory> Stocks = new();
    private List<ProductDto> products = new();
    private string searchText = string.Empty;

    protected bool showCustomerModal = false;
    protected Customer NewCustomer { get; set; } = new();
    protected List<Customer> WholesalerCustomers { get; set; } = new();
    protected bool showWholesalerModal = false;
    protected Customer NewWholesalerCustomer { get; set; } = new();
    private Guid? _wholesalerTypeId;
    private List<ListManagement> _customerTypes = new();
    private bool showOutOfStockModal = false;
    private bool showCheckoutModal = false;
    private bool showPosVatSettingsModal = false;
    private VatMode selectedPosVatMode = VatMode.ExcludeVat;
    private bool isSavingPosVatMode;
    private string? posVatSettingsError;
    private Guid? checkoutSuccessSaleId;
    private bool receiptLoading;
    private string cashierName = "";

    private decimal? CustomerCustomPrice { get; set; }
    private decimal? CustomerPercentage { get; set; }
    private bool EnableCustomPricing { get; set; } = false;
    private bool _isWholesalerMode;
    private List<CustomerSalerPrice> wholeSalerPrices = new List<CustomerSalerPrice>();
    private VatMode _vatMode = VatMode.ExcludeVat;
    private decimal CartLevelTotal => Math.Max((Sale.TotalAmount) - (Sale.Discount ?? 0m), 0m);

    private bool isWholesalerMode
    {
        get => _isWholesalerMode;
        set
        {
            _isWholesalerMode = value;
            Sale.CustomerId = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _vatMode = await VatSettingsService.GetModeAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        cashierName = authState.User.Identity?.Name ?? "—";

        Customers = await CustomerService.GetCustomersAsync();
        var customerTypes = await ListManagementService.GetByTypeAsync(ListType.CustomerType);
        _customerTypes = customerTypes.ToList();
        _wholesalerTypeId = _customerTypes
            .FirstOrDefault(t => t.Name.Contains("whole", StringComparison.OrdinalIgnoreCase))?.Id;
        WholesalerCustomers = _wholesalerTypeId.HasValue
            ? await CustomerService.GetCustomersAsync(typeId: _wholesalerTypeId)
            : new List<Customer>();
        products = await ProductService.GetAllAsync();
        Stocks = _context.StockHistories.ToList();

        Sale = new Sale
        {
            SaleDate = DateTime.Now,
            SaleNumber = await SaleService.GetNextSaleReferencePreviewAsync(),
            SaleDetails = new List<SaleDetail>(),
            Discount = 0,
            TaxAmount = 0,
            VatMode = _vatMode
        };
    }

    private void TryAddItem(ProductDto product, int stockLevel)
    {
        if (stockLevel <= 0)
        {
            showOutOfStockModal = true;
            return;
        }
        AddItemFromGrid(product);
    }

    private void AddItemFromGrid(ProductDto product)
    {
        if (product.Quantity <= 0)
        {
            showOutOfStockModal = true;
            return;
        }

        var existingItem = Sale.SaleDetails.FirstOrDefault(d => d.ProductId == product.Id);
        
        if (existingItem != null)
        {
            OnQuantityChanged(existingItem, existingItem.Quantity + 1);
            return;
        }

        var detail = new SaleDetail
        {
            Id = Guid.NewGuid(),
            ProductId = product.Id,
            Quantity = 1,
            UnitPrice = product.SellingPrice,
            TotalPrice = product.SellingPrice
        };

        Sale.SaleDetails.Add(detail);
        RecalculateTotals();
    }

    private void OpenCheckoutModal()
    {
        if (isFormValid && Sale.SaleDetails != null && Sale.SaleDetails.Any())
        {
            _checkoutPaymentMethod = Sale.PaymentMethod ?? "";
            // Snapshot effective discount before checkout mode (manual field is authoritative while modal is open).
            _checkoutExtraDiscount = CalculateDiscount();
            if (_checkoutPaymentMethod == "CardAndCash")
            {
                _checkoutCardAmount = Sale.CardAmount > 0 ? Sale.CardAmount : Math.Round(Sale.NetAmount / 2, 2);
                _checkoutCashAmount = Sale.CashAmount > 0 ? Sale.CashAmount : (Sale.NetAmount - _checkoutCardAmount);
            }
            else
            {
                _checkoutCardAmount = 0m;
                _checkoutCashAmount = 0m;
            }
            showCheckoutModal = true;
            RecalculateTotals();
            if (_checkoutPaymentMethod == "CardAndCash")
            {
                _checkoutCardAmount = Math.Round(Sale.NetAmount / 2, 2);
                _checkoutCashAmount = Sale.NetAmount - _checkoutCardAmount;
            }
        }
    }

    private async Task CloseCheckoutModal()
    {
        showCheckoutModal = false;
        showPosVatSettingsModal = false;
        posVatSettingsError = null;
        checkoutSuccessSaleId = null;
        await ResetCartForNewSaleAsync();
        StateHasChanged();
    }

    private void OpenPosVatSettingsModal()
    {
        selectedPosVatMode = _vatMode;
        posVatSettingsError = null;
        showPosVatSettingsModal = true;
    }

    private void ClosePosVatSettingsModal()
    {
        showPosVatSettingsModal = false;
        posVatSettingsError = null;
    }

    private async Task SavePosVatMode()
    {
        isSavingPosVatMode = true;
        posVatSettingsError = null;
        try
        {
            await VatSettingsService.SetModeAsync(selectedPosVatMode);
            _vatMode = selectedPosVatMode;
            Sale.VatMode = _vatMode;
            RecalculateTotals();
            if (_checkoutPaymentMethod == "CardAndCash")
            {
                _checkoutCardAmount = Math.Round(Sale.NetAmount / 2, 2);
                _checkoutCashAmount = Sale.NetAmount - _checkoutCardAmount;
            }
            showPosVatSettingsModal = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            posVatSettingsError = ex.Message;
        }
        finally
        {
            isSavingPosVatMode = false;
        }
    }

    private async Task ResetCartForNewSaleAsync()
    {
        Sale = new Sale
        {
            SaleDate = DateTime.Now,
            SaleNumber = await SaleService.GetNextSaleReferencePreviewAsync(),
            SaleDetails = new List<SaleDetail>(),
            Discount = 0,
            TaxAmount = 0,
            VatMode = _vatMode
        };
        _checkoutExtraDiscount = 0m;
        _checkoutCardAmount = 0m;
        _checkoutCashAmount = 0m;
    }

    private void OnCheckoutBillToChanged()
    {
        if (_isWholesalerMode)
        {
            Sale.CustomerId = null;
            CustomerCustomPrice = null;
            CustomerPercentage = null;
            if (Sale.CustomerId.HasValue)
            {
                wholeSalerPrices = _context.CustomerSalerPrices.Where(w => w.CustomerId == Sale.CustomerId).ToList();
                foreach (var detail in Sale.SaleDetails)
                {
                    var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
                    if (product != null)
                    {
                        var wp = wholeSalerPrices.FirstOrDefault(w => w.ThreadId == product.ThreadId && w.UnitId == product.Unit);
                        if (wp != null) { detail.UnitPrice = wp.Price; detail.TotalPrice = detail.Quantity * detail.UnitPrice; }
                    }
                }
            }
        }
        else
        {
            Sale.CustomerId = null;
            wholeSalerPrices.Clear();
        }
        RecalculateTotals();
        StateHasChanged();
    }

    private async Task OnCheckoutCustomerChanged(Guid? value)
    {
        Sale.CustomerId = value;
        var customer = Customers.FirstOrDefault(c => c.Id == value);
        if (customer != null)
        {
            CustomerCustomPrice = customer.CustomPrice;
            CustomerPercentage = customer.Percentage;
        }
        else
        {
            CustomerCustomPrice = null;
            CustomerPercentage = null;
        }

        wholeSalerPrices = (value.HasValue && value.Value != Guid.Empty)
            ? await WholesalerPriceService.GetByCustomerIdAsync(value.Value)
            : new List<CustomerSalerPrice>();
        foreach (var detail in Sale.SaleDetails)
        {
            var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
            if (product == null) continue;
            var wp = wholeSalerPrices.FirstOrDefault(w => w.ThreadId == product.ThreadId && w.UnitId == product.Unit);
            if (wp != null)
            {
                detail.UnitPrice = wp.Price;
                detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            }
        }

        if (showCheckoutModal)
            _checkoutExtraDiscount = CalculateCustomerDiscount();

        RecalculateTotals();
        StateHasChanged();
    }

    private async Task OnCheckoutWholesalerChanged(Guid? value)
    {
        Sale.CustomerId = value;
        wholeSalerPrices = (value.HasValue && value.Value != Guid.Empty)
            ? await WholesalerPriceService.GetByCustomerIdAsync(value.Value)
            : new List<CustomerSalerPrice>();
        foreach (var detail in Sale.SaleDetails)
        {
            var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
            if (product == null) continue;
            var wp = wholeSalerPrices.FirstOrDefault(w => w.ThreadId == product.ThreadId && w.UnitId == product.Unit);
            if (wp != null) { detail.UnitPrice = wp.Price; detail.TotalPrice = detail.Quantity * detail.UnitPrice; }
        }
        RecalculateTotals();
        StateHasChanged();
    }

    private void CloseOutOfStockModal()
    {
        showOutOfStockModal = false;
    }

    private async Task CompleteCheckout()
    {
        if (!CanProcessCheckout) return;

        if (_checkoutPaymentMethod == "CardAndCash")
        {
            Sale.PaymentMethod = "Card & Cash";
            Sale.CardAmount = _checkoutCardAmount;
            Sale.CashAmount = _checkoutCashAmount;
        }
        else
        {
            Sale.PaymentMethod = _checkoutPaymentMethod;
            Sale.CashAmount = _checkoutPaymentMethod == "Cash" ? Sale.NetAmount : 0m;
            Sale.CardAmount = _checkoutPaymentMethod == "Card" ? Sale.NetAmount : 0m;
        }

        var success = await SaleService.AddAsync(Sale);
        if (success)
        {
            // Reload latest stock and product quantities after successful sale
            products = await ProductService.GetAllAsync();

            checkoutSuccessSaleId = Sale.Id;
            StateHasChanged();
        }
        else
        {
            showCheckoutModal = false;
            Nav.NavigateTo("/pos", forceLoad: true);
        }
    }

