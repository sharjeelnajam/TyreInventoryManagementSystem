    protected async Task SaveWholesaler()
    {
        if (NewWholesalerCustomer.Id == Guid.Empty)
            NewWholesalerCustomer.Id = Guid.NewGuid();
        if (NewWholesalerCustomer.ListManagementId == Guid.Empty && _wholesalerTypeId.HasValue)
            NewWholesalerCustomer.ListManagementId = _wholesalerTypeId.Value;
        await CustomerService.AddCustomerAsync(NewWholesalerCustomer);
        WholesalerCustomers = _wholesalerTypeId.HasValue ? await CustomerService.GetCustomersAsync(typeId: _wholesalerTypeId) : new List<Customer>();
        Sale.CustomerId = NewWholesalerCustomer.Id;
        showWholesalerModal = false;
        StateHasChanged();
    }

    private Guid? _checkoutCustomerTypeId { get; set; }
    private decimal _checkoutExtraDiscount { get; set; } = 0m;
    private string _checkoutPaymentMethod { get; set; } = "";
    private decimal _checkoutCardAmount { get; set; } = 0m;
    private decimal _checkoutCashAmount { get; set; } = 0m;

    private bool CanProcessCheckout
    {
        get
        {
            if (string.IsNullOrEmpty(Sale.PaymentMethod))
                return false;
            if (_checkoutPaymentMethod == "CardAndCash")
            {
                var sum = _checkoutCardAmount + _checkoutCashAmount;
                return Math.Abs(sum - Sale.NetAmount) < 0.01m && _checkoutCardAmount >= 0 && _checkoutCashAmount >= 0;
            }
            return true;
        }
    }

    private void OnPaymentMethodChanged()
    {
        Sale.PaymentMethod = _checkoutPaymentMethod;
        if (_checkoutPaymentMethod == "CardAndCash")
        {
            _checkoutCardAmount = Math.Round(Sale.NetAmount / 2, 2);
            _checkoutCashAmount = Sale.NetAmount - _checkoutCardAmount;
        }
        else
        {
            _checkoutCardAmount = 0m;
            _checkoutCashAmount = 0m;
        }
        StateHasChanged();
    }

