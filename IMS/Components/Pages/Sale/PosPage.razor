    {
        await SaleService.AddAsync(Sale);
        Nav.NavigateTo("/pos", forceLoad: true);
    }

    private void RemoveItem(SaleDetail item)
    {
        Sale.SaleDetails.Remove(item);
        if (quantityErrors.ContainsKey(item.ProductId))
            quantityErrors.Remove(item.ProductId);
        isFormValid = !quantityErrors.Any();
        RecalculateTotals();
    }

    private string GetProductName(Guid productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product != null ? $"{product.ProductName}" : "Unknown";
    }

    private string GetCustomerName()
    {
        if (Sale.CustomerId.HasValue)
        {
            var customer = isWholesalerMode
                ? WholesalerCustomers.FirstOrDefault(c => c.Id == Sale.CustomerId)
                : Customers.FirstOrDefault(c => c.Id == Sale.CustomerId);
            return customer?.Name ?? "Guest";
        }
        return "Guest";
    }

    private void OnQuantityChanged(SaleDetail detail, int newValue)
    {
        detail.Quantity = newValue;
        var maxStock = products.FirstOrDefault(p => p.Id == detail.ProductId)?.Quantity ?? 0;

        if (maxStock <= 0)
        {
            quantityErrors[detail.ProductId] = $"No stock available";
            isFormValid = false;
            return;
        }

        if (newValue > maxStock)
        {
            quantityErrors[detail.ProductId] = $"Max: {maxStock}";
            isFormValid = false;
        }
        else
        {
            if (quantityErrors.ContainsKey(detail.ProductId))
                quantityErrors.Remove(detail.ProductId);
            detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            isFormValid = !quantityErrors.Any();
        }

        RecalculateTotals();
    }

    private async Task OnCustomerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.CustomerId = value;
        var customer = Customers.FirstOrDefault(c => c.Id == value);

        if (customer != null)
        {
            CustomerCustomPrice = customer.CustomPrice;
            CustomerPercentage = customer.Percentage;
        }
        RecalculateTotals();
    }

    private async Task OnWholeSalerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.CustomerId = value;
        wholeSalerPrices = _context.CustomerSalerPrices.Where(w => w.CustomerId == Sale.CustomerId).ToList();

        foreach (var detail in Sale.SaleDetails)
        {
            if (detail.ProductId == Guid.Empty)
                continue;

            var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
            if (product == null)
                continue;

            var wholesalerPrice = wholeSalerPrices.FirstOrDefault(w =>
                w.ThreadId == product.ThreadId &&
                w.UnitId == product.Unit
            );

            if (wholesalerPrice != null)
            {
                detail.UnitPrice = wholesalerPrice.Price;
                detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            }
        }

        RecalculateTotals();
        StateHasChanged();
    }

    private void OnUnitPriceChanged(SaleDetail detail, decimal newValue)
    {
        detail.UnitPrice = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void OnBillToChanged(bool value)
    {
        isWholesalerMode = value;

        if (value)
        {
            Sale.CustomerId = null;
            CustomerCustomPrice = null;
            CustomerPercentage = null;
        }
        else
        {
            Sale.CustomerId = null;
            wholeSalerPrices.Clear();
        }

        Sale.SaleDetails = new List<SaleDetail>();
        quantityErrors.Clear();
        Sale.TotalAmount = 0;
        Sale.NetAmount = 0;
        Sale.Discount = 0;
        Sale.TaxAmount = 0;
        isFormValid = true;
        StateHasChanged();
    }

    private static string GetVatStatusLabel(VatMode mode) => mode switch
    {
        VatMode.PlusVat => "Plus VAT",
        VatMode.IncludingVat => "Including VAT",
        _ => "Exclude VAT"
    };

    private decimal CalculateCustomerDiscount()
    {
        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        decimal discount = 0;

        if (CustomerCustomPrice.HasValue && (!CustomerPercentage.HasValue || CustomerPercentage == 0))
        {
            discount = CustomerCustomPrice.Value;
        }
        else if (!CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
        {
            discount = total * (CustomerPercentage.Value / 100);
        }
        else if (CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
        {
            var percentageAmount = total * (CustomerPercentage.Value / 100);
            discount = CustomerCustomPrice.Value + percentageAmount;
        }

        return Math.Clamp(discount, 0m, total);
    }

    private decimal CalculateDiscount()
    {
        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        // During checkout the input is the authoritative total discount (includes customer custom £ / percentage).
        if (showCheckoutModal)
            return Math.Clamp(_checkoutExtraDiscount, 0m, total);

        if (_checkoutExtraDiscount > 0m)
            return Math.Clamp(_checkoutExtraDiscount, 0m, total);

        return CalculateCustomerDiscount();
    }

    private void RecalculateTotals()
    {
        if (Sale.SaleDetails == null || !Sale.SaleDetails.Any())
        {
            Sale.TotalAmount = 0;
            Sale.NetAmount = 0;
            Sale.Discount = 0;
            Sale.TaxAmount = 0;
            return;
        }

        var subtotal = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        var discount = CalculateDiscount();
        var vat = VatCalculator.Calculate(subtotal, discount, _vatMode);

        Sale.TotalAmount = vat.Subtotal;
        Sale.Discount = vat.Discount;
        Sale.TaxAmount = vat.VatAmount;
        Sale.NetAmount = vat.NetAmount;
        Sale.VatMode = _vatMode;
    }

    private void OnCheckoutExtraDiscountChanged()
    {
        RecalculateTotals();
        StateHasChanged();
    }

