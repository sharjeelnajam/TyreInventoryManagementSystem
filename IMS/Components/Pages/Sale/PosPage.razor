@page "/pos"
@layout IMS.Components.Layout.PosLayout
@using Domain
@using Domain.DTO
@using Domain.Enums
@using Infrastructure.Services
@inject ISaleService SaleService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IWholesalerService WholesalerService
@inject IListManagementService ListManagementService
@inject ApplicationDbContext _context
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer

<PageTitle>Point of Sale</PageTitle>

<div class="pos-container">
    <EditForm Model="@Sale" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        
        <!-- Header -->
        <div class="pos-header">
            <div class="d-flex align-items-center gap-3">
                <input class="form-control" 
                       placeholder="Search by name, size, brand..."
                       style="max-width: 400px;"
                       @oninput="e => searchText = e.Value?.ToString()" />
            </div>
        </div>

        <div class="pos-body">
            <!-- LEFT PANEL: PRODUCT LIST -->
            <div class="products-panel">
                <div class="product-list">
                    @{
                        var filteredProducts = products
                            .Where(p => string.IsNullOrEmpty(searchText) ||
                                       (p.ProductName != null && p.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.Brand != null && p.Brand.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                                       (p.TyreSize != null && p.TyreSize.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
                        var displayedProducts = string.IsNullOrEmpty(searchText) ? filteredProducts.Take(6) : filteredProducts;
                    }
                    @foreach (var product in displayedProducts)
                    {
                        var stock = Stocks.FirstOrDefault(s => s.ProductId == product.Id);
                        var stockLevel = stock?.NewStockLevel ?? 0;
                        var isOutOfStock = stockLevel <= 0;
                        
                        <div class="product-row @(isOutOfStock ? "out-of-stock-row" : "")" 
                             @onclick="() => TryAddItem(product, stockLevel)">
                            <!-- Small Thumbnail -->
                            <div class="product-thumb">
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.ProductName" />
                                }
                                else
                                {
                                    <div class="no-image-small"><i class="bi bi-image"></i></div>
                                }
                            </div>

                            <!-- Product Details -->
                            <div class="product-details-col">
                                <div class="product-name-row">@product.ProductName</div>
                                <div class="product-stock-row @(isOutOfStock ? "stock-out" : "stock-in")">
                                    @(stockLevel > 0 ? $"{stockLevel} in stock" : "Out of Stock")
                                </div>
                                <div class="product-tags-row">
                                    @if (!string.IsNullOrEmpty(product.TyreSize))
                                    { <span class="tag">@product.TyreSize</span> }
                                    @if (!string.IsNullOrEmpty(product.Brand))
                                    { <span class="tag">@product.Brand</span> }
                                    @if (!string.IsNullOrEmpty(product.Type))
                                    { <span class="tag">@product.Type</span> }
                                </div>
                            </div>

                            <!-- Price & Add Button -->
                            <div class="product-price-col">£@product.SellingPrice.ToString("0.00")</div>
                            <button type="button" class="btn-add-small @(isOutOfStock ? "btn-add-disabled" : "")" 
                                    disabled="@isOutOfStock"
                                    @onclick:stopPropagation="true" 
                                    @onclick="() => TryAddItem(product, stockLevel)">
                                <i class="bi bi-plus-circle-fill"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT PANEL: CART (compact) -->
            <div class="cart-panel">
                <!-- Cart Items Header -->
                <div class="cart-header">
                    <div class="cart-col cart-col-qty">QTY</div>
                    <div class="cart-col cart-col-name">NAME</div>
                    <div class="cart-col cart-col-price text-end">PRICE</div>
                    <div class="cart-col cart-col-total text-end">TOTAL</div>
                    <div class="cart-col-action"></div>
                </div>

                <!-- Cart Items -->
                <div class="cart-items">
                    @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                    {
                        @foreach (var detail in Sale.SaleDetails)
                        {
                            <div class="cart-item">
                                <div class="cart-col cart-col-qty">
                                    <InputNumber TValue="int"
                                                 Value="detail.Quantity"
                                                 ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                                 ValueExpression="@(() => detail.Quantity)"
                                                 class="form-control form-control-sm qty-input" />
                                    @if (quantityErrors.ContainsKey(detail.ProductId))
                                    {
                                        <small class="text-danger d-block small">@quantityErrors[detail.ProductId]</small>
                                    }
                                </div>
                                <div class="cart-col cart-col-name">
                                    <div class="item-name" title="@GetProductName(detail.ProductId)">@GetProductName(detail.ProductId)</div>
                                </div>
                                <div class="cart-col cart-col-price text-end">
                                    <InputNumber TValue="decimal"
                                                 Value="detail.UnitPrice"
                                                 ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                                 ValueExpression="@(() => detail.UnitPrice)"
                                                 class="form-control form-control-sm price-input" />
                                </div>
                                <div class="cart-col cart-col-total text-end">
                                    <strong>£@((detail.Quantity * detail.UnitPrice).ToString("0.00"))</strong>
                                </div>
                                <div class="cart-col-action">
                                    <button type="button" class="btn-remove" @onclick="() => RemoveItem(detail)">
                                        <i class="bi bi-x-circle-fill"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-cart">
                            <i class="bi bi-cart-x"></i>
                            <p>No items in cart</p>
                        </div>
                    }
                </div>

                <!-- Totals -->
                <div class="cart-totals">
                    <div class="total-row">
                        <span>Subtotal:</span>
                        <span>£@Sale.TotalAmount.ToString("0.00")</span>
                    </div>
                    
                    @if (CustomerCustomPrice.HasValue || CustomerPercentage.HasValue)
                    {
                        <div class="total-row">
                            <span>Discount:</span>
                            <span>-£@CalculateDiscount().ToString("0.00")</span>
                        </div>
                    }
                    
                    @if (Sale.TaxAmount.HasValue && Sale.TaxAmount > 0)
                    {
                        <div class="total-row">
                            <span>Tax (@Sale.TaxAmount%):</span>
                            <span>£@((Sale.TotalAmount * (Sale.TaxAmount.Value / 100)).ToString("0.00"))</span>
                        </div>
                    }
                    
                    <div class="total-row grand-total">
                        <span>Total:</span>
                        <span>£@Sale.NetAmount.ToString("0.00")</span>
                    </div>
                </div>

                <!-- Checkout Button -->
                <div class="checkout-section">
                    <button type="button" class="btn btn-checkout w-100" disabled="@(!isFormValid || Sale.SaleDetails == null || !Sale.SaleDetails.Any())" @onclick="OpenCheckoutModal">
                        <i class="bi bi-cart-check-fill"></i> Checkout
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
</div>

<!-- Customer Modal -->
@if (showCustomerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Customer</h5>
                    <button type="button" class="btn-close" @onclick="CloseCustomerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewCustomer" OnValidSubmit="SaveCustomer">
                        <DataAnnotationsValidator />
                        
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox @bind-Value="EnableCustomPricing" class="form-check-input" />
                            <label class="form-check-label fw-semibold">Enable Custom Pricing</label>
                        </div>

                        <div class="mb-3">
                            <label>Name</label>
                            <InputText class="form-control" @bind-Value="NewCustomer.Name" />
                            <ValidationMessage For="@(()=>NewCustomer.Name)" />
                        </div>
                        
                        <div class="mb-3">
                            <label>Phone</label>
                            <InputText class="form-control" @bind-Value="NewCustomer.Phone" />
                            <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                        </div>
                        
                        @if (EnableCustomPricing)
                        {
                            <div class="mb-3">
                                <label>Percentage (%)</label>
                                <InputNumber @bind-Value="NewCustomer.Percentage" class="form-control" />
                                <ValidationMessage For="@(() => NewCustomer.Percentage)" />
                            </div>
                            <div class="mb-3">
                                <label>Custom Price</label>
                                <InputNumber @bind-Value="NewCustomer.CustomPrice" class="form-control" />
                                <ValidationMessage For="@(() => NewCustomer.CustomPrice)" />
                            </div>
                        }

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseCustomerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Out of Stock Popup -->
@if (showOutOfStockModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2.5rem;"></i>
                    <p class="mt-3 mb-0 fw-semibold">It is out of stock</p>
                    <button type="button" class="btn btn-primary mt-3" @onclick="CloseOutOfStockModal">OK</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Checkout Modal - Full checkout popup -->
@if (showCheckoutModal)
{
    <div class="checkout-modal-backdrop" @onclick="CloseCheckoutModal">
        <div class="checkout-modal-box" @onclick:stopPropagation="true">
            <div class="checkout-modal-header">
                <h5 class="checkout-modal-title">Checkout Order @Sale.SaleNumber</h5>
                <div class="checkout-amount-block">
                    <span class="checkout-amount-label">Amount to Pay</span>
                    <span class="checkout-amount-value">£@Sale.NetAmount.ToString("0.00")</span>
                </div>
                <button type="button" class="checkout-modal-close" aria-label="Close" @onclick="CloseCheckoutModal">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="checkout-modal-body">
                <div class="checkout-info-row">
                    <span class="checkout-info-label">Cashier:</span>
                    <span class="checkout-info-value">@cashierName</span>
                </div>

                <div class="form-check form-switch mb-2">
                    <InputCheckbox class="form-check-input" id="checkout-bill-wholesaler" @bind-Value="_isWholesalerMode" @onchange="OnCheckoutBillToChanged" />
                    <label class="form-check-label" for="checkout-bill-wholesaler">Bill to Wholesaler</label>
                </div>

                <div class="checkout-payment-row">
                    <div class="checkout-payment-field">
                        <label class="form-label small text-muted mb-1">Paying as</label>
                        @if (isWholesalerMode)
                        {
                            <InputSelect class="form-select form-select-sm"
                                         TValue="Guid?"
                                         Value="Sale.WholesalerId"
                                         ValueChanged="OnCheckoutWholesalerChanged"
                                         ValueExpression="@(() => Sale.WholesalerId)">
                                <option value="">Guest</option>
                                @foreach (var w in Wholesalers)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </InputSelect>
                        }
                        else
                        {
                            <InputSelect class="form-select form-select-sm"
                                         TValue="Guid?"
                                         Value="Sale.CustomerId"
                                         ValueChanged="OnCheckoutCustomerChanged"
                                         ValueExpression="@(() => Sale.CustomerId)">
                                <option value="">Guest</option>
                                @foreach (var c in Customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </InputSelect>
                        }
                    </div>
                    <div class="checkout-payment-field">
                        <label class="form-label small text-muted mb-1">Payment Method</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="Sale.PaymentMethod">
                            <option value="">Select</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="BankTransfer">Bank Transfer</option>
                        </InputSelect>
                    </div>
                    <div class="checkout-payment-field">
                        <label class="form-label small text-muted mb-1">Payment Status</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="Sale.PaymentStatus">
                            <option value="">Select</option>
                            <option value="Paid">Paid</option>
                            <option value="Unpaid">Unpaid</option>
                            <option value="Partial">Partial</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="checkout-products-section">
                    <div class="checkout-table-header">
                        <span class="checkout-col-product">PRODUCT</span>
                        <span class="checkout-col-qty">QTY</span>
                        <span class="checkout-col-total">TOTAL</span>
                    </div>
                    @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                    {
                        @foreach (var detail in Sale.SaleDetails)
                        {
                            <div class="checkout-table-row">
                                <span class="checkout-col-product">@GetProductName(detail.ProductId)</span>
                                <span class="checkout-col-qty">x @detail.Quantity</span>
                                <span class="checkout-col-total">£@((detail.Quantity * detail.UnitPrice).ToString("0.00"))</span>
                            </div>
                        }
                    }
                </div>

                <div class="checkout-summary-section">
                    <div class="checkout-summary-row">
                        <span>Subtotal</span>
                        <span>£@Sale.TotalAmount.ToString("0.00")</span>
                    </div>
                    @if (CalculateDiscount() > 0)
                    {
                        <div class="checkout-summary-row">
                            <span>Discount</span>
                            <span class="text-success">-£@CalculateDiscount().ToString("0.00")</span>
                        </div>
                    }
                    @if (Sale.TaxAmount.HasValue && Sale.TaxAmount > 0)
                    {
                        <div class="checkout-summary-row">
                            <span>Tax (@Sale.TaxAmount%)</span>
                            <span>£@((Sale.TotalAmount * (Sale.TaxAmount.Value / 100)).ToString("0.00"))</span>
                        </div>
                    }
                    <div class="checkout-summary-row checkout-total-row">
                        <span>Total</span>
                        <span>£@Sale.NetAmount.ToString("0.00")</span>
                    </div>
                </div>
            </div>

            <div class="checkout-modal-footer">
                <button type="button" class="btn btn-checkout-cancel" @onclick="CloseCheckoutModal">Cancel</button>
                <button type="button" class="btn btn-checkout-submit" @onclick="CompleteCheckout">
                    <i class="bi bi-credit-card-2-front"></i> Process Payment
                </button>
            </div>
        </div>
    </div>
}

<!-- Wholesaler Modal -->
@if (showWholesalerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Wholesaler</h5>
                    <button type="button" class="btn-close" @onclick="CloseWholesalerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewWholesaler" OnValidSubmit="SaveWholesaler">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Name" />
                                <ValidationMessage For="@(() => NewWholesaler.Name)" />
                            </div>
                            <div class="col-md-6">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Email" />
                            </div>
                            <div class="col-md-6">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Phone" />
                                <ValidationMessage For="@(()=>NewWholesaler.Phone)" />
                            </div>
                            <div class="col-md-6">
                                <label>Address</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Address" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseWholesalerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    bool isFormValid = true;
    private Dictionary<Guid, string> quantityErrors = new();
    protected Sale Sale { get; set; } = new();
    protected List<Customer> Customers { get; set; } = new();
    protected List<StockHistory> Stocks = new();
    private List<ProductDto> products = new();
    private string searchText = string.Empty;

    protected bool showCustomerModal = false;
    protected Customer NewCustomer { get; set; } = new();
    protected List<Wholesaler> Wholesalers { get; set; } = new();
    protected bool showWholesalerModal = false;
    protected Wholesaler NewWholesaler { get; set; } = new();
    private bool showOutOfStockModal = false;
    private bool showCheckoutModal = false;
    private string cashierName = "";

    private decimal? CustomerCustomPrice { get; set; }
    private decimal? CustomerPercentage { get; set; }
    private bool EnableCustomPricing { get; set; } = false;
    private bool _isWholesalerMode;
    private List<WholeSalerPrice> wholeSalerPrices = new List<WholeSalerPrice>();

    private bool isWholesalerMode
    {
        get => _isWholesalerMode;
        set
        {
            _isWholesalerMode = value;
            if (value)
                Sale.CustomerId = Guid.Empty;
            else
                Sale.WholesalerId = Guid.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        cashierName = authState.User.Identity?.Name ?? "—";

        Customers = await CustomerService.GetCustomersAsync();
        products = await ProductService.GetAllAsync();
        Stocks = _context.StockHistories.ToList();
        Wholesalers = await WholesalerService.GetAllAsync();

        Sale = new Sale
        {
            SaleDate = DateTime.Now,
            SaleNumber = $"SO-{DateTime.Now:yyyyMMddHHmmss}",
            SaleDetails = new List<SaleDetail>(),
            Discount = 0,
            TaxAmount = 0
        };
    }

    private void TryAddItem(ProductDto product, int stockLevel)
    {
        if (stockLevel <= 0)
        {
            showOutOfStockModal = true;
            return;
        }
        AddItemFromGrid(product);
    }

    private void AddItemFromGrid(ProductDto product)
    {
        var stock = Stocks.FirstOrDefault(s => s.ProductId == product.Id);
        if (stock == null || stock.NewStockLevel <= 0)
        {
            showOutOfStockModal = true;
            return;
        }

        var existingItem = Sale.SaleDetails.FirstOrDefault(d => d.ProductId == product.Id);
        
        if (existingItem != null)
        {
            OnQuantityChanged(existingItem, existingItem.Quantity + 1);
            return;
        }

        var detail = new SaleDetail
        {
            Id = Guid.NewGuid(),
            ProductId = product.Id,
            Quantity = 1,
            UnitPrice = product.SellingPrice,
            TotalPrice = product.SellingPrice
        };

        Sale.SaleDetails.Add(detail);
        RecalculateTotals();
    }

    private void OpenCheckoutModal()
    {
        if (isFormValid && Sale.SaleDetails != null && Sale.SaleDetails.Any())
            showCheckoutModal = true;
    }

    private void CloseCheckoutModal()
    {
        showCheckoutModal = false;
        StateHasChanged();
    }

    private void OnCheckoutBillToChanged()
    {
        if (_isWholesalerMode)
        {
            Sale.CustomerId = null;
            CustomerCustomPrice = null;
            CustomerPercentage = null;
            if (Sale.WholesalerId.HasValue)
            {
                wholeSalerPrices = _context.WholeSalerPrices.Where(w => w.WholesalerId == Sale.WholesalerId).ToList();
                foreach (var detail in Sale.SaleDetails)
                {
                    var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
                    if (product != null)
                    {
                        var wp = wholeSalerPrices.FirstOrDefault(w => w.ThreadId == product.ThreadId && w.UnitId == product.Unit);
                        if (wp != null) { detail.UnitPrice = wp.Price; detail.TotalPrice = detail.Quantity * detail.UnitPrice; }
                    }
                }
            }
        }
        else
        {
            Sale.WholesalerId = null;
            wholeSalerPrices.Clear();
        }
        RecalculateTotals();
        StateHasChanged();
    }

    private Task OnCheckoutCustomerChanged(Guid? value)
    {
        Sale.CustomerId = value;
        var customer = Customers.FirstOrDefault(c => c.Id == value);
        if (customer != null)
        {
            CustomerCustomPrice = customer.CustomPrice;
            CustomerPercentage = customer.Percentage;
        }
        else
        {
            CustomerCustomPrice = null;
            CustomerPercentage = null;
        }
        RecalculateTotals();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnCheckoutWholesalerChanged(Guid? value)
    {
        Sale.WholesalerId = value;
        wholeSalerPrices = value.HasValue ? _context.WholeSalerPrices.Where(w => w.WholesalerId == value).ToList() : new List<WholeSalerPrice>();
        foreach (var detail in Sale.SaleDetails)
        {
            var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
            if (product == null) continue;
            var wp = wholeSalerPrices.FirstOrDefault(w => w.ThreadId == product.ThreadId && w.UnitId == product.Unit);
            if (wp != null) { detail.UnitPrice = wp.Price; detail.TotalPrice = detail.Quantity * detail.UnitPrice; }
        }
        RecalculateTotals();
        StateHasChanged();
    }

    private void CloseOutOfStockModal()
    {
        showOutOfStockModal = false;
    }

    private async Task CompleteCheckout()
    {
        showCheckoutModal = false;
        await HandleValidSubmit();
    }

    protected async Task HandleValidSubmit()
    {
        await SaleService.AddAsync(Sale);
        Nav.NavigateTo("/pos", forceLoad: true);
    }

    private void RemoveItem(SaleDetail item)
    {
        Sale.SaleDetails.Remove(item);
        if (quantityErrors.ContainsKey(item.ProductId))
            quantityErrors.Remove(item.ProductId);
        isFormValid = !quantityErrors.Any();
        RecalculateTotals();
    }

    private string GetProductName(Guid productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product != null ? $"{product.ProductName}" : "Unknown";
    }

    private string GetCustomerName()
    {
        if (Sale.CustomerId.HasValue)
        {
            var customer = Customers.FirstOrDefault(c => c.Id == Sale.CustomerId);
            return customer?.Name ?? "Guest";
        }
        if (Sale.WholesalerId.HasValue)
        {
            var wholesaler = Wholesalers.FirstOrDefault(w => w.Id == Sale.WholesalerId);
            return wholesaler?.Name ?? "Guest";
        }
        return "Guest";
    }

    private void OnQuantityChanged(SaleDetail detail, int newValue)
    {
        detail.Quantity = newValue;
        var stockProduct = Stocks.FirstOrDefault(p => p.ProductId == detail.ProductId);

        if (stockProduct == null)
        {
            quantityErrors[detail.ProductId] = $"No stock available";
            isFormValid = false;
            return;
        }

        if (newValue > stockProduct.NewStockLevel)
        {
            quantityErrors[detail.ProductId] = $"Max: {stockProduct.NewStockLevel}";
            isFormValid = false;
        }
        else
        {
            if (quantityErrors.ContainsKey(detail.ProductId))
                quantityErrors.Remove(detail.ProductId);
            detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            isFormValid = !quantityErrors.Any();
        }

        RecalculateTotals();
    }

    private async Task OnCustomerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.CustomerId = value;
        var customer = Customers.FirstOrDefault(c => c.Id == value);

        if (customer != null)
        {
            CustomerCustomPrice = customer.CustomPrice;
            CustomerPercentage = customer.Percentage;
        }
        RecalculateTotals();
    }

    private async Task OnWholeSalerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.WholesalerId = value;
        wholeSalerPrices = _context.WholeSalerPrices.Where(w => w.WholesalerId == Sale.WholesalerId).ToList();

        foreach (var detail in Sale.SaleDetails)
        {
            if (detail.ProductId == Guid.Empty)
                continue;

            var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
            if (product == null)
                continue;

            var wholesalerPrice = wholeSalerPrices.FirstOrDefault(w =>
                w.ThreadId == product.ThreadId &&
                w.UnitId == product.Unit
            );

            if (wholesalerPrice != null)
            {
                detail.UnitPrice = wholesalerPrice.Price;
                detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            }
        }

        RecalculateTotals();
        StateHasChanged();
    }

    private void OnUnitPriceChanged(SaleDetail detail, decimal newValue)
    {
        detail.UnitPrice = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void OnBillToChanged(bool value)
    {
        isWholesalerMode = value;

        if (value)
        {
            Sale.CustomerId = Guid.Empty;
            CustomerCustomPrice = null;
            CustomerPercentage = null;
        }
        else
        {
            Sale.WholesalerId = Guid.Empty;
            wholeSalerPrices.Clear();
        }

        Sale.SaleDetails = new List<SaleDetail>();
        quantityErrors.Clear();
        Sale.TotalAmount = 0;
        Sale.NetAmount = 0;
        Sale.Discount = 0;
        Sale.TaxAmount = 0;
        isFormValid = true;
        StateHasChanged();
    }

    private decimal CalculateDiscount()
    {
        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        decimal discount = 0;

        if (CustomerCustomPrice.HasValue && (!CustomerPercentage.HasValue || CustomerPercentage == 0))
        {
            discount = CustomerCustomPrice.Value;
        }
        else if (!CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
        {
            discount = total * (CustomerPercentage.Value / 100);
        }
        else if (CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
        {
            var percentageAmount = total * (CustomerPercentage.Value / 100);
            discount = CustomerCustomPrice.Value + percentageAmount;
        }

        return discount;
    }

    private void RecalculateTotals()
    {
        if (Sale.SaleDetails == null || !Sale.SaleDetails.Any())
        {
            Sale.TotalAmount = 0;
            Sale.NetAmount = 0;
            return;
        }

        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        Sale.TotalAmount = total;

        decimal discount = CalculateDiscount();
        Sale.NetAmount = total - discount;

        if (Sale.TaxAmount.HasValue && Sale.TaxAmount > 0)
        {
            Sale.NetAmount += Sale.TotalAmount * (Sale.TaxAmount.Value / 100);
        }

        if (Sale.NetAmount < 0)
            Sale.NetAmount = 0;
    }

    protected void OpenAddCustomer()
    {
        NewCustomer = new Customer();
        showCustomerModal = true;
        EnableCustomPricing = NewCustomer.Percentage.HasValue || NewCustomer.CustomPrice.HasValue;
    }

    protected async Task SaveCustomer()
    {
        await CustomerService.AddCustomerAsync(NewCustomer);
        Customers = await CustomerService.GetCustomersAsync();
        Sale.CustomerId = NewCustomer.Id;
        if (NewCustomer.CustomPrice.HasValue || NewCustomer.Percentage.HasValue)
        {
            CustomerCustomPrice = NewCustomer.CustomPrice;
            CustomerPercentage = NewCustomer.Percentage;
        }
        showCustomerModal = false;
        StateHasChanged();
    }

    protected void CloseCustomerModal()
    {
        showCustomerModal = false;
    }

    protected void OpenAddWholesaler()
    {
        NewWholesaler = new Wholesaler();
        showWholesalerModal = true;
    }

    protected async Task SaveWholesaler()
    {
        if (NewWholesaler.Id == Guid.Empty)
            NewWholesaler.Id = Guid.NewGuid();

        await WholesalerService.AddAsync(NewWholesaler);
        Wholesalers = await WholesalerService.GetAllAsync();
        Sale.WholesalerId = NewWholesaler.Id;
        showWholesalerModal = false;
        StateHasChanged();
    }

    protected void CloseWholesalerModal()
    {
        showWholesalerModal = false;
    }
}
