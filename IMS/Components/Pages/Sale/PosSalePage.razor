@page "/sales/add"
@page "/sales/edit/{Id:guid}"

@using Domain
@using Domain.DTO
@using Domain.Enums
@using Infrastructure.Services
@inject ISaleService SaleService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IWholesalerService WholesalerService
@inject IListManagementService ListManagementService
@inject ApplicationDbContext _context
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold">
        @(Id == Guid.Empty ? "POS" : "Edit POS")
    </h3>
    
</div>


<div class="container-fluid mt-4" style="height: calc(100vh - 120px); overflow: auto;">
    <EditForm Model="@Sale" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="row g-0" style="height: 100%;">

            <!-- LEFT PANEL : PRODUCTS -->
            <div class="col-md-7 border-end d-flex flex-column" style="height: 100%;">
                <div class="p-3 flex-shrink-0">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold mb-0">Products</h5>
                        <input class="form-control form-control-sm"
                               placeholder="Search product..."
                               style="width: 200px;"
                               @oninput="e => searchText = e.Value?.ToString()" />
                    </div>
                </div>

                <div class="flex-grow-1 p-3 pt-0">
                    <div class="row g-1" style="font-size: 0.85rem;">
                        @foreach (var product in products
                        .Where(p =>
                        string.IsNullOrEmpty(searchText) ||
                        p.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                        p.Brand.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="col-md-3 p-1">
                                <div class="product-card"
                                     @onclick="() => AddItemFromGrid(product)">

                                    <!-- IMAGE -->
                                    <div class="product-image">
                                        <img src="@(!string.IsNullOrEmpty(product.ImagePath) ? product.ImagePath : "/images/no-image.png")"
                                             alt="@product.ProductName" />
                                    </div>

                                    <!-- DETAILS -->
                                    <div class="product-details">
                                        <div class="product-name">
                                            @product.ProductName
                                        </div>

                                        <div class="product-meta">
                                            @product.Brand • @product.TyreSize
                                        </div>

                                        <div class="product-price">
                                            Rs @product.SellingPrice
                                        </div>
                                    </div>

                                </div>
                            </div>

                        }
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL : SALE -->
            <div class="col-md-5 d-flex flex-column" style="height: 100%; overflow-y: auto;">
                <div class="p-3">

                    <!-- SALE META INFO -->
                    <div class="row g-2">

                        <div class="col-md-6">
                            <InputText class="form-control form-control-sm"
                                       @bind-Value="Sale.SaleNumber"
                                       placeholder="Sale No"
                                       readonly />
                        </div>

                        <div class="col-md-6">
                            <InputDate class="form-control form-control-sm"
                                       @bind-Value="Sale.SaleDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Payment Method</label>
                            <InputSelect class="form-control form-control-sm" @bind-Value="Sale.PaymentMethod">
                                <option value="">-- Select Method --</option>
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="BankTransfer">Bank Transfer</option>
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold mb-1">Payment Status</label>
                            <InputSelect @bind-Value="Sale.PaymentStatus" class="form-control form-control-sm">
                                <option value="">-- Select Payment Status --</option>
                                <option value="Paid">Paid</option>
                                <option value="Unpaid">Unpaid</option>
                                <option value="Partial">Partial</option>
                            </InputSelect>
                        </div>

                        <!-- BILL TO SWITCH -->
                        <div class="col-md-12 mt-1">
                            <div class="form-check form-switch">
                                <InputCheckbox class="form-check-input"
                                               @bind-Value="isWholesalerMode"
                                               @onchange="e => OnBillToChanged(isWholesalerMode)" />
                                <label class="form-check-label small fw-semibold ms-2">
                                    Bill To Wholesaler
                                </label>
                            </div>
                        </div>

                        <!-- CUSTOMER -->
                        @if (!isWholesalerMode)
                        {
                            <div class="col-md-10">
                                <label class="form-label small fw-semibold mb-1">Customer</label>
                                <InputSelect class="form-control form-control-sm"
                                             TValue="Guid?"
                                             Value="Sale.CustomerId"
                                             ValueChanged="OnCustomerChanged"
                                             ValueExpression="@(() => Sale.CustomerId)">
                                    <option value="">-- Select Customer --</option>

                                    @foreach (var customer in Customers)
                                    {
                                        <option value="@customer.Id">@customer.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm px-2 py-1"
                                        style="font-size: 0.75rem; min-width: auto;"
                                        @onclick="OpenAddCustomer">
                                    +
                                </button>
                            </div>
                        }

                        <!-- WHOLESALER -->
                        @if (isWholesalerMode)
                        {
                            <div class="col-md-10">
                                <label class="form-label small fw-semibold mb-1">Wholesaler</label>
                                <InputSelect class="form-control form-control-sm"
                                             TValue="Guid?"
                                             Value="Sale.WholesalerId"
                                             ValueChanged="OnWholeSalerChanged"
                                             ValueExpression="@(() => Sale.WholesalerId)">
                                    <option value="">-- Select Wholesaler --</option>

                                    @foreach (var w in Wholesalers)
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button"
                                        class="btn btn-outline-primary btn-sm px-2 py-1"
                                        style="font-size: 0.75rem; min-width: auto;"
                                        @onclick="OpenAddWholesaler">
                                    +
                                </button>
                            </div>
                        }

                    </div>

                    <hr />

                    <!-- SELECTED ITEMS -->
                    <h6 class="fw-bold small mb-2">Sale Items</h6>

                    <table class="table table-sm" style="font-size: 0.875rem;">
                        <thead>
                            <tr>
                                <th class="small">Product</th>
                                <th class="small">Qty</th>
                                <th class="small">Price</th>
                                <th class="small">Total</th>
                                <th class="small"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                            {
                                @foreach (var detail in Sale.SaleDetails)
                                {
                                    <tr>
                                        <td class="small">@GetProductName(detail.ProductId)</td>
                                        <td>
                                            <InputNumber TValue="int"
                                                         Value="detail.Quantity"
                                                         ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                                         ValueExpression="@(() => detail.Quantity)"
                                                         class="form-control form-control-sm" />

                                            @if (quantityErrors.ContainsKey(detail.ProductId))
                                            {
                                                <div class="text-danger small mt-1">
                                                    @quantityErrors[detail.ProductId]
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <InputNumber TValue="decimal"
                                                         Value="detail.UnitPrice"
                                                         ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                                         ValueExpression="@(() => detail.UnitPrice)"
                                                         class="form-control form-control-sm" />
                                        </td>
                                        <td class="fw-semibold small">
                                            @((detail.Quantity * detail.UnitPrice).ToString("N2"))
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-danger py-0 px-2"
                                                    style="font-size: 0.75rem;"
                                                    @onclick="() => RemoveItem(detail)">
                                                ×
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    <!-- Add Item Button -->
                    @*    <button type="button" class="btn btn-secondary mt-2" @onclick="AddItem"
                                            disabled="@(!isFormValid)" style="opacity:@(isFormValid ? "1" : "0.6")">
                                        + Add Item
                                    </button> *@

                    <!-- DISCOUNT AND TAX SECTION -->
                    @if (CustomerCustomPrice.HasValue || CustomerPercentage.HasValue || ShowOldDiscountField)
                    {
                        <div class="row mt-3 border-top pt-2">
                            <div class="col-md-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-center">

                                            @if (ShowOldDiscountField)
                                            {
                                                <div class="col-md-4">
                                                    <label class="small fw-semibold mb-1">Discount</label>
                                                    <InputNumber TValue="decimal?"
                                                                 Value="Sale.Discount"
                                                                 ValueChanged="OnDiscountChanged"
                                                                 ValueExpression="@(() => Sale.Discount)"
                                                                 class="form-control form-control-sm" />
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="small fw-semibold mb-1">Tax (%)</label>
                                                    <InputNumber TValue="decimal?"
                                                                 Value="Sale.TaxAmount"
                                                                 ValueChanged="OnTaxChanged"
                                                                 ValueExpression="@(() => Sale.TaxAmount)"
                                                                 class="form-control form-control-sm" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-md-3">
                                                    <label class="small fw-semibold mb-1">Customer Custom Price</label>
                                                    <InputNumber @bind-Value="CustomerCustomPrice" class="form-control form-control-sm" />
                                                </div>

                                                <div class="col-md-3">
                                                    <label class="small fw-semibold mb-1">Customer Percentage (%)</label>
                                                    <InputNumber @bind-Value="CustomerPercentage" class="form-control form-control-sm" />
                                                </div>

                                                <div class="col-md-2">
                                                    <label class="small fw-semibold mb-1">Tax (%)</label>
                                                    <InputNumber TValue="decimal?"
                                                                 Value="Sale.TaxAmount"
                                                                 ValueChanged="OnTaxChanged"
                                                                 ValueExpression="@(() => Sale.TaxAmount)"
                                                                 class="form-control form-control-sm" />
                                                </div>
                                            }

                                            <div class="col-md-2 text-end">
                                                <label class="form-label small fw-semibold mb-0">Total</label>
                                                <div class="fw-bold fs-6">@Sale.TotalAmount.ToString("N2")</div>
                                            </div>

                                            <div class="col-md-2 text-end">
                                                <label class="form-label small fw-semibold mb-0">Net</label>
                                                <div class="fw-bold fs-6">@Sale.NetAmount.ToString("N2")</div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- SIMPLE TOTALS DISPLAY -->
                        <div class="row mt-3 border-top pt-2">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Total</label>
                                <div class="fw-bold fs-6">@Sale.TotalAmount.ToString("N2")</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Net</label>
                                <div class="fw-bold fs-6">@Sale.NetAmount.ToString("N2")</div>
                            </div>
                        </div>
                    }

                    <!-- SAVE BUTTON -->
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(!isFormValid)" style="opacity:@(isFormValid ? "1" : "0.6")">
                            Save
                        </button>
                        <button class="btn btn-secondary btn-sm" @onclick="GoBack">
                            Back
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </EditForm>
</div>
<!-- Add Customer Popup -->
@if (showCustomerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Customer</h5>
                    <button type="button" class="btn-close" @onclick="CloseCustomerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewCustomer" OnValidSubmit="SaveCustomer">
                        <DataAnnotationsValidator />
                        <div class="row g-3">

                            <div class="col-md-12 mt-3">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="EnableCustomPricing"
                                                   class="form-check-input" />
                                    <label class="form-check-label fw-semibold ms-2">
                                        Enable Custom Pricing
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Name" />
                                <ValidationMessage For="@(()=>NewCustomer.Name)" />
                            </div>
                            <div class="mb-3">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Phone" />
                                <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                            </div>
                            @if (EnableCustomPricing)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Percentage (%)</label>
                                    <InputNumber @bind-Value="NewCustomer.Percentage"
                                                 class="form-control form-control-lg shadow-sm" />
                                    <ValidationMessage For="@(() => NewCustomer.Percentage)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Custom Price</label>
                                    <InputNumber @bind-Value="NewCustomer.CustomPrice"
                                                 class="form-control form-control-lg shadow-sm" />
                                    <ValidationMessage For="@(() => NewCustomer.CustomPrice)" />
                                </div>
                            }

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <button type="button" class="btn btn-secondary" @onclick="CloseCustomerModal">Cancel</button>
                             
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Wholesaler Popup -->
@if (showWholesalerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Wholesaler</h5>
                    <button type="button" class="btn-close" @onclick="CloseWholesalerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewWholesaler" OnValidSubmit="SaveWholesaler">
                        <DataAnnotationsValidator />
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Name" />
                                <ValidationMessage For="@(() => NewWholesaler.Name)" />
                            </div>

                            <div class="col-md-6">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Email" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Phone" />
                                <ValidationMessage For="@(()=>NewWholesaler.Phone)" />
                            </div>

                            <div class="col-md-6">
                                <label>Address</label>
                                <InputText class="form-control" @bind-Value="NewWholesaler.Address" />
                            </div>

                        </div>



                        <div class="mb-3 col-md-4">
                            <label>Type</label>
                            <InputSelect class="form-select" @bind-Value="NewWholesaler.ListManagementId">
                                @foreach (var t in listManagements)
                                {
                                    <option value="@t.Id">@t</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseWholesalerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    int availableStock;
    bool showError;
    bool isFormValid = true;
    private Dictionary<Guid, string> quantityErrors = new();
    protected Sale Sale { get; set; } = new();
    protected List<Customer> Customers { get; set; } = new();
    protected List<StockHistory> Stocks = new();
    private List<ProductDto> products = new();

    // Searchable dropdown state
    private string searchText = string.Empty;
    private Dictionary<Guid, bool> dropdownStates = new();
    private Dictionary<Guid, string> searchTexts = new();

    protected bool showCustomerModal = false;
    protected Customer NewCustomer { get; set; } = new();

    protected List<Wholesaler> Wholesalers { get; set; } = new();
    protected bool showWholesalerModal = false;
    protected Wholesaler NewWholesaler { get; set; } = new();

    private decimal? CustomerCustomPrice { get; set; }
    private decimal? CustomerPercentage { get; set; }
    private bool ShowOldDiscountField = true;
    private bool EnableCustomPricing { get; set; } = false;
    private List<ListManagement> listManagements = new List<ListManagement>();
    private List<WholeSalerPrice> wholeSalerPrices = new List<WholeSalerPrice>();

    protected override async Task OnParametersSetAsync()
    {
      
            Customers = await CustomerService.GetCustomersAsync();
            products = await ProductService.GetAllAsync();
            Stocks = _context.StockHistories.ToList();
            listManagements = await ListManagementService.GetByTypeAsync(ListType.Expense);
            Wholesalers = await WholesalerService.GetAllAsync();

            if (Id != Guid.Empty)
            {
                Sale = await SaleService.GetByIdAsync(Id);
                Sale.Discount ??= 0;
                Sale.TaxAmount ??= 0;

                // Initialize dropdown states for existing items
                if (Sale.SaleDetails != null)
                {
                    foreach (var detail in Sale.SaleDetails)
                    {
                        dropdownStates[detail.Id] = false;
                        searchTexts[detail.Id] = "";
                    }
                }
            }
            else
            {
                Sale = new Sale
                    {
                        SaleDate = DateTime.Now,
                        SaleNumber = $"SO-{DateTime.Now:yyyyMMddHHmmss}",
                        SaleDetails = new List<SaleDetail>(),
                        Discount = 0,
                        TaxAmount = 0
                    };
            }
        
    }

    protected async Task HandleValidSubmit()
    {
        if (Id == Guid.Empty)
            await SaleService.AddAsync(Sale);
        else
            await SaleService.UpdateAsync(Sale);

        Nav.NavigateTo("/sales");
    }


    // protected async Task HandleValidSubmit()
    // {
    //     try
    //     {
    //         foreach (var s in Sale.SaleDetails)
    //         {
    //             s.SaleId = Sale.Id;
    //         }

    //         if (Id == Guid.Empty)
    //         {
    //             await SaleService.AddAsync(Sale);
    //             products = await ProductService.GetAllAsync();
    //         }
    //         else
    //         {
    //             await SaleService.UpdateAsync(Sale);
    //         }

    //         await OnClose.InvokeAsync();
    //         IsVisible = false;
    //     }
    //     catch (Exception)
    //     {
    //         throw;
    //     }
    //     finally
    //     {
    //         StateHasChanged();
    //     }
    // }

    private void AddItemFromGrid(ProductDto product)
    {
        var detail = new SaleDetail
            {
                Id = Guid.NewGuid()
            };

        Sale.SaleDetails.Add(detail);
        SelectProduct(detail, product);
    }

    protected void Close()
    {
        //OnClose.InvokeAsync();
        ShowOldDiscountField = true;
    }

    protected void AddItem()
    {
        var newDetail = new SaleDetail
            {
                Id = Guid.NewGuid(),
                Quantity = 0,
                UnitPrice = 0,
                TotalPrice = 0
            };

        Sale.SaleDetails.Add(newDetail);
        dropdownStates[newDetail.Id] = false;
        searchTexts[newDetail.Id] = "";
    }

    protected void RemoveItem(SaleDetail item)
    {
        Sale.SaleDetails.Remove(item);
        if (quantityErrors.ContainsKey(item.ProductId))
            quantityErrors.Remove(item.ProductId);

        dropdownStates.Remove(item.Id);
        searchTexts.Remove(item.Id);

        isFormValid = !quantityErrors.Any();
        RecalculateTotals();
    }

    private void SelectProduct(SaleDetail detail, ProductDto product)
    {
        var previousProductId = detail.ProductId;
        detail.ProductId = product.Id;

        var stockProduct = _context.PurchaseDetails
            .Where(p => p.ProductId == product.Id)
            .OrderByDescending(p => p.CreatedAt)
            .FirstOrDefault();

        if (wholeSalerPrices.Any() && isWholesalerMode)
        {
            var wholeSalerPrice = wholeSalerPrices.FirstOrDefault(w => w.UnitId == product.Unit && w.ThreadId == product.ThreadId);
            if (wholeSalerPrice != null)
            {
                detail.Quantity = 1;
                detail.UnitPrice = wholeSalerPrice.Price;
                detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            }
        }
        else if (previousProductId != product.Id)
        {
            detail.Quantity = 1;
            detail.UnitPrice = stockProduct?.SellingPrice ?? 0;
            detail.TotalPrice = detail.Quantity * detail.UnitPrice;

            if (quantityErrors.ContainsKey(previousProductId))
                quantityErrors.Remove(previousProductId);
        }

        searchTexts[detail.Id] = $"{product.ProductName} {product.Brand} {product.TyreSize}";
        dropdownStates[detail.Id] = false;

        RecalculateTotals();
        StateHasChanged();
    }

    private string GetProductName(Guid productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product != null ? $"{product.ProductName} - {product.Brand} - {product.TyreSize}" : "Unknown";
    }

    private void OnDiscountChanged(decimal? newValue)
    {
        Sale.Discount = newValue ?? 0;
        RecalculateTotals();
    }

    private void OnTaxChanged(decimal? value)
    {
        Sale.TaxAmount = value ?? 0;
        RecalculateTotals();
    }

    private void OnQuantityChanged(SaleDetail detail, int newValue)
    {
        detail.Quantity = newValue;

        var existingValue = _context.SaleDetail.FirstOrDefault(s => s.ProductId == detail.ProductId);

        if (Id != Guid.Empty && existingValue != null)
        {
            if (newValue > existingValue.Quantity)
            {
                newValue = newValue - existingValue.Quantity;
            }
            else if (newValue < existingValue.Quantity)
            {
                newValue = existingValue.Quantity - newValue;
            }
        }

        var stockProduct = Stocks.FirstOrDefault(p => p.ProductId == detail.ProductId);

        if (stockProduct == null)
        {
            quantityErrors[detail.ProductId] = $"No available stock for this product. Please purchase first.";
            isFormValid = false;
            return;
        }

        if (newValue > stockProduct.NewStockLevel)
        {
            quantityErrors[detail.ProductId] = $"Quantity exceeds available stock: {stockProduct.NewStockLevel}";
            isFormValid = false;
        }
        else
        {
            if (quantityErrors.ContainsKey(detail.ProductId))
                quantityErrors.Remove(detail.ProductId);

            detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            isFormValid = !quantityErrors.Any();
        }

        RecalculateTotals();
    }

    private async Task OnCustomerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.CustomerId = value;
        var customer = Customers.FirstOrDefault(c => c.Id == value);

        if (customer != null)
        {
            if (customer.CustomPrice.HasValue || customer.Percentage.HasValue)
            {
                CustomerCustomPrice = customer.CustomPrice;
                CustomerPercentage = customer.Percentage;
                ShowOldDiscountField = false;
            }
            else
            {
                ShowOldDiscountField = true;
            }
        }
        RecalculateTotals();
    }

    private async Task OnWholeSalerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.WholesalerId = value;
        wholeSalerPrices = _context.WholeSalerPrices.Where(w => w.WholesalerId == Sale.WholesalerId).ToList();

        foreach (var detail in Sale.SaleDetails)
        {
            if (detail.ProductId == Guid.Empty)
                continue;

            var product = products.FirstOrDefault(p => p.Id == detail.ProductId);
            if (product == null)
                continue;

            var wholesalerPrice = wholeSalerPrices.FirstOrDefault(w =>
                w.ThreadId == product.ThreadId &&
                w.UnitId == product.Unit
            );

            if (wholesalerPrice != null)
            {
                detail.UnitPrice = wholesalerPrice.Price;
                detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            }
        }

        RecalculateTotals();
        StateHasChanged();
    }

    private void OnUnitPriceChanged(SaleDetail detail, decimal newValue)
    {
        detail.UnitPrice = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void OnBillToChanged(bool value)
    {
        isWholesalerMode = value;
        ShowOldDiscountField = true;

        if (value)
        {
            Sale.CustomerId = Guid.Empty;
            CustomerCustomPrice = null;
            CustomerPercentage = null;
        }
        else
        {
            Sale.WholesalerId = Guid.Empty;
            wholeSalerPrices.Clear();
        }

        // Reset sale items completely
        Sale.SaleDetails = new List<SaleDetail>();
        quantityErrors.Clear();
        dropdownStates.Clear();
        searchTexts.Clear();

        // Reset totals
        Sale.TotalAmount = 0;
        Sale.NetAmount = 0;
        Sale.Discount = 0;
        Sale.TaxAmount = 0;

        isFormValid = true;
        StateHasChanged();
    }

    private void RecalculateTotals()
    {
        if (Sale.SaleDetails == null || !Sale.SaleDetails.Any())
        {
            Sale.TotalAmount = 0;
            Sale.NetAmount = 0;
            return;
        }

        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        Sale.TotalAmount = total > 0 ? total - (Sale.Discount ?? 0) : 0;

        if (!ShowOldDiscountField)
        {
            decimal discount = 0;

            // Rule 1 – Only CustomPrice
            if (CustomerCustomPrice.HasValue && (!CustomerPercentage.HasValue || CustomerPercentage == 0))
            {
                discount = CustomerCustomPrice.Value;
            }
            // Rule 2 – Only Percentage
            else if (!CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
            {
                discount = total * (CustomerPercentage.Value / 100);
            }
            // Rule 3 – Both values
            else if (CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
            {
                var percentageAmount = total * (CustomerPercentage.Value / 100);
                discount = CustomerCustomPrice.Value + percentageAmount;
            }

            Sale.NetAmount = total - discount;

            if (Sale.NetAmount < 0)
                Sale.NetAmount = 0;
        }
        else
        {
            Sale.NetAmount = total > 0 ? total - (Sale.Discount ?? 0) + (Sale.TaxAmount ?? 0) : 0;
        }
    }

    private bool isWholesalerMode
    {
        get => _isWholesalerMode;
        set
        {
            _isWholesalerMode = value;

            if (value)
            {
                Sale.CustomerId = Guid.Empty;
            }
            else
            {
                Sale.WholesalerId = Guid.Empty;
            }
        }
    }
    private bool _isWholesalerMode;

    // Customer popup methods
    protected void OpenAddCustomer()
    {
        NewCustomer = new Customer();
        showCustomerModal = true;
        EnableCustomPricing = NewCustomer.Percentage.HasValue || NewCustomer.CustomPrice.HasValue;
    }

    protected async Task SaveCustomer()
    {
        await CustomerService.AddCustomerAsync(NewCustomer);
        Customers = await CustomerService.GetCustomersAsync();
        Sale.CustomerId = NewCustomer.Id;
        if (NewCustomer.CustomPrice.HasValue || NewCustomer.Percentage.HasValue)
        {
            ShowOldDiscountField = false;
        }
        showCustomerModal = false;
    }

    protected void CloseCustomerModal()
    {
        showCustomerModal = false;
    }

    // Wholesaler popup methods
    protected void OpenAddWholesaler()
    {
        NewWholesaler = new Wholesaler();
        showWholesalerModal = true;
    }

    protected async Task SaveWholesaler()
    {
        if (NewWholesaler.Id == Guid.Empty)
            NewWholesaler.Id = Guid.NewGuid();

        await WholesalerService.AddAsync(NewWholesaler);
        Wholesalers = await WholesalerService.GetAllAsync();
        Sale.WholesalerId = NewWholesaler.Id;
        showWholesalerModal = false;
        StateHasChanged();
    }

    protected void CloseWholesalerModal()
    {
        showWholesalerModal = false;
    }
    void GoBack()
    {
        Nav.NavigateTo("/sales");
    }
}