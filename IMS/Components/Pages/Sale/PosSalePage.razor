@page "/template"
@page "/template/{Id:guid}/{IsVisible:bool}"
@using Domain
@using Domain.DTO
@using Domain.Enums
@using Infrastructure.Services
@inject ISaleService SaleService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IWholesalerService WholesalerService
@inject IListManagementService ListManagementService
@inject ApplicationDbContext _context
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((Id == Guid.Empty ? "Add Sale" : "Edit Sale"))</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body p-0">
                    <EditForm Model="@Sale" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row g-0" style="min-height:70vh">

                            <!-- LEFT PANEL : PRODUCTS -->
                            <div class="col-md-7 border-end">
                                <div class="p-3">

                                    <h5 class="fw-bold mb-3">Products</h5>

                                    <div class="col-md-3">
                                        <input class="form-control mb-3"
                                        placeholder="Search product..."
                                        @oninput="e => searchText = e.Value?.ToString()" />
                                    </div>

                                    <div class="row g-1" style="max-height:50vh; overflow-y:auto">
                                        @foreach (var product in products
                                    .Where(p =>
                                    string.IsNullOrEmpty(searchText) ||
                                    p.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                                    p.Brand.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <div class="col-md-3 p-1">
                                                <div class="product-card"
                                                @onclick="() => AddItemFromGrid(product)">

                                                    <!-- IMAGE -->
                                                    <div class="product-image">
                                                        <img src="@(!string.IsNullOrEmpty(product.ImagePath) ? product.ImagePath : "/images/no-image.png")"
                                                        alt="@product.ProductName" />
                                                    </div>

                                                    <!-- DETAILS -->
                                                    <div class="product-details">
                                                        <div class="product-name">
                                                            @product.ProductName
                                                        </div>

                                                        <div class="product-meta">
                                                            @product.Brand • @product.TyreSize
                                                        </div>

                                                        <div class="product-price">
                                                            Rs @product.SellingPrice
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>

                                        }
                                    </div>

                                </div>
                            </div>

                            <!-- RIGHT PANEL : SALE -->
                            <div class="col-md-5">
                                <div class="p-3">

                                    <!-- SALE META INFO -->
                                    <div class="row g-2">

                                        <div class="col-md-6">
                                            <label class="form-label">Sale No</label>
                                            <InputText class="form-control"
                                            @bind-Value="Sale.SaleNumber"
                                            readonly />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">Date</label>
                                            <InputDate class="form-control"
                                            @bind-Value="Sale.SaleDate" />
                                        </div>

                                        <div class="col-md-6">
                                            <label>Payment Method</label>
                                            <InputSelect class="form-control" @bind-Value="Sale.PaymentMethod">
                                                <option value="">-- Select Method --</option>
                                                <option value="Cash">Cash</option>
                                                <option value="Card">Card</option>
                                                <option value="BankTransfer">Bank Transfer</option>
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-6">
                                            <label>Payment Status</label>
                                            <InputSelect @bind-Value="Sale.PaymentStatus" class="form-control">
                                                <option value="">-- Select Payment Status --</option>
                                                <option value="Paid">Paid</option>
                                                <option value="Unpaid">Unpaid</option>
                                                <option value="Partial">Partial</option>
                                            </InputSelect>
                                        </div>

                                        <!-- BILL TO SWITCH -->
                                        <div class="col-md-12 mt-2">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input"
                                                @bind-Value="isWholesalerMode"
                                                @onchange="e => OnBillToChanged(isWholesalerMode)" />
                                                <label class="form-check-label fw-semibold ms-2">
                                                    Bill To Wholesaler
                                                </label>
                                            </div>
                                        </div>

                                        <!-- CUSTOMER -->
                                        @if (!isWholesalerMode)
                                        {
                                            <div class="col-md-10">
                                                <label class="form-label">Customer</label>
                                                <InputSelect class="form-select"
                                                @bind-Value="Sale.CustomerId"
                                                @onchange="e => OnCustomerChanged(Guid.Parse(e.Value.ToString()))">
                                                    <option value="">Select Customer</option>
                                                    @foreach (var c in Customers)
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                            <div class="col-md-2 d-flex align-items-end">
                                                <button type="button"
                                                class="btn btn-outline-primary w-100"
                                                @onclick="OpenAddCustomer">
                                                    +
                                                </button>
                                            </div>
                                        }

                                        <!-- WHOLESALER -->
                                        @if (isWholesalerMode)
                                        {
                                            <div class="col-md-10">
                                                <label class="form-label">Wholesaler</label>
                                                <InputSelect class="form-select"
                                                @bind-Value="Sale.WholesalerId"
                                                @onchange="e => OnWholeSalerChanged(Guid.Parse(e.Value.ToString()))">
                                                    <option value="">Select Wholesaler</option>
                                                    @foreach (var w in Wholesalers)
                                                    {
                                                        <option value="@w.Id">@w.Name</option>
                                                    }
                                                </InputSelect>
                                            </div>
                                            <div class="col-md-2 d-flex align-items-end">
                                                <button type="button"
                                                class="btn btn-outline-primary w-100"
                                                @onclick="OpenAddWholesaler">
                                                    +
                                                </button>
                                            </div>
                                        }

                                    </div>


                                    <hr />

                                    <!-- SELECTED ITEMS -->
                                    <h6 class="fw-bold">Sale Items</h6>

                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th>Qty</th>
                                                <th>Price</th>
                                                <th>Total</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                                            {
                                                @foreach (var detail in Sale.SaleDetails)
                                                {
                                                    <tr>
                                                        <td>@GetProductName(detail.ProductId)</td>
                                                        <td>
                                                            <InputNumber TValue="int"
                                                            Value="detail.Quantity"
                                                            ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                                            ValueExpression="@(() => detail.Quantity)"
                                                            class="form-control" />

                                                            @if (quantityErrors.ContainsKey(detail.ProductId))
                                                            {
                                                                <div class="text-danger small mt-1">
                                                                    @quantityErrors[detail.ProductId]
                                                                </div>
                                                            }
                                                        </td>
                                                        <td>
                                                            <InputNumber TValue="decimal"
                                                            Value="detail.UnitPrice"
                                                            ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                                            ValueExpression="@(() => detail.UnitPrice)"
                                                            class="form-control" />
                                                        </td>
                                                        <td class="fw-semibold">
                                                            @(detail.Quantity * detail.UnitPrice)
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-danger"
                                                            @onclick="() => RemoveItem(detail)">
                                                                ×
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>

                                    <hr />

                                    <!-- TOTALS -->
                                    <div class="d-flex justify-content-between">
                                        <span>Total</span>
                                        <strong>@Sale.TotalAmount:N2</strong>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Net</span>
                                        <strong>@Sale.NetAmount:N2</strong>
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <button type="submit"
                                        class="btn btn-success w-40 mt-3"
                                        disabled="@(!isFormValid)">
                                            Save
                                        </button>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </EditForm>
                </div>


            </div>
        </div>
    </div>


}

<!-- Add Customer Popup -->
@if (showCustomerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Customer</h5>
                    <button type="button" class="btn-close" @onclick="CloseCustomerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewCustomer" OnValidSubmit="SaveCustomer">
                        <DataAnnotationsValidator />
                        <div class="row g-3">

                            <div class="col-md-12 mt-3">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="EnableCustomPricing"
                                    class="form-check-input" />
                                    <label class="form-check-label fw-semibold ms-2">
                                        Enable Custom Pricing
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Name" />
                                <ValidationMessage For="@(()=>NewCustomer.Name)" />
                            </div>
                            @*  <div class="mb-3">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Email" />
                                <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                            </div> *@
                            <div class="mb-3">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Phone" />
                                <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                            </div>
                            @if (EnableCustomPricing)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Percentage (%)</label>
                                    <InputNumber @bind-Value="NewCustomer.Percentage"
                                    class="form-control form-control-lg shadow-sm" />
                                    <ValidationMessage For="@(() => NewCustomer.Percentage)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Custom Price</label>
                                    <InputNumber @bind-Value="NewCustomer.CustomPrice"
                                    class="form-control form-control-lg shadow-sm" />
                                    <ValidationMessage For="@(() => NewCustomer.CustomPrice)" />
                                </div>
                            }

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <button type="button" class="btn btn-secondary" @onclick="CloseCustomerModal">Cancel</button>
                            </div>



                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


<!-- Add Wholesaler Popup -->
@if (showWholesalerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Wholesaler</h5>
                    <button type="button" class="btn-close" @onclick="CloseWholesalerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewWholesaler" OnValidSubmit="SaveWholesaler">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label>Name</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Name" />
                            <ValidationMessage For="@(()=>NewWholesaler.Name)" />
                        </div>
                        <div class="mb-3">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Email" />
                        </div>
                        <div class="mb-3">
                            <label>Phone</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Phone" />
                            <ValidationMessage For="@(()=>NewWholesaler.Phone)" />
                        </div>
                        <div class="mb-3">
                            <label>Address</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Address" />
                        </div>
                        <div class="mb-3 col-md-4">
                            <label>Type</label>
                            <InputSelect class="form-select" @bind-Value="NewWholesaler.ListManagementId">
                                @foreach (var t in listManagements)
                                {
                                    <option value="@t.Id">@t</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseWholesalerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}



