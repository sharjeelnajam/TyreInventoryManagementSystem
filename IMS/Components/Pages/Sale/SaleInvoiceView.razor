@page "/sales/view/{SaleId:guid}"
@using Domain
@using Infrastructure.Services
@inject ISaleService SaleService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<h4 class="mb-3">🧾 Invoice Details</h4>
@if (sale?.ShopServiceBillId != null)
{
    <p class="text-muted small mb-2">
        <span class="badge bg-secondary">Shop Billing</span>
        <a href="/shop-billing/bill/@sale.ShopServiceBillId">View original bill</a>
    </p>
}

@if (sale == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card p-3">
        <!-- Header Info -->
        <div class="row">
            <div class="col-md-4">
                <label>Sale #</label>
                <input class="form-control" value="@sale.SaleNumber" readonly />
            </div>
            <div class="col-md-4">
                <label>Date</label>
                <input class="form-control" value="@sale.SaleDate.ToString("dd-MMM-yyyy")" readonly />
            </div>
            <div class="col-md-4">
                <label>Customer</label>
                <input class="form-control" value="@(sale.Customer?.Name ?? sale.CustomerName)" readonly />
            </div>
        </div>

        <div class="row mt-2">
            <div class="col-md-3">
                <label>Payment Method</label>
                <input class="form-control" value="@sale.PaymentMethod" readonly />
            </div>
            <div class="col-md-3">
                <label>Payment Status</label>
                <input class="form-control" value="@sale.PaymentStatus" readonly />
            </div>
            <div class="col-md-3">
                <label>Discount</label>
                <input class="form-control" value="@sale.Discount?.ToString("N2")" readonly />
            </div>
            <div class="col-md-3">
                <label>Tax</label>
                <input class="form-control" value="@sale.TaxAmount?.ToString("N2")" readonly />
            </div>
        </div>
        @if (IsSplitPayment(sale.PaymentMethod))
        {
            <div class="row mt-2">
                <div class="col-md-3">
                    <label>Cash Amount</label>
                    <input class="form-control" value="@sale.CashAmount.ToString("N2")" readonly />
                </div>
                <div class="col-md-3">
                    <label>Card Amount</label>
                    <input class="form-control" value="@sale.CardAmount.ToString("N2")" readonly />
                </div>
            </div>
        }

        <!-- Totals: Total (subtotal), Net, Invoice Total -->
        <div class="row mt-2">
            <div class="col-md-4">
                <label>Total</label>
                <input class="form-control" value="@sale.TotalAmount.ToString("N2")" readonly />
            </div>
            <div class="col-md-4">
                <label>Net</label>
                <input class="form-control" value="@sale.NetAmount.ToString("N2")" readonly />
            </div>
            <div class="col-md-4">
                <label>Invoice Total</label>
                <input class="form-control fw-bold" value="@sale.NetAmount.ToString("N2")" readonly />
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-md-12">
                <label>Notes</label>
                <input class="form-control" value="@sale.Notes" readonly />
            </div>
        </div>

        <hr />
        <h5>Sale Items</h5>

        <table class="table table-sm table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Brand</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (sale.SaleDetails != null && sale.SaleDetails.Any())
                {
                    @foreach (var detail in sale.SaleDetails)
                    {
                        <tr>
                            <td>@detail.Product?.ProductName</td>
                            <td>@(detail.Brand ?? detail.Product?.Brand)</td>
                            <td>@detail.Quantity</td>
                            <td>@detail.UnitPrice.ToString("N2")</td>
                            <td>@detail.TotalPrice.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            @(sale.ShopServiceBillId != null ? "Service bill — see original bill above for line items." : "No sale details found.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3 text-end">
            <button class="btn btn-secondary" @onclick="GoBack">Back</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid SaleId { get; set; }

    private Sale? sale;

    protected override async Task OnInitializedAsync()
    {
        sale = await SaleService.GetByIdAsync(SaleId);
    }

    private static bool IsSplitPayment(string? paymentMethod) =>
        !string.IsNullOrWhiteSpace(paymentMethod) &&
        paymentMethod.Contains("card", StringComparison.OrdinalIgnoreCase) &&
        paymentMethod.Contains("cash", StringComparison.OrdinalIgnoreCase);

    private void GoBack() => Navigation.NavigateTo("/sales");
}

