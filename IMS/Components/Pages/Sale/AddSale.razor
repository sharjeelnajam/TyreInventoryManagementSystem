@using Domain
@using Infrastructure.Services
@inject ISaleService SaleService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject ApplicationDbContext _context
@rendermode InteractiveServer

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((Id == Guid.Empty ? "Add Sale" : "Edit Sale"))</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    <EditForm Model="@Sale" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-4">
                                <label>Customer</label>
                                <InputSelect class="form-control" @bind-Value="Sale.CustomerId">
                                    <option value="">-- Select Customer --</option>
                                    @foreach (var customer in Customers)
                                    {
                                        <option value="@customer.Id">@customer.Name</option>
                                    }
                                </InputSelect>
                                <button type="button" class="btn btn-link p-0 mt-1" @onclick="OpenAddCustomer">
                                    + Add New Customer
                                </button>
                            </div>

                            <div class="col-md-4">
                                <label>Payment Method</label>
                                <InputSelect class="form-control" @bind-Value="Sale.PaymentMethod">
                                    <option value="">-- Select Method --</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Card">Card</option>
                                    <option value="BankTransfer">Bank Transfer</option>
                                </InputSelect>
                            </div>


                            <div class="col-md-4">
                                <label>Payment Status</label>
                                <InputSelect @bind-Value="Sale.PaymentStatus" class="form-control">
                                    <option value="">-- Select Payment Status --</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Unpaid">Unpaid</option>
                                    <option value="Partial">Partial</option>
                                </InputSelect>
                            </div>

                        </div>

                        <hr />

                        <!-- Sale Details (like purchase page) -->
                        <h5>Sale Items</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                                {
                                    @foreach (var detail in Sale.SaleDetails)
                                    {
                                        <tr>
                                          <td>
                                                <select class="form-control" @onchange="(e) => OnProductChanged(detail, e)">
                                                    <option value="">-- Select Product --</option>
                                                    @foreach (var p in products)
                                                    {
                                                        <option value="@p.Id" selected="@(p.Id == detail.ProductId)">
                                                            @p.ProductName
                                                        </option>
                                                    }
                                                </select>
                                                <ValidationMessage For="@(() => detail.ProductId)" />
                                            </td>
                                            <td>
                                                <InputNumber TValue="int"
                                                             Value="detail.Quantity"
                                                             ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                                             ValueExpression="@(() => detail.Quantity)"
                                                             class="form-control" />

                                                @if (quantityErrors.ContainsKey(detail.ProductId))
                                                {
                                                    <div class="text-danger small mt-1">
                                                        @quantityErrors[detail.ProductId]
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <InputNumber TValue="decimal"
                                                             Value="detail.UnitPrice"
                                                             ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                                             ValueExpression="@(() => detail.UnitPrice)"
                                                             class="form-control" />
                                            </td>
                                            <td>@(detail.Quantity * detail.UnitPrice)</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveItem(detail)">X</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        <button type="button" class="btn btn-secondary" @onclick="AddItem" disabled="@(!isFormValid)"
                                style="opacity:@(isFormValid ? "1" : "0.6")">
                            + Add Item
                        </button>

                        <div class="mt-3 row">
                            <div class="col-md-4">
                                <label>Discount</label>

                                <InputNumber TValue="decimal?"
                                             Value="Sale.Discount"
                                             ValueChanged="OnDiscountChanged"
                                             ValueExpression="@(() => Sale.Discount)"
                                             class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label>Tax (%)</label>

                                <InputNumber TValue="decimal?"
                                             Value="Sale.TaxAmount"
                                             ValueChanged="OnTaxChanged"
                                             ValueExpression="@(() => Sale.TaxAmount)"
                                             class="form-control" />
                            </div>
                            <div class="col-md-4 text-end">
                                <label><b>Total:</b> @Sale.TotalAmount</label><br />
                                <label><b>Net:</b> @Sale.NetAmount</label>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary" disabled="@(!isFormValid)" style="opacity:@(isFormValid ? "1" : "0.6")">
                                Save
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Customer Popup -->
@if (showCustomerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Customer</h5>
                    <button type="button" class="btn-close" @onclick="CloseCustomerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewCustomer" OnValidSubmit="SaveCustomer">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label>Name</label>
                            <InputText class="form-control" @bind-Value="NewCustomer.Name" />
                            <ValidationMessage For="@(()=>NewCustomer.Name)" />
                        </div>
                        <div class="mb-3">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="NewCustomer.Email" />
                        </div>
                        <div class="mb-3">
                            <label>Phone</label>
                            <InputText class="form-control" @bind-Value="NewCustomer.Phone" />
                            <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseCustomerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    int availableStock;
    bool showError;
    bool isFormValid = true;
    private Dictionary<Guid, string> quantityErrors = new();
    protected Sale Sale { get; set; } = new();
    protected List<Customer> Customers { get; set; } = new();
    protected List<StockHistory> Stocks = new();
    private List<Product> products = new();


    protected bool showCustomerModal = false;
    protected Customer NewCustomer { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {

            Customers = await CustomerService.GetCustomersAsync();
            products = await ProductService.GetAllAsync();
            Stocks = _context.StockHistories.ToList();


            if (Id != Guid.Empty)
            {
                Sale = await SaleService.GetByIdAsync(Id);
            }
            else
            {
                Sale = new Sale
                    {
                        SaleDate = DateTime.Now,
                        SaleNumber = $"SO-{DateTime.Now:yyyyMMddHHmmss}",
                        SaleDetails = new List<SaleDetail>()
                    };
            }
        }
    }

    protected async Task HandleValidSubmit()
    {
        foreach (var s in Sale.SaleDetails)
        {
            s.SaleId = Sale.Id;
        }

        if (Id == Guid.Empty)
            await SaleService.AddAsync(Sale);
        else
            await SaleService.UpdateAsync(Sale);

        IsVisible = false;
        await OnClose.InvokeAsync();
    }

    protected void Close() => OnClose.InvokeAsync();

    protected void AddItem()
    {
        Sale.SaleDetails.Add(new SaleDetail
            {
                Id = Guid.Empty,
                Quantity = 0,
                UnitPrice = 0,
                TotalPrice = 0
            });
    }

    protected void RemoveItem(SaleDetail item)
    {
        Sale.SaleDetails.Remove(item);
        if (quantityErrors.ContainsKey(item.ProductId))
            quantityErrors.Remove(item.ProductId);

        isFormValid = !quantityErrors.Any();
        RecalculateTotals();
    }

    private void OnDiscountChanged(decimal? newValue)
    {
        Sale.Discount = newValue ?? 0;
        RecalculateTotals();
    }

    private void OnTaxChanged(decimal? value)
    {
        Sale.TaxAmount = value ?? 0;
        RecalculateTotals();
    }

    // NEW METHOD: Handle product selection change
    private void OnProductChanged(SaleDetail detail, ChangeEventArgs e)
    {
        // Parse the new product ID from dropdown value
        if (!Guid.TryParse(e.Value?.ToString(), out var newProductId))
            return;

        // Store the previous product ID
        var previousProductId = detail.ProductId;

        // Update the product ID
        detail.ProductId = newProductId;

        // If product actually changed, reset related fields
        if (previousProductId != Guid.Empty && previousProductId != newProductId)
        {
            detail.Quantity = 0;
            detail.UnitPrice = 0;
            detail.TotalPrice = 0;
            isFormValid = true;

            // Remove any quantity error from previous product
            if (quantityErrors.ContainsKey(previousProductId))
                quantityErrors.Remove(previousProductId);
        }

        // Recalculate overall totals (if you have multiple rows)
        RecalculateTotals();
    }



    private void OnQuantityChanged(SaleDetail detail, int newValue)
    {
        detail.Quantity = newValue;

        var stockProduct = Stocks.FirstOrDefault(p => p.ProductId == detail.ProductId);
        if (stockProduct == null)
        {
            quantityErrors[detail.ProductId] = $"No Available Stock againset this product pleae purchase first";
            isFormValid = false;
            return;
        }

        // Calculate total quantity of same product in all rows
        var totalQtyForThisProduct = Sale.SaleDetails
            .Where(x => x.ProductId == detail.ProductId)
            .Sum(x => x.Quantity);

        // Check if exceeds available stock
        if (totalQtyForThisProduct > stockProduct.NewStockLevel)
        {
            quantityErrors[detail.ProductId] = $"Your entered quantity exceeds available stock: {stockProduct.NewStockLevel}";
            isFormValid = false;
        }
        else
        {
            // remove error for this product if valid now
            if (quantityErrors.ContainsKey(detail.ProductId))
                quantityErrors.Remove(detail.ProductId);

            detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            isFormValid = !quantityErrors.Any();
        }

        RecalculateTotals();
    }

    private void OnUnitPriceChanged(SaleDetail detail, decimal newValue)
    {
        detail.UnitPrice = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        if (Sale.SaleDetails == null || !Sale.SaleDetails.Any())
        {
            Sale.TotalAmount = 0;
            Sale.NetAmount = 0;
            return;
        }
        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        Sale.TotalAmount = total > 0 ? total - Sale.Discount ?? 0 : 0;
        Sale.NetAmount = total > 0 ? total - (Sale.Discount ?? 0) + (Sale.TaxAmount ?? 0) : 0;
    }

    // Customer popup
    protected void OpenAddCustomer()
    {
        NewCustomer = new Customer();
        showCustomerModal = true;
    }

    protected async Task SaveCustomer()
    {
        await CustomerService.AddCustomerAsync(NewCustomer);
        Customers = await CustomerService.GetCustomersAsync();
        Sale.CustomerId = NewCustomer.Id;
        showCustomerModal = false;
    }

    protected void CloseCustomerModal()
    {
        showCustomerModal = false;
    }
}
