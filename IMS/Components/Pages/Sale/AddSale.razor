@using Domain
@using Domain.DTO
@using Infrastructure.Services
@inject ISaleService SaleService
@inject ICustomerService CustomerService
@inject IProductService ProductService
@inject IWholesalerService WholesalerService
@inject ApplicationDbContext _context
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@((Id == Guid.Empty ? "Add Sale" : "Edit Sale"))</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>

                <div class="modal-body">
                    <EditForm Model="@Sale" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="row">
                            <div class="col-md-4">
                                <label>Sale #</label>
                                <InputText @bind-Value="Sale.SaleNumber" class="form-control" readonly />
                            </div>

                            <div class="col-md-4">
                                <label>Date</label>
                                <InputDate @bind-Value="Sale.SaleDate" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="row mt-4 g-2">

                            <div class="col-md-3">
                                <label>Payment Method</label>
                                <InputSelect class="form-control" @bind-Value="Sale.PaymentMethod">
                                    <option value="">-- Select Method --</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Card">Card</option>
                                    <option value="BankTransfer">Bank Transfer</option>
                                </InputSelect>
                            </div>

                            <div class="col-md-3">
                                <label>Payment Status</label>
                                <InputSelect @bind-Value="Sale.PaymentStatus" class="form-control">
                                    <option value="">-- Select Payment Status --</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Unpaid">Unpaid</option>
                                    <option value="Partial">Partial</option>
                                </InputSelect>
                            </div>

                            @if (!isWholesalerMode)
                            {
                                <div class="col-md-3">
                                    <label>Customer</label>

                                    <InputSelect class="form-control"
                                    TValue="Guid?"
                                    Value="Sale.CustomerId"
                                    ValueChanged="OnCustomerChanged"
                                    ValueExpression="@(() => Sale.CustomerId)">
                                        <option value="">-- Select Customer --</option>

                                        @foreach (var customer in Customers)
                                        {
                                            <option value="@customer.Id">@customer.Name</option>
                                        }
                                    </InputSelect>

                                    <button type="button" class="btn btn-link p-0 mt-1" @onclick="OpenAddCustomer">
                                        + Add New Customer
                                    </button>
                                </div>

                            }

                            @if (isWholesalerMode)
                            {
                                <div class="col-md-3">
                                    <label>Wholesaler</label>
                                    <InputSelect class="form-control" @bind-Value="Sale.WholesalerId">
                                        <option value="">-- Select Wholesaler --</option>
                                        @foreach (var w in Wholesalers)
                                        {
                                            <option value="@w.Id">@w.Name (@w.Type)</option>
                                        }
                                    </InputSelect>
                                    <button type="button" class="btn btn-link p-0 mt-1" @onclick="OpenAddWholesaler">
                                        + Add New Wholesaler
                                    </button>
                                </div>
                            }

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Bill To</label>
                                <div class="form-check form-switch mt-1">
                                    <InputCheckbox class="form-check-input"
                                    Value="isWholesalerMode"
                                    ValueChanged="EventCallback.Factory.Create<bool>(this, OnBillToChanged)"
                                    ValueExpression="@(() => isWholesalerMode)" />

                                    <label class="form-check-label">
                                        @(isWholesalerMode ? "Wholesaler" : "Customer")
                                    </label>
                                </div>
                            </div>


                        </div>


                        <hr />

                        <!-- Sale Items Section -->
                        <h5>Sale Items</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Qty</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Sale.SaleDetails != null && Sale.SaleDetails.Any())
                                {
                                    @foreach (var detail in Sale.SaleDetails)
                                    {
                                        <tr>
                                            <td style="min-width: 300px; position: relative;">
                                                <!-- Searchable Dropdown -->
                                                <div class="dropdown">
                                                    <input type="text"
                                                    class="form-control"
                                                    placeholder="Search product..."
                                                    value="@GetSearchText(detail)"
                                                    @oninput="(e) => OnSearchInput(e, detail)"
                                                    @onfocus="() => ShowDropdown(detail)"
                                                    @onblur="() => HideDropdown(detail)" />

                                                    @if (GetDropdownState(detail))
                                                    {
                                                        <div class="dropdown-menu show d-block position-absolute w-100"
                                                        style="z-index: 1060; max-height: 250px; overflow-y: auto; background: white;">
                                                            @foreach (var product in GetFilteredProducts(detail))
                                                            {
                                                                bool isSelected = product.Id == detail.ProductId;
                                                                bool isAlreadyUsed = Sale.SaleDetails.Any(d => d.ProductId == product.Id && d != detail);

                                                                <button type="button"
                                                                class="dropdown-item @(isSelected ? "active" : "") @(isAlreadyUsed && !isSelected ? "text-muted" : "")"
                                                                disabled="@(!isSelected && isAlreadyUsed)"
                                                                @onclick="() => SelectProduct(detail, product)"
                                                                @onkeydown="(e) => HandleKeyDown(e, detail, product)">
                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                        <span>
                                                                            @product.ProductName - @product.Brand - @product.TyreSize
                                                                        </span>
                                                                        @if (isAlreadyUsed && !isSelected)
                                                                        {
                                                                            <small class="text-danger ms-2">(Already added)</small>
                                                                        }
                                                                    </div>
                                                                </button>
                                                            }
                                                            @if (!GetFilteredProducts(detail).Any())
                                                            {
                                                                <div class="dropdown-item text-muted">No products found</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>

                                                <ValidationMessage For="@(() => detail.ProductId)" />
                                            </td>

                                            <td>
                                                <InputNumber TValue="int"
                                                Value="detail.Quantity"
                                                ValueChanged="@(v => OnQuantityChanged(detail, v))"
                                                ValueExpression="@(() => detail.Quantity)"
                                                class="form-control" />

                                                @if (quantityErrors.ContainsKey(detail.ProductId))
                                                {
                                                    <div class="text-danger small mt-1">
                                                        @quantityErrors[detail.ProductId]
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <InputNumber TValue="decimal"
                                                Value="detail.UnitPrice"
                                                ValueChanged="@(v => OnUnitPriceChanged(detail, v))"
                                                ValueExpression="@(() => detail.UnitPrice)"
                                                class="form-control" />
                                            </td>
                                            <td>@((detail.Quantity * detail.UnitPrice).ToString("N2"))</td>
                                            <td>
                                                <button class="btn btn-sm btn-danger" type="button" @onclick="() => RemoveItem(detail)">X</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                        <button type="button" class="btn btn-secondary" @onclick="AddItem" disabled="@(!isFormValid)"
                        style="opacity:@(isFormValid ? "1" : "0.6")">
                            + Add Item
                        </button>

                        @if (CustomerCustomPrice.HasValue || CustomerPercentage.HasValue)
                        {

                        }


                        <div class="row mt-4 border-top pt-3">
                            <div class="col-md-12">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <div class="row g-3 align-items-center">

                                            @if (ShowOldDiscountField)
                                            {
                                                <div class="col-md-4">
                                                    <label>Discount</label>
                                                    <InputNumber TValue="decimal?"
                                                    Value="Sale.Discount"
                                                    ValueChanged="OnDiscountChanged"
                                                    ValueExpression="@(() => Sale.Discount)"
                                                    class="form-control" />
                                                </div>

                                                <div class="col-md-4">
                                                    <label>Tax (%)</label>
                                                    <InputNumber TValue="decimal?"
                                                    Value="Sale.TaxAmount"
                                                    ValueChanged="OnTaxChanged"
                                                    ValueExpression="@(() => Sale.TaxAmount)"
                                                    class="form-control" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="col-md-3">
                                                    <label>Customer Custom Price</label>
                                                    <InputNumber @bind-Value="CustomerCustomPrice" class="form-control" />
                                                </div>

                                                <div class="col-md-3">
                                                    <label>Customer Percentage (%)</label>
                                                    <InputNumber @bind-Value="CustomerPercentage" class="form-control" />
                                                </div>

                                                <div class="col-md-2">
                                                    <label>Tax (%)</label>
                                                    <InputNumber TValue="decimal?"
                                                    Value="Sale.TaxAmount"
                                                    ValueChanged="OnTaxChanged"
                                                    ValueExpression="@(() => Sale.TaxAmount)"
                                                    class="form-control" />
                                                </div>
                                            }

                                            <div class="col-md-2 text-end">
                                                <label class="form-label fw-semibold mb-0">Total</label>
                                                <div class="fw-bold fs-5">@Sale.TotalAmount.ToString("N2")</div>
                                            </div>

                                            <div class="col-md-2 text-end">
                                                <label class="form-label fw-semibold mb-0">Net</label>
                                                <div class="fw-bold fs-5">@Sale.NetAmount.ToString("N2")</div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary" disabled="@(!isFormValid)" style="opacity:@(isFormValid ? "1" : "0.6")">
                                Save
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add Customer Popup -->
@if (showCustomerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Customer</h5>
                    <button type="button" class="btn-close" @onclick="CloseCustomerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewCustomer" OnValidSubmit="SaveCustomer">
                        <DataAnnotationsValidator />
                        <div class="row g-3">

                            <div class="col-md-12 mt-3">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="EnableCustomPricing"
                                    class="form-check-input" />
                                    <label class="form-check-label fw-semibold ms-2">
                                        Enable Custom Pricing
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Name" />
                                <ValidationMessage For="@(()=>NewCustomer.Name)" />
                            </div>
                            <div class="mb-3">
                                <label>Email</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Email" />
                                <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                            </div>
                            <div class="mb-3">
                                <label>Phone</label>
                                <InputText class="form-control" @bind-Value="NewCustomer.Phone" />
                                <ValidationMessage For="@(()=>NewCustomer.Phone)" />
                            </div>
                            @if (EnableCustomPricing)
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Percentage (%)</label>
                                    <InputNumber @bind-Value="NewCustomer.Percentage"
                                    class="form-control form-control-lg shadow-sm" />
                                    <ValidationMessage For="@(() => NewCustomer.Percentage)" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Custom Price</label>
                                    <InputNumber @bind-Value="NewCustomer.CustomPrice"
                                    class="form-control form-control-lg shadow-sm" />
                                    <ValidationMessage For="@(() => NewCustomer.CustomPrice)" />
                                </div>
                            }

                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <button type="button" class="btn btn-secondary" @onclick="CloseCustomerModal">Cancel</button>
                            </div>



                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


<!-- Add Wholesaler Popup -->
@if (showWholesalerModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Add Wholesaler</h5>
                    <button type="button" class="btn-close" @onclick="CloseWholesalerModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@NewWholesaler" OnValidSubmit="SaveWholesaler">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label>Name</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Name" />
                            <ValidationMessage For="@(()=>NewWholesaler.Name)" />
                        </div>
                        <div class="mb-3">
                            <label>Email</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Email" />
                        </div>
                        <div class="mb-3">
                            <label>Phone</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Phone" />
                            <ValidationMessage For="@(()=>NewWholesaler.Phone)" />
                        </div>
                        <div class="mb-3">
                            <label>Address</label>
                            <InputText class="form-control" @bind-Value="NewWholesaler.Address" />
                        </div>
                        <div class="mb-3 col-md-4">
                            <label>Type</label>
                            <InputSelect class="form-select" @bind-Value="NewWholesaler.Type">
                                @foreach (var t in Enum.GetValues<Domain.Enums.WholesalerType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseWholesalerModal">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}


@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    int availableStock;
    bool showError;
    bool isFormValid = true;
    private Dictionary<Guid, string> quantityErrors = new();
    protected Sale Sale { get; set; } = new();
    protected List<Customer> Customers { get; set; } = new();
    protected List<StockHistory> Stocks = new();
    private List<ProductDto> products = new();

    // Searchable dropdown state
    private string searchText = string.Empty;
    private Dictionary<Guid, bool> dropdownStates = new();
    private Dictionary<Guid, string> searchTexts = new();

    protected bool showCustomerModal = false;
    protected Customer NewCustomer { get; set; } = new();

    protected List<Wholesaler> Wholesalers { get; set; } = new();
    protected bool showWholesalerModal = false;
    protected Wholesaler NewWholesaler { get; set; } = new();

    private decimal? CustomerCustomPrice { get; set; }
    private decimal? CustomerPercentage { get; set; }
    private Customer customerForData = new Customer();
    private bool ShowOldDiscountField = true;
    private bool EnableCustomPricing { get; set; } = false;


    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            Customers = await CustomerService.GetCustomersAsync();
            products = await ProductService.GetAllAsync();
            Stocks = _context.StockHistories.ToList();

            Wholesalers = await WholesalerService.GetAllAsync();

            if (Id != Guid.Empty)
            {
                Sale = await SaleService.GetByIdAsync(Id);
                Sale.Discount ??= 0;
                Sale.TaxAmount ??= 0;

                // Initialize dropdown states for existing items
                if (Sale.SaleDetails != null)
                {
                    foreach (var detail in Sale.SaleDetails)
                    {
                        dropdownStates[detail.Id] = false;
                        searchTexts[detail.Id] = "";
                    }
                }
            }
            else
            {   
                Sale = new Sale
                    {
                        SaleDate = DateTime.Now,
                        SaleNumber = $"SO-{DateTime.Now:yyyyMMddHHmmss}",
                        SaleDetails = new List<SaleDetail>(),
                        Discount = 0,
                        TaxAmount = 0
                    };
            }
        }
    }

    protected async Task HandleValidSubmit()
    {
        try
        {
            foreach (var s in Sale.SaleDetails)
            {
                s.SaleId = Sale.Id;
               
            }
            if (Id == Guid.Empty)
            {
                await SaleService.AddAsync(Sale);
                products = await ProductService.GetAllAsync();
            }

            else
                await SaleService.UpdateAsync(Sale);


            await OnClose.InvokeAsync();
            IsVisible = false;
        }
        catch (Exception)
        {
            
            throw;
        }
        finally
        {
            StateHasChanged();
        }
    }

    protected void Close()
    {
        OnClose.InvokeAsync();
        ShowOldDiscountField = true;
    }


    protected void AddItem()
    {
        var newDetail = new SaleDetail
            {
                Id = Guid.NewGuid(),
                Quantity = 0,
                UnitPrice = 0,
                TotalPrice = 0
            };

        Sale.SaleDetails.Add(newDetail);
        dropdownStates[newDetail.Id] = false;
        searchTexts[newDetail.Id] = "";
    }

    protected void RemoveItem(SaleDetail item)
    {
        Sale.SaleDetails.Remove(item);
        if (quantityErrors.ContainsKey(item.ProductId))
            quantityErrors.Remove(item.ProductId);

        dropdownStates.Remove(item.Id);
        searchTexts.Remove(item.Id);

        isFormValid = !quantityErrors.Any();
        RecalculateTotals();
    }

    // Searchable Dropdown Methods
    private string GetSearchText(SaleDetail detail)
    {
        return searchTexts.ContainsKey(detail.Id) ? searchTexts[detail.Id] : "";
    }

    private bool GetDropdownState(SaleDetail detail)
    {
        return dropdownStates.ContainsKey(detail.Id) && dropdownStates[detail.Id];
    }

    private void OnSearchInput(ChangeEventArgs e, SaleDetail detail)
    {
        var text = e.Value?.ToString() ?? "";
        searchTexts[detail.Id] = text;

        // Auto-show dropdown when typing
        if (!string.IsNullOrWhiteSpace(text) && !GetDropdownState(detail))
        {
            ShowDropdown(detail);
        }
    }

    private void ShowDropdown(SaleDetail detail)
    {
        // Close all other dropdowns
        foreach (var key in dropdownStates.Keys.ToList())
        {
            dropdownStates[key] = false;
        }

        dropdownStates[detail.Id] = true;
        StateHasChanged();
    }

    private async void HideDropdown(SaleDetail detail)
    {
        // Small delay to allow click event to fire
        await Task.Delay(200);
        if (dropdownStates.ContainsKey(detail.Id))
        {
            dropdownStates[detail.Id] = false;
            StateHasChanged();
        }
    }

    private IEnumerable<ProductDto> GetFilteredProducts(SaleDetail currentDetail)
    {
        var searchText = GetSearchText(currentDetail);
        var query = products.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            query = query.Where(p =>
                (p.ProductName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                (p.Brand?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true) ||
                (p.TyreSize?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true)
            );
        }

        return query.OrderBy(p => p.ProductName);
    }

    private void SelectProduct(SaleDetail detail, ProductDto product)
    {
        var previousProductId = detail.ProductId;
        detail.ProductId = product.Id;

        var stockProduct = _context.PurchaseDetails
            .Where(p => p.ProductId == product.Id)
            .OrderByDescending(p => p.CreatedAt)
            .FirstOrDefault();

        if (previousProductId != product.Id)
        {
            detail.Quantity = 1;
            detail.UnitPrice = stockProduct?.SellingPrice ?? 0;
            detail.TotalPrice = detail.Quantity * detail.UnitPrice;

            if (quantityErrors.ContainsKey(previousProductId))
                quantityErrors.Remove(previousProductId);
        }

        // Update search text to show selected product
        searchTexts[detail.Id] = $"{product.ProductName} {product.Brand} {product.TyreSize}";
        dropdownStates[detail.Id] = false;

        RecalculateTotals();
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e, SaleDetail detail, ProductDto product)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            SelectProduct(detail, product);
        }
    }

    private string GetProductName(Guid productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product != null ? $"{product.ProductName} - {product.Brand} - {product.TyreSize}" : "Unknown";
    }

    // Existing methods
    private void OnDiscountChanged(decimal? newValue)
    {
        Sale.Discount = newValue ?? 0;
        RecalculateTotals();
    }

    private void OnTaxChanged(decimal? value)
    {
        Sale.TaxAmount = value ?? 0;
        RecalculateTotals();
    }

    private void OnProductChanged(SaleDetail detail, Guid newProductId)
    {
        // This method is kept for compatibility, but now handled by SelectProduct
        var product = products.FirstOrDefault(p => p.Id == newProductId);
        if (product != null)
        {
            SelectProduct(detail, product);
        }
    }

    private void OnQuantityChanged(SaleDetail detail, int newValue)
    {
        detail.Quantity = newValue;

        var existingValue = _context.SaleDetail.FirstOrDefault(s => s.ProductId == detail.ProductId);

        if (Id != Guid.Empty && existingValue != null)
        {
            if (newValue > existingValue.Quantity)
            {
                newValue = newValue - existingValue.Quantity;
            }
            else if (newValue < existingValue.Quantity)
            {
                newValue = existingValue.Quantity - newValue;
            }
        }

        var stockProduct = Stocks.FirstOrDefault(p => p.ProductId == detail.ProductId);

        if (stockProduct == null)
        {
            quantityErrors[detail.ProductId] = $"No available stock for this product. Please purchase first.";
            isFormValid = false;
            return;
        }

        if (newValue > stockProduct.NewStockLevel)
        {
            quantityErrors[detail.ProductId] = $"Quantity exceeds available stock: {stockProduct.NewStockLevel}";
            isFormValid = false;
        }
        else
        {
            if (quantityErrors.ContainsKey(detail.ProductId))
                quantityErrors.Remove(detail.ProductId);

            detail.TotalPrice = detail.Quantity * detail.UnitPrice;
            isFormValid = !quantityErrors.Any();
        }

        RecalculateTotals();
    }

    private async Task OnCustomerChanged(Guid? value)
    {
        if (value == null || value == Guid.Empty)
            return;

        Sale.CustomerId = value;

        var customer = Customers.FirstOrDefault(c => c.Id == value);

        if (customer != null)
        {
            if (customer.CustomPrice.HasValue || customer.Percentage.HasValue)
            {
                CustomerCustomPrice = customer.CustomPrice;
                CustomerPercentage = customer.Percentage;
                ShowOldDiscountField = false;
            }
            else

                ShowOldDiscountField = true;
        }
        RecalculateTotals();
    }

    private void OnUnitPriceChanged(SaleDetail detail, decimal newValue)
    {
        detail.UnitPrice = newValue;
        detail.TotalPrice = detail.Quantity * detail.UnitPrice;
        RecalculateTotals();
    }

    private void OnBillToChanged(bool value)
    {
        isWholesalerMode = value;

        // When toggle changes → always show previous discount field
        ShowOldDiscountField = true;

        // Optional: recalc bill
        //ApplyCustomerDiscount();
    }

    private void RecalculateTotals()
    {
        if (Sale.SaleDetails == null || !Sale.SaleDetails.Any())
        {
            Sale.TotalAmount = 0;
            Sale.NetAmount = 0;
            return;
        }

        var total = Sale.SaleDetails.Sum(s => s.Quantity * s.UnitPrice);
        Sale.TotalAmount = total > 0 ? total - (Sale.Discount ?? 0) : 0;
        if (!ShowOldDiscountField)
        {

            decimal discount = 0;

            // Rule 1 – Only CustomPrice
            if (CustomerCustomPrice.HasValue && (!CustomerPercentage.HasValue || CustomerPercentage == 0))
            {
                discount = CustomerCustomPrice.Value;
            }
            // Rule 2 – Only Percentage
            else if (!CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
            {
                discount = total * (CustomerPercentage.Value / 100);
            }
            // Rule 3 – Both values
            else if (CustomerCustomPrice.HasValue && CustomerPercentage.HasValue && CustomerPercentage > 0)
            {
                var percentageAmount = total * (CustomerPercentage.Value / 100);
                discount = CustomerCustomPrice.Value + percentageAmount;
            }

            Sale.NetAmount = total - discount;

            if (Sale.NetAmount < 0)
                Sale.NetAmount = 0;
        }
        else
            Sale.NetAmount = total > 0 ? total - (Sale.Discount ?? 0) + (Sale.TaxAmount ?? 0) : 0;
    }

    private bool isWholesalerMode
    {
        get => _isWholesalerMode;
        set
        {
            _isWholesalerMode = value;

            if (value)
            {
                Sale.CustomerId = Guid.Empty;   // Clear customer
            }
            else
            {
                Sale.WholesalerId = Guid.Empty; // Clear wholesaler
            }
        }
    }
    private bool _isWholesalerMode;

    // Customer popup methods
    protected void OpenAddCustomer()
    {
        NewCustomer = new Customer();
        showCustomerModal = true;
        EnableCustomPricing = NewCustomer.Percentage.HasValue
                              || NewCustomer.CustomPrice.HasValue;
    }

    protected async Task SaveCustomer()
    {
        await CustomerService.AddCustomerAsync(NewCustomer);
        Customers = await CustomerService.GetCustomersAsync();
        Sale.CustomerId = NewCustomer.Id;
        if(NewCustomer.CustomPrice.HasValue || NewCustomer.Percentage.HasValue)
        {
            ShowOldDiscountField = false;
        }
        showCustomerModal = false;
    }

    protected void CloseCustomerModal()
    {
        showCustomerModal = false;
    }

    // WholeSaler popup methods
    protected void OpenAddWholesaler()
    {
        NewWholesaler = new Wholesaler();
        showWholesalerModal = true;
    }

    protected async Task SaveWholesaler()
    {
        // ensure Id is set (if your service expects auto-generated, Wholesaler constructor may set it)
        if (NewWholesaler.Id == Guid.Empty)
            NewWholesaler.Id = Guid.NewGuid();

        await WholesalerService.AddAsync(NewWholesaler);

        // reload lists
        Wholesalers = await WholesalerService.GetAllAsync();
        // pre-select the newly added wholesaler for this sale
        Sale.WholesalerId = NewWholesaler.Id;

        showWholesalerModal = false;
        StateHasChanged();
    }

    protected void CloseWholesalerModal()
    {
        showWholesalerModal = false;
    }

}
