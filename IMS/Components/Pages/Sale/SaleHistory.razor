@page "/salehistory/{productId:guid}"
@using Domain
@using Infrastructure.Services
@inject ISaleService SaleService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Sale History</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-secondary mb-0">
            Sale History
        </h3>
        <button class="btn btn-outline-primary" @onclick="GoBack">
            <i class="bi bi-arrow-left-circle me-1"></i> Back
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Loading sale history...</p>
        </div>
    }
    else if (saleDetails == null || !saleDetails.Any())
    {
        <div class="alert alert-info shadow-sm">
            <i class="bi bi-info-circle me-2"></i>
            No sale records found for this product.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Sale #</th>
                        <th>Sale Date</th>
                        <th>Customer</th>
                        <th>Quantity</th>
                        <th>Unit Price</th>
                        <th>Total Price</th>
                        <th>Payment Method</th>
                       @*  <th>Remarks</th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in saleDetails)
                    {
                        <tr>
                            <td>@detail.Sale?.SaleNumber</td>
                            <td>@detail.Sale?.SaleDate.ToString("dd-MMM-yyyy")</td>
                            <td>@detail.Sale?.Customer?.Name</td>
                            <td>@detail.Quantity</td>
                            <td>@detail.UnitPrice.ToString("N2")</td>
                            <td>@detail.TotalPrice.ToString("N2")</td>
                            <td>@detail.Sale?.PaymentMethod</td>
                           @*  <td>@detail.Remarks</td> *@
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public Guid productId { get; set; }
    private List<SaleDetail>? saleDetails;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadSaleHistory();
    }

    private async Task LoadSaleHistory()
    {
        isLoading = true;
        saleDetails = await SaleService.GetSaleDetailsByProductIdAsync(productId);
        isLoading = false;
    }

    private void GoBack() => Navigation.NavigateTo("/stock-history");
}
