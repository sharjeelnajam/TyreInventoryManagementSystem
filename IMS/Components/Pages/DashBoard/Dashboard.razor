@page "/dashboard"
@attribute [Authorize(Roles = "Admin")]

@using Infrastructure.Services
@using Domain
@using Domain.DTO
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using QuestPDF.Fluent
@using QuestPDF.Infrastructure

@inject IStaffService staffService
@inject ISaleService saleService
@inject IExpenseService expenseService
@inject ICustomerService customerService
@inject IProfitReportService ProfitReportService
@inject IProductService productService
@inject ISupplierService supplierService
@inject IJSRuntime JS
@inject ApplicationDbContext _context;

@rendermode InteractiveServer

<PageTitle>Dashboard</PageTitle>

@if (showThreshold)
{
    <div class="threshold-overlay"></div>

    <div class="threshold-modal">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white fw-bold d-flex justify-content-between">
                <span>
                    <i class="bi bi-exclamation-octagon me-2"></i>
                    Low Stock Products (≤ 5)
                </span>

                <div class="d-flex gap-2">
                    <button class="btn btn-light btn-sm" @onclick="DownloadThresholdPdf">
                        <i class="bi bi-download"></i> Download PDF
                    </button>

                    <button class="btn btn-light btn-sm" @onclick="ToggleThreshold">
                        <i class="bi bi-arrow-left"></i> Back
                    </button>
                </div>

            </div>

            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Stock</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (thresholdProducts.Any())
                        {
                            @foreach (var item in thresholdProducts)
                            {
                                <tr>
                                    <td>@(++srNo)</td>
                                    <td>@item.Product.ProductName</td>
                                    <td>@item.Product.Type</td>
                                    <td class="fw-bold">@item.NewStockLevel</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-3">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    All products have sufficient stock.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}


<div class="ps-0 pe-0 container-fluid mt-1 @(showThreshold ? "disable-page" : "")">

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-end mb-3">
            <button class="btn btn-danger " @onclick="ToggleThreshold">
                <i class="bi bi-exclamation-triangle me-2"></i> Threshold 
            </button>
        </div>
        <!-- Filter -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-funnel me-2"></i>Profit Filter
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Start Date</label>

                        <InputDate TValue="DateTime?"
                        Value="startDate"
                        ValueChanged="OnStartDateChanged"
                        ValueExpression="@(() => startDate)"
                        class="form-control" />

                        @if (!string.IsNullOrEmpty(DateError))
                        {
                            <span class="text-danger">@DateError</span>
                        }
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">End Date</label>

                        <InputDate TValue="DateTime?"
                        Value="endDate"
                        ValueChanged="OnEndDateChanged"
                        ValueExpression="@(() => endDate)"
                        class="form-control" />

                        @if (!string.IsNullOrEmpty(DateError))
                        {
                            <span class="text-danger">@DateError</span>
                        }
                    </div>


                </div>
                @if (!string.IsNullOrEmpty(filterMessage))
                {
                    <div class="mt-2 text-info small">
                        <i class="bi bi-info-circle me-1"></i>@filterMessage
                    </div>
                }
            </div>
        </div>


        <!-- Summary cards -->
        <!-- Summary cards -->
        <div class="row g-3 align-items-stretch">

            <!-- Filtered Profit -->
            <div class="col-sm-6 col-lg-3 d-flex">
                <div class="card shadow-sm border-0 text-white h-100 w-100 dashboard-card"
                style="background-color:#6c757d;">
                    <!-- Purple -->
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="fw-bold mb-1 small">Filtered Profit</h6>
                            <h5 class="fw-bold mb-0">@MonthlyProfit.ToString("C", new CultureInfo("ur-PK"))</h5>
                            <small class="opacity-75">
                                @(startDate.HasValue && endDate.HasValue
                                            ? $"{startDate.Value:MMM dd, yyyy} - {endDate.Value:MMM dd, yyyy}"
                                            : "Current Month")
                            </small>
                        </div>
                        <i class="bi bi-cash-coin fs-3 opacity-75"></i>
                    </div>
                </div>
            </div>

            <!-- Total Expense -->
            <div class="col-sm-6 col-lg-3 d-flex">
                <div class="card shadow-sm border-0 text-white h-100 w-100 dashboard-card"
                style="background-color:#fd7e14;">
                    <!-- Orange -->
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="fw-bold mb-1 small">Total Expense</h6>
                            <h5 class="fw-bold mb-0">@MonthlyExpense.ToString("C", new CultureInfo("ur-PK"))</h5>
                            <small class="opacity-75">
                                @(startDate.HasValue && endDate.HasValue
                                            ? $"{startDate.Value:MMM dd, yyyy} - {endDate.Value:MMM dd, yyyy}"
                                            : "Current Month")
                            </small>
                        </div>
                        <i class="bi bi-cash-coin fs-3 opacity-75"></i>
                    </div>
                </div>
            </div>

            <!-- Total Staff -->
            <div class="col-sm-6 col-lg-3 d-flex">
                <div class="card shadow-sm border-0 text-white h-100 w-100 dashboard-card"
                style="background-color:#20c997;">
                    <!-- Teal -->
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="fw-bold mb-1 small">Total Staff</h6>
                            <h5 class="fw-bold mb-0">@Staffs.Count()</h5>
                        </div>
                        <i class="bi bi-people fs-3 opacity-75"></i>
                    </div>
                </div>
            </div>

            <!-- Total Customer -->
            <div class="col-sm-6 col-lg-3 d-flex">
                <div class="card shadow-sm border-0 text-white h-100 w-100 dashboard-card"
                style="background-color:#007bff;">
                    <!-- Blue -->
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="fw-bold mb-1 small">Total Customer</h6>
                            <h5 class="fw-bold mb-0">@customers.Count()</h5>
                        </div>
                        <i class="bi bi-person-badge fs-3 opacity-75"></i>
                    </div>
                </div>
            </div>

            <!-- Total Products -->
            <div class="col-sm-6 col-lg-3 d-flex">
                <div class="card shadow-sm border-0 text-white h-100 w-100 dashboard-card"
                style="background-color:#dc3545;">
                    <!-- Red -->
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="fw-bold mb-1 small">Total Products</h6>
                            <h5 class="fw-bold mb-0">@products.Count()</h5>
                        </div>
                        <i class="bi bi-box-seam fs-3 opacity-75"></i>
                    </div>
                </div>
            </div>

            <!-- Total Invoices -->
            <div class="col-sm-6 col-lg-3 d-flex">
                <div class="card shadow-sm border-0 text-white h-100 w-100 dashboard-card"
                style="background-color:#808080;">
                    <!-- Indigo -->
                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                        <div>
                            <h6 class="fw-bold mb-1 small">Total Invoices</h6>
                            <h5 class="fw-bold mb-0">@TotalInvoices</h5>
                        </div>
                        <i class="bi bi-receipt fs-3 opacity-75"></i>
                    </div>
                </div>
            </div>

        </div>


        <!-- Future Expansion Row -->
        <div class="row g-4">

            


           @*  <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold">
                        Profit Overview Chart (Coming Soon)
                    </div>
                    <div class="card-body text-center text-muted">
                        <i class="bi bi-activity fs-1 text-secondary"></i>
                        <p class="mt-3">You can display profit trends, graphs, or reports here later.</p>
                    </div>
                </div>
            </div> *@
        </div>
    }
</div>

<style>
    .threshold-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(5px);
    z-index: 9998;
    }

    .threshold-modal {
    position: fixed;
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    max-height: 80vh;
    overflow-y: auto;
    background: white;
    border-radius: 10px;
    z-index: 9999;
    box-shadow: 0 0 20px rgba(0,0,0,0.3);
    }

    .disable-page {
    filter: blur(5px);
    pointer-events: none;
    user-select: none;
    }

    .top-products-chart {
        padding: 15px;
    }

    .bar-row {
        display: grid;
        grid-template-columns: 150px 1fr 50px;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .bar-label {
        font-weight: 600;
        font-size: 0.9rem;
    }

    .bar-track {
        background: #e9ecef;
        height: 14px;
        width: 100%;
        border-radius: 10px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        background: linear-gradient(to right, #2980b9, #6bb9f0);
        border-radius: 10px;
        transition: width 0.5s ease;
    }

    .bar-value {
        font-weight: bold;
        text-align: right;
        font-size: 0.9rem;
    }

</style>


@code {
    private List<Product> products = new();
    private List<Customer> customers = new();
    private List<Staff> Staffs = new();
    private decimal MonthlyProfit;
    private decimal MonthlyExpense;
    private bool isLoading = true;
    private bool showThreshold = false;
    private List<StockHistory> thresholdProducts = new();
    private int srNo = 0;
    private string? DateError { get; set; }
    int TotalInvoices = 0;
    List<TopProductDto> TopProducts = new();
    private bool _isFirstRender = true;
    bool chartLoaded = false;
    List<TopCustomerDto> TopCustomers = new();
    List<TopSupplierDto> TopSuppliers = new();



    private DateTime? startDate;
    private DateTime? endDate;
    private string filterMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        var today = DateTime.Today;
        startDate = new DateTime(today.Year, today.Month, 1);
        endDate = startDate.Value.AddMonths(1).AddDays(-1);

        await LoadData();

        isLoading = false;
    }



    private async Task LoadData()
    {
        if (startDate.HasValue && endDate.HasValue)
        {
            MonthlyProfit = await ProfitReportService.GetProfitByDateRangeAsync(startDate.Value, endDate.Value);
            MonthlyExpense = await expenseService.GetProfitByDateRangeAsync(startDate.Value, endDate.Value);
            filterMessage = $"Showing profit from {startDate.Value:MMM dd, yyyy} to {endDate.Value:MMM dd, yyyy}";
            TopCustomers = await saleService.GetTopCustomersByDateAsync(startDate.Value, endDate.Value);
            TopProducts = await saleService.GetTopSellingProductsByDateAsync(startDate.Value, endDate.Value);
            TopSuppliers = await supplierService.GetTopSuppliersByDateAsync(startDate.Value, endDate.Value);
        }
        else
        {
            MonthlyProfit = await ProfitReportService.GetMonthProfitAsync();
            MonthlyExpense = await expenseService.GetMonthExpenseAsync();
            filterMessage = "Showing current month profit";

            // Current month
            var monthStart = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);

            TopCustomers = await saleService.GetTopCustomersByDateAsync(monthStart, monthEnd);
            TopProducts = await saleService.GetTopSellingProductsByDateAsync(monthStart, monthEnd);
            TopSuppliers = await supplierService.GetTopSuppliersByDateAsync(monthStart, monthEnd);
        }

        TotalInvoices = await saleService.GetTotalInvoicesAsync();
        

        Staffs = await staffService.GetAllStaffAsync();
        customers = await customerService.GetCustomersAsync();
        products = await productService.GetAllAsync();
    }

    private void ToggleThreshold()
    {
        showThreshold = !showThreshold;

        if (showThreshold)
        {
            LoadThresholdProducts();
        }
    }

    private void LoadThresholdProducts()
    {
        srNo = 0;
        thresholdProducts = _context.StockHistories
            .Where(p => p.NewStockLevel <= 5)
            .Include(p => p.Product)
            .OrderBy(p => p.NewStockLevel)
            .ToList();
        // .OrderBy(p => p.StockQty)
            // .ToList();
    }

    private async Task DownloadThresholdPdf()
    {
        try
        {
            var model = thresholdProducts.Select((item, i) => new LowStockRow
                {
                    SrNo = i + 1,
                    Product = item.Product.ProductName,
                    Type = item.Product.Type,
                    Stock = item.NewStockLevel
                }).ToList();

            var doc = new LowStockReportDocument(model);

            QuestPDF.Settings.License = LicenseType.Community;

            var pdfBytes = doc.GeneratePdf();

            string base64 = Convert.ToBase64String(pdfBytes);

            await JS.InvokeVoidAsync(
                "downloadFileFromBytes",
                "LowStockProducts.pdf",
                base64
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task OnStartDateChanged(DateTime? value)
    {
        startDate = value;
        ValidateDates();
        await LoadData();   // Auto refresh dashboard
    }

    private async Task OnEndDateChanged(DateTime? value)
    {
        endDate = value;
        ValidateDates();
        await LoadData();   // Auto refresh dashboard
    }

    private void ValidateDates()
    {
        DateError = null;

        if (startDate.HasValue && endDate.HasValue)
        {
            if (startDate > endDate)
            {
                DateError = "Start Date cannot be greater than End Date.";
            }
        }
    }

    private async Task ApplyFilter()
    {
        await LoadData();
    }
}
