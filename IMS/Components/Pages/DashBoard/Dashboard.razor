@page "/dashboard"
@using Infrastructure.Services
@using System.Globalization
@inject IProfitReportService ProfitReportService
@rendermode InteractiveServer

<PageTitle>Dashboard</PageTitle>

<div class="container mt-4">
    <h3 class="fw-bold mb-4">📊 Business Dashboard Overview</h3>

    @if (isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Profit Summary Cards -->
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="card shadow-sm border-0 text-white" style="background-color:#ffc107;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Today's Profit</h6>
                            <h4 class="fw-bold">@TodayProfit.ToString("C", new CultureInfo("ur-PK"))</h4>
                        </div>
                        <i class="bi bi-cash-coin fs-2 opacity-75"></i>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card shadow-sm border-0 text-white" style="background-color:#17a2b8;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Weekly Profit</h6>
                            <h4 class="fw-bold">@WeeklyProfit.ToString("C", new CultureInfo("ur-PK"))</h4>
                        </div>
                        <i class="bi bi-bar-chart-line fs-2 opacity-75"></i>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card shadow-sm border-0 text-white" style="background-color:#007bff;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Monthly Profit</h6>
                            <h4 class="fw-bold">@MonthlyProfit.ToString("C", new CultureInfo("ur-PK"))</h4>
                        </div>
                        <i class="bi bi-calendar3 fs-2 opacity-75"></i>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="card shadow-sm border-0 text-white" style="background-color:#28a745;">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Total Profit</h6>
                            <h4 class="fw-bold">@TotalProfit.ToString("C", new CultureInfo("ur-PK"))</h4>
                        </div>
                        <i class="bi bi-graph-up-arrow fs-2 opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Divider -->
        <hr class="my-4" />

        <!-- Future Expansion Row -->
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold">
                        Profit Overview Chart (Coming Soon)
                    </div>
                    <div class="card-body text-center text-muted">
                        <i class="bi bi-activity fs-1 text-secondary"></i>
                        <p class="mt-3">You can display profit trends, graphs, or reports here later.</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white fw-bold">
                        Top Selling Products (Coming Soon)
                    </div>
                    <div class="card-body text-center text-muted">
                        <i class="bi bi-box-seam fs-1 text-secondary"></i>
                        <p class="mt-3">This section will display top-selling products in the next phase.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private decimal TotalProfit;
    private decimal MonthlyProfit;
    private decimal WeeklyProfit;
    private decimal TodayProfit;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        TodayProfit = await ProfitReportService.GetTodayProfitAsync();
        WeeklyProfit = await ProfitReportService.GetWeekProfitAsync();
        MonthlyProfit = await ProfitReportService.GetMonthProfitAsync();
        TotalProfit = await ProfitReportService.GetYearProfitAsync();

        isLoading = false;
    }
}
