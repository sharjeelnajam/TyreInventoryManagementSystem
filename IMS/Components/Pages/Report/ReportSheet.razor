@page "/daily-report"

@using Infrastructure.Services
@using Domain.DTO
@inject IReportService ReportService
@rendermode InteractiveServer


<h3>📅 Daily Report (Today)</h3>

<div class="row mt-4">
    <div class="col-md-2">
        <label class="form-label fw-bold">Report Type</label>
        <select class="form-select"
                value="@SelectedReport"
                @onchange="OnReportTypeChanged">
            <option value="All">All</option>
            <option value="Purchase">Purchase</option>
            <option value="Sale">Sale</option>
            <option value="Stock">Stock</option>
        </select>


    </div>

    <div class="col-md-2">
        <label class="form-label fw-bold">From Date</label>
        <InputDate TValue="DateTime?"
                   class="form-control"
                   Value="FromDate"
                   ValueExpression="@(() => FromDate)"
                   ValueChanged="OnFromDateChanged" />

    </div>

    <div class="col-md-2">
        <label class="form-label fw-bold">To Date</label>
        <InputDate TValue="DateTime?"
                   class="form-control"
                   Value="ToDate"
                   ValueExpression="@(() => ToDate)"
                   ValueChanged="OnToDateChanged" />

    </div>

 
</div>



@if (SelectedReport == "All" || SelectedReport == "Purchase")
{
    <div class="mt-4 mb-5">
        <h4>
            🛒 Today Purchases
            <span class="badge bg-primary">@PurchaseCount</span>
        </h4>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Supplier</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in TodayPurchases)
                {
                    <tr>
                        <td>@p.SupplierName</td>
                        <td>@p.ProductName</td>
                        <td>@p.Quantity</td>
                        <td>@p.UnitPrice</td>
                        <td>@p.TotalPrice</td>
                        <td>@p.PurchaseDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}


@if (SelectedReport == "All" || SelectedReport == "Sale")
{
    <div class="mt-4 mb-5">
        <h4>
            💰 Today Sales
            <span class="badge bg-success">@SaleCount</span>
        </h4>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in TodaySales)
                {
                    <tr>
                        <td>@s.CustomerName</td>
                        <td>@s.ProductName</td>
                        <td>@s.Quantity</td>
                        <td>@s.UnitPrice</td>
                        <td>@s.TotalPrice</td>
                        <td>@s.SaleDate.ToShortDateString()</td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
}


@if (SelectedReport == "All" || SelectedReport == "Stock")
{
    <div class="mt-4 mb-5">
        <h4>
            📦 Available Stock
            <span class="badge bg-dark">@StockCount</span>
        </h4>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Stock)
                {
                    <tr>
                        <td>@s.ProductName</td>
                        <td>@s.CurrentStock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


@code {

    List<TodayPurchaseReportDto> TodayPurchases = new();
    List<TodaySaleReportDto> TodaySales = new();
    List<AvailableStockDto> Stock = new();

    string SelectedReport = "All";

    DateTime? FromDate = DateTime.Today;
    DateTime? ToDate = DateTime.Today;

    int PurchaseCount => TodayPurchases.Count;
    int SaleCount => TodaySales.Count;
    int StockCount => Stock.Count;

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    async Task OnFromDateChanged(DateTime? value)
    {
        FromDate = value;
        await LoadReport();
    }

    async Task OnToDateChanged(DateTime? value)
    {
        ToDate = value;
        await LoadReport();
    }

    async Task OnReportTypeChanged(ChangeEventArgs e)
    {
        SelectedReport = e.Value?.ToString() ?? "All";
        await LoadReport();
    }

    async Task LoadReport()
    {
        if (FromDate == null || ToDate == null)
            return;

        TodayPurchases = await ReportService
            .GetPurchasesByDateRange(FromDate.Value, ToDate.Value);

        TodaySales = await ReportService
            .GetSalesByDateRange(FromDate.Value, ToDate.Value);

        Stock = await ReportService.GetAvailableStock();
    }
}

