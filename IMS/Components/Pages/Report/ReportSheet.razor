@page "/daily-report"

@using Infrastructure.Services
@using Domain.DTO
@using System.Linq
@using System.Globalization
@inject IReportService ReportService
@rendermode InteractiveServer

<h3 class="mb-2">📅 Daily Report</h3>
<p class="text-muted small mb-3">
    @(FromDate == ToDate && FromDate.HasValue
        ? $"Whole day: {FromDate.Value:dd MMM yyyy}"
        : FromDate.HasValue && ToDate.HasValue
            ? $"From {FromDate.Value:dd MMM yyyy} to {ToDate.Value:dd MMM yyyy}"
            : "Select date range")
</p>

<div class="row mt-2 align-items-start justify-content-between">
    <!-- Left: summary cards (Selling only) -->
    <div class="col-lg-6 col-md-7">
        @if (SelectedReport == "Selling")
        {
            <div class="d-flex gap-3">
                <div class="card shadow-sm border-0 text-start flex-fill">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold">Cash Received</div>
                        <div class="fw-normal">@TotalCashPayments.ToString("C", new CultureInfo("en-GB"))</div>
                    </div>
                </div>
                <div class="card shadow-sm border-0 text-start flex-fill">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold">Card Received</div>
                        <div class="fw-normal">@TotalCardPayments.ToString("C", new CultureInfo("en-GB"))</div>
                    </div>
                </div>
                <div class="card shadow-sm border-0 text-start flex-fill">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small fw-bold">Total Sales</div>
                        <div class="fw-normal">@TotalSaleAmount.ToString("C", new CultureInfo("en-GB"))</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Right: filter controls (Filter, From Date, To Date) -->
    <div class="col-lg-4 col-md-5">
        <div class="row g-1 justify-content-end">
            <div class="col-4">
                <label class="form-label fw-bold">Filter</label>
                <select class="form-select"
                        value="@SelectedReport"
                        @onchange="OnReportTypeChanged">
                    <option value="Selling">Selling</option>
                    <option value="Purchasing">Purchasing</option>
                </select>
            </div>
            <div class="col-4">
                <label class="form-label fw-bold">From Date</label>
                <InputDate TValue="DateTime?"
                           class="form-control"
                           Value="FromDate"
                           ValueExpression="@(() => FromDate)"
                           ValueChanged="OnFromDateChanged" />
            </div>
            <div class="col-4">
                <label class="form-label fw-bold">To Date</label>
                <InputDate TValue="DateTime?"
                           class="form-control"
                           Value="ToDate"
                           ValueExpression="@(() => ToDate)"
                           ValueChanged="OnToDateChanged" />
            </div>
        </div>
    </div>
</div>

@* Purchasing section – whole day purchases for selected date range *@
@if (SelectedReport == "Purchasing")
{
    <div class="mt-4 mb-5">
        <h4>
            🛒 Purchasing
            <span class="badge bg-primary">@PurchaseCount</span>
            @if (PurchaseCount > 0)
            {
                <span class="ms-2 text-muted fw-normal fs-6">Total: @TotalPurchaseAmount.ToString("N2")</span>
            }
        </h4>
        <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Reference #</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (TodayPurchases.Any())
                {
                    foreach (var p in TodayPurchases)
                    {
                        <tr>
                            <td>@p.ReferenceNumber</td>
                            <td>@p.ProductName</td>
                            <td>@p.Quantity</td>
                            <td>@p.TotalPrice.ToString("N2")</td>
                            <td>@p.PurchaseDate.ToShortDateString()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No records found for the selected date range.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@* Selling section – whole day sales for selected date range *@
@if (SelectedReport == "Selling")
{
    <div class="mt-3 mb-5">
        <h4 class="mb-2">
            💰 Selling
            <span class="badge bg-success">@SaleCount</span>
        </h4>
        <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Reference #</th>
                    <th>Payment</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Net Price</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (TodaySales.Any())
                {
                    foreach (var s in TodaySales)
                    {
                        <tr>
                            <td>@s.ReferenceNumber</td>
                            <td>@s.PaymentMethod</td>
                            <td>@s.ProductName</td>
                            <td>@s.Quantity</td>
                            <td>@s.TotalPrice.ToString("N2")</td>
                            <td>@s.NetPrice.ToString("N2")</td>
                            <td>@s.SaleDate.ToShortDateString()</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            No records found for the selected date range.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}


@* Available Stock – commented out, not shown on Daily Report
@if (SelectedReport == "Stock")
{
    <div class="mt-4 mb-5">
        <h4>
            📦 Available Stock
            <span class="badge bg-dark">@StockCount</span>
        </h4>
        <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Stock</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Stock)
                {
                    <tr>
                        <td>@s.ProductName</td>
                        <td>@s.CurrentStock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
*@


@code {

    List<TodayPurchaseReportDto> TodayPurchases = new();
    List<TodaySaleReportDto> TodaySales = new();
    // List<AvailableStockDto> Stock = new(); // commented out – Available Stock not shown on Daily Report

    string SelectedReport = "Selling";

    DateTime? FromDate = DateTime.Today;
    DateTime? ToDate = DateTime.Today;

    int PurchaseCount => TodayPurchases.Count;
    int SaleCount => TodaySales.Count;
    // int StockCount => Stock.Count; // commented out – Available Stock not shown

    decimal TotalPurchaseAmount => TodayPurchases.Sum(p => p.TotalPrice);
    decimal TotalSaleAmount => TodaySales.Sum(s => s.NetPrice);
    decimal TotalCashPayments { get; set; }
    decimal TotalCardPayments { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadReport();
    }

    async Task OnFromDateChanged(DateTime? value)
    {
        FromDate = value;
        await LoadReport();
    }

    async Task OnToDateChanged(DateTime? value)
    {
        ToDate = value;
        await LoadReport();
    }

    async Task OnReportTypeChanged(ChangeEventArgs e)
    {
        SelectedReport = e.Value?.ToString() ?? "Selling";
        await LoadReport();
    }

    async Task LoadReport()
    {
        if (FromDate == null || ToDate == null)
            return;

        TodayPurchases = await ReportService
            .GetPurchasesByDateRange(FromDate.Value, ToDate.Value);

        TodaySales = await ReportService
            .GetSalesByDateRange(FromDate.Value, ToDate.Value);

        var paymentSummary = await ReportService
            .GetSalePaymentSummaryByDateRange(FromDate.Value, ToDate.Value);

        TotalCashPayments = paymentSummary.TotalCash;
        TotalCardPayments = paymentSummary.TotalCard;

        // Stock = await ReportService.GetAvailableStock(); // commented out – not shown on Daily Report
    }
}

