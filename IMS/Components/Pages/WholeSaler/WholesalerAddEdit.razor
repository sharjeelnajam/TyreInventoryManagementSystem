@using Domain
@using Domain.Enums
@using Infrastructure.Services
@inject IWholesalerService WholesalerService


<div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,0.4)">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0" style="border-radius:12px;">

            <!-- Header -->
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #4b6cb7, #182848); border-top-left-radius:12px; border-top-right-radius:12px;">
                <h5 class="modal-title fw-bold">
                    @((Id == Guid.Empty) ? "Add " : "Edit")
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
            </div>

            <!-- Body -->
            <div class="modal-body px-4 py-4">

                <EditForm Model="@Model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Name</label>
                            <InputText class="form-control form-control-lg shadow-sm" @bind-Value="Model.Name" placeholder="Enter wholesaler name" />
                            <ValidationMessage For="@(() => Model.Name)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone</label>
                            <InputText class="form-control form-control-lg shadow-sm" @bind-Value="Model.Phone" placeholder="03XX-XXXXXXX" />
                            <ValidationMessage For="@(() => Model.Phone)" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <InputText class="form-control form-control-lg shadow-sm" @bind-Value="Model.Email" placeholder="example@mail.com" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address</label>
                            <InputText class="form-control form-control-lg shadow-sm" @bind-Value="Model.Address" placeholder="Complete address" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Type</label>
                            <InputSelect class="form-select form-select-lg shadow-sm" @bind-Value="Model.Type">
                                @foreach (var t in Enum.GetValues<WholesalerType>())
                                {
                                    <option value="@t">@t</option>
                                }
                            </InputSelect>
                        </div>

                    </div>

                    <!-- Footer buttons inside EditForm -->
                    <div class="modal-footer d-flex justify-content-end gap-2 px-4 pb-4">
                        <button type="button" class="btn btn-light px-4 py-2 border shadow-sm" style="border-radius:8px;" @onclick="Close">
                            Cancel
                        </button>

                        <button type="submit" class="btn text-white px-4 py-2 shadow-sm" style="border-radius:8px; background: linear-gradient(135deg,#28a745,#218838);">
                            Save
                        </button>
                    </div>

                </EditForm>

            </div>

        </div>
    </div>
</div>


@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    Wholesaler Model = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id != Guid.Empty)
        {
            Model = await WholesalerService.GetByIdAsync(Id);
        }
    }

    async Task Save()
    {
        if (Id == Guid.Empty)
            await WholesalerService.AddAsync(Model);
        else
            await WholesalerService.UpdateAsync(Model);

        await OnClose.InvokeAsync();
    }

    async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
