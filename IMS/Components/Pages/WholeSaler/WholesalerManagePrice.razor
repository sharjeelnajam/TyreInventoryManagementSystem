
@using Domain.Enums
@using Infrastructure.Services
@using Domain
@using Microsoft.AspNetCore.Components
@inject IListManagementService ListService
@inject IWholesalerPriceService PriceService
@inject IJSRuntime JS
@inject ApplicationDbContext _context
@rendermode InteractiveServer

@{
    var threadSelectId = (IdPrefix ?? "") + "ThreadSelect";
    var unitSelectId = (IdPrefix ?? "") + "unitSelect";
}

@if (Inline)
{
    <div class="border rounded-3 p-3 bg-light">
        <h5 class="mb-0">Manage Prices</h5>
        <div class="pt-2">
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error:</strong> @ErrorMessage
                    <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
                </div>
            }
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="fw-bold mb-2">Select Threads</label>
                    <div class="border rounded p-2 bg-white" style="max-height:140px; overflow-y:auto;">
                        @foreach (var s in Threads)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="thread_@s.Id" checked="@SelectedThreads.Contains(s.Id)" @onchange="() => ToggleThread(s.Id)" />
                                <label class="form-check-label" for="thread_@s.Id">@s.Name</label>
                            </div>
                        }
                        @if (!Threads.Any())
                        {
                            <span class="text-muted small">No threads defined.</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold mb-2">Select Units</label>
                    <div class="border rounded p-2 bg-white" style="max-height:140px; overflow-y:auto;">
                        @foreach (var u in Units)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="unit_@u.Id" checked="@SelectedUnits.Contains(u.Id)" @onchange="() => ToggleUnit(u.Id)" />
                                <label class="form-check-label" for="unit_@u.Id">@u.Name</label>
                            </div>
                        }
                        @if (!Units.Any())
                        {
                            <span class="text-muted small">No units defined.</span>
                        }
                    </div>
                </div>
            </div>
            @if (PriceRows.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered w-auto">
                        <thead>
                            <tr>
                                <th style="width:150px">Thread</th>
                                <th style="width:150px">Unit</th>
                                <th style="width:150px">Price (£)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in PriceRows)
                            {
                                <tr>
                                    <td>@row.ThreadName</td>
                                    <td>@row.UnitName</td>
                                    <td>
                                        <input type="number" class="form-control" style="width:130px" step="0.01" min="0" @bind="row.Price" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted mt-1">Enter price for each row, then click Save.</p>
            }
            else if (Threads.Any() && Units.Any())
            {
                <p class="text-muted mb-0">Select at least one Thread and one Unit above to show the price grid.</p>
            }
        </div>
        <div class="pt-2 border-top mt-2">
            <button class="btn btn-secondary btn-sm" @onclick="Close">Cancel</button>
            <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@(!PriceRows.Any())">Save</button>
        </div>
    </div>
}
else if (ShowModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog"
         style="position:fixed; top:0; left:0; width:100%; height:100%; z-index:1050; background-color:rgba(0,0,0,0.5); overflow-y:auto;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i> Add pricing entry</h5>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">Add tier/grade and unit with price. Entries are saved for this customer and will appear in the list below.</p>
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Error:</strong> @ErrorMessage
                            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
                        </div>
                    }
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="fw-bold mb-2">Tier / Grade (Thread)</label>
                            <div class="border rounded p-2 bg-white" style="max-height:140px; overflow-y:auto;">
                                @foreach (var s in Threads)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="modal_thread_@s.Id" checked="@SelectedThreads.Contains(s.Id)" @onchange="() => ToggleThread(s.Id)" />
                                        <label class="form-check-label" for="modal_thread_@s.Id">@s.Name</label>
                                    </div>
                                }
                                @if (!Threads.Any())
                                {
                                    <span class="text-muted small">No tiers defined.</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold mb-2">Unit</label>
                            <div class="border rounded p-2 bg-white" style="max-height:140px; overflow-y:auto;">
                                @foreach (var u in Units)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="modal_unit_@u.Id" checked="@SelectedUnits.Contains(u.Id)" @onchange="() => ToggleUnit(u.Id)" />
                                        <label class="form-check-label" for="modal_unit_@u.Id">@u.Name</label>
                                    </div>
                                }
                                @if (!Units.Any())
                                {
                                    <span class="text-muted small">No units defined.</span>
                                }
                            </div>
                        </div>
                    </div>
                    @if (PriceRows.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered w-auto">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:150px">Tier / Grade</th>
                                        <th style="width:150px">Unit</th>
                                        <th style="width:150px">Price (£)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in PriceRows)
                                    {
                                        <tr>
                                            <td>@row.ThreadName</td>
                                            <td>@row.UnitName</td>
                                            <td>
                                                <input type="number" class="form-control" style="width:130px" step="0.01" min="0" @bind="row.Price" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <p class="small text-muted mt-1 mb-0">Enter price for each row, then click Save.</p>
                    }
                    else if (Threads.Any() && Units.Any())
                    {
                        <p class="text-muted mb-0">Select at least one Tier/Grade and one Unit to show the price grid.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(!PriceRows.Any())">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool Inline { get; set; }
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public string? IdPrefix { get; set; }

    List<ListManagement> Threads = new();
    List<ListManagement> Units = new();

    HashSet<Guid> SelectedThreads = new();
    HashSet<Guid> SelectedUnits = new();
    List<PriceRowVm> PriceRows = new();
    string? ErrorMessage;
    // List<WholeSalerPrice> ExistingPrices = new();
    bool IsLoaded = false;

    DotNetObjectReference<WholesalerManagePrice>? objRef;

    string GetSelectId(string name) => (IdPrefix ?? "") + name;

    protected override async Task OnInitializedAsync()
    {
        Threads = await ListService.GetByTypeAsync(ListType.Thread) ?? new();
        Units = await ListService.GetByTypeAsync(ListType.Unit) ?? new();

        // ExistingPrices = await PriceService
        // .GetByWholesalerIdAsync(WholesalerId);

        
        // SelectedThreads = ExistingPrices
        //     .Select(x => x.ThreadId)
        //     .Distinct()
        //     .ToHashSet();

        // SelectedUnits = ExistingPrices
        //     .Select(x => x.UnitId)
        //     .Distinct()
        //     .ToHashSet();

        // BuildRows(fromDb: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Inline)
        {
            objRef = DotNetObjectReference.Create(this);
            await Task.Delay(50);
            try
            {
                await JS.InvokeVoidAsync("initMultiSelect",
                    GetSelectId("ThreadSelect"), objRef, nameof(OnThreadSelected));
                await JS.InvokeVoidAsync("initMultiSelect",
                    GetSelectId("unitSelect"), objRef, nameof(OnUnitSelected));
            }
            catch { /* Select2 not available or element not in DOM */ }
        }
    }

    void ToggleThread(Guid id)
    {
        if (SelectedThreads.Contains(id))
            SelectedThreads.Remove(id);
        else
            SelectedThreads.Add(id);
        BuildRows();
    }

    void ToggleUnit(Guid id)
    {
        if (SelectedUnits.Contains(id))
            SelectedUnits.Remove(id);
        else
            SelectedUnits.Add(id);
        BuildRows();
    }

    [JSInvokable]
    public void OnThreadSelected(string[] values)
    {
        SelectedThreads = values.Select(Guid.Parse).ToHashSet();
        BuildRows();
    }

    [JSInvokable]
    public void OnUnitSelected(string[] values)
    {
        SelectedUnits = values.Select(Guid.Parse).ToHashSet();
        BuildRows();
    }

    void BuildRows()
    {
        PriceRows = (
            from s in SelectedThreads
            from u in SelectedUnits
            select new PriceRowVm
                {
                    ThreadId = s,
                    UnitId = u,
                    ThreadName = Threads.First(x => x.Id == s).Name,
                    UnitName = Units.First(x => x.Id == u).Name,
                    Price = 0
                }
        ).ToList();

        StateHasChanged();
    }


    public void Dispose()
    {
        objRef?.Dispose();
    }

    async Task Save()
    {
        if (!PriceRows.Any()) return;
        try
        {
            ErrorMessage = null;
            var prices = PriceRows.Select(x => new CustomerSalerPrice
                {
                    CustomerId = CustomerId,
                    ThreadId = x.ThreadId,
                    UnitId = x.UnitId,
                    Price = x.Price
                }).ToList();

            await PriceService.UpsertPricesAsync(prices);
            await OnClose.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            StateHasChanged();
        }
    }



    void Close() => OnClose.InvokeAsync();

    HashSet<Guid> GetSelectedValues(ChangeEventArgs e)
    {
        var selectedValues = new HashSet<Guid>();

        if (e.Value is string[] selectedOptions)
        {
            foreach (var option in selectedOptions)
            {
                if (Guid.TryParse(option, out Guid id))
                {
                    selectedValues.Add(id);
                }
            }
        }

        return selectedValues;
    }

    class PriceRowVm
    {
        public Guid ThreadId { get; set; }
        public Guid UnitId { get; set; }
        public string ThreadName { get; set; }
        public string UnitName { get; set; }
        public decimal Price { get; set; }
    }
}
