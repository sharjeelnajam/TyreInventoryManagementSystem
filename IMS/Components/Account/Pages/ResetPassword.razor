@page "/Account/ResetPassword"
@layout LoginLayout

@using IMS.Components.Layout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Domain.Identity
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities


@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager



<PageTitle>Reset Password</PageTitle>

<div class="login-bg d-flex justify-content-center align-items-center">
    <div class="login-card shadow-lg rounded-4 p-4 pt-3 style=" max-width: 480px; width: 100%;"">
        <!-- Logo & Heading -->
        <div class="text-center mb-4">
            <div class="logo-circle mb-1">
                <i class="bi bi-key-fill fs-2"></i>
            </div>
            <h3 class="fw-bold mb-1">Reset Your Password</h3>
            <p class="text-muted small">Enter your email and new password below</p>
        </div>

        <StatusMessage Message="@Message" />

        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync">
            <input type="hidden" @bind="Input.Code" />
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" role="alert" />

            <!-- Email -->
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Email</label>
                <div class="input-group shadow-sm rounded">
                    <span class="input-group-text bg-white text-primary"><i class="bi bi-envelope"></i></span>
                    <InputText @bind-Value="Input.Email" class="form-control border-start-0" id="email" placeholder="name@example.com" autocomplete="username" />
                </div>
                <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
            </div>

            <!-- New Password -->
            <div class="mb-3">
                <label for="password" class="form-label fw-semibold">New Password</label>
                <div class="input-group shadow-sm rounded">
                    <span class="input-group-text bg-white text-primary"><i class="bi bi-lock-fill"></i></span>
                    <InputText type="password" @bind-Value="Input.Password" class="form-control border-start-0" id="password" placeholder="Enter new password" autocomplete="new-password" />
                </div>
                <ValidationMessage For="() => Input.Password" class="text-danger small mt-1" />
            </div>

            <!-- Confirm Password -->
            <div class="mb-3">
                <label for="confirm-password" class="form-label fw-semibold">Confirm Password</label>
                <div class="input-group shadow-sm rounded">
                    <span class="input-group-text bg-white text-primary"><i class="bi bi-lock-fill"></i></span>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control border-start-0" id="confirm-password" placeholder="Confirm password" autocomplete="new-password" />
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small mt-2" />
            </div>

            <!-- Submit -->
            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm login-btn mt-2">
                <i class="bi bi-arrow-repeat me-2"></i> Reset Password
            </button>
        </EditForm>

        <hr/>

        <div class="text-center small">
            <p><a href="Account/Login">Back to Login</a></p>
            <p><a href="Account/ForgotPassword">Forgot your password?</a></p>
            <p><a href="Account/ResendEmailConfirmation">Resend email confirmation</a></p>
        </div>
    </div>
</div>

<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        font-family: 'Inter', sans-serif;
    }

    .login-bg {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .login-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(12px);
        max-width: 500px;
        width: 100%;
        padding: 70px 60px !important;
        min-height: 750px; 
        border-radius: 1.2rem;
        box-shadow: 0 25px 45px rgba(0, 0, 0, 0.25);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }


    .logo-circle {
        width: 95px; /* increased */
        height: 95px; /* increased */
        background: #c0c0c0;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        color: #fff;
        box-shadow: 0 8px 18px rgba(0,0,0,0.22);
        font-size: 2.3rem; /* slightly larger icon */
    }

    .input-group {
        border-radius: 0.6rem;
        overflow: hidden;
    }

    .input-group-text {
        border: none;
        font-size: 1.1rem;
    }

    .form-control {
        border: none;
        box-shadow: none;
    }

    .login-btn {
        background: linear-gradient(135deg, #4e73df, #224abe);
        border: none;
        padding: 12px 0; /* increased height */
        font-size: 1.05rem;
        transition: background 0.3s ease;
    }

        .login-btn:hover {
            background: linear-gradient(135deg, #224abe, #4e73df);
        }

    a {
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

</style>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    protected override void OnInitialized()
    {
        if (Code is not null)
        {
            Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Code is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Don't reveal that the user does not exist
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
        }

        identityErrors = result.Errors;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";
    }
}
