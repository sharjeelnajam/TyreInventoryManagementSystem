@inherits LayoutComponentBase
@layout AccountLayout

<div class="manage-container-full d-flex justify-content-center align-items-start">
    <div class="manage-card-full shadow-sm border-0 p-4"
         style="width: 100%; max-width: 1400px; border-radius: 0; background: #ffffff;">

        <h2 class="text-center mb-4"
            style="font-weight:700; color:#333;">
            Manage Your Account
        </h2>

        <div class="row g-4">

            <!-- Left Sidebar -->
            <div class="col-md-3">
                <div class="sidebar-nav shadow-sm p-3"
                     style="border-radius:12px; background:#f8f9fa;">
                    <ManageNavMenu />
                </div>
            </div>

            <!-- Content Body -->
            <div class="col-md-9">
                <div class="content-area shadow-sm p-4"
                     style="border-radius:12px; background:#ffffff;">
                    @Body
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Full page with zero spacing */
    .manage-container-full {
        width: 100%;
        min-height: 100vh; /* full height */
        margin: 0 !important;
        padding: 0 !important;
    }

    .manage-card-full {
        width: 100%;
        min-height: 100vh;
        margin: 0 !important;
        padding: 30px; /* keep internal padding only */
        border-radius: 0 !important; /* remove rounded borders so full page looks flat */
        animation: fadeIn 0.4s ease-in-out;
    }

    /* Sidebar styling */
    .sidebar-nav a.nav-link {
        border-radius: 8px;
        padding: 10px 12px;
        font-weight: 500;
        transition: background .2s, color .2s;
    }

        .sidebar-nav a.nav-link.active {
            background: linear-gradient(135deg, #4b6cb7, #182848);
            color: #fff !important;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .sidebar-nav a.nav-link:hover {
            background: #ececec;
        }
</style>
